{
  "$schema": "./tokens.schema.json",
  "meta": {
    "name": "Costra Design Tokens",
    "version": "0.1.1",
    "card": "COSTRA-011",
    "owner": "Design-Agent",
    "updatedAt": "2026-04-23",
    "source": "docs/design/design-system.md",
    "notes": "所有颜色必须 WCAG AA 对比度 ≥ 4.5:1（正文）/ 3:1（大字号）。深色模式通过 `color.role.*` 语义层统一映射，不改组件代码。",
    "contrastReportRef": "docs/design/a11y/contrast-report.md"
  },
  "color": {
    "brand": {
      "primary":   { "value": "#2F7A78", "desc": "主品牌 · 墨湖绿，用于主按钮/关键链接。深色背景 #0A0A0A 下实测对比度 3.48:1，仅限 ≥ 44rpx 大字号（分享卡封面标题），不得下放到正文（见 a11y/contrast-report.md §2）" },
      "primaryHover": { "value": "#256562" },
      "primaryPressed": { "value": "#1D504E" },
      "secondary": { "value": "#F5A623", "desc": "辅助 · 琥珀，用于收入/成就/庆祝" },
      "accent":    { "value": "#E85C5C", "desc": "强调 · 朱红，用于支出超额/危险态" }
    },
    "neutral": {
      "0":   { "value": "#FFFFFF" },
      "50":  { "value": "#FAFAFA" },
      "100": { "value": "#F5F5F5" },
      "200": { "value": "#EEEEEE" },
      "300": { "value": "#E0E0E0" },
      "400": { "value": "#BDBDBD" },
      "500": { "value": "#9E9E9E" },
      "600": { "value": "#757575" },
      "700": { "value": "#424242" },
      "800": { "value": "#212121" },
      "900": { "value": "#0A0A0A" }
    },
    "semantic": {
      "success": { "value": "#2E7D5B" },
      "warning": { "value": "#F5A623" },
      "danger":  { "value": "#D64545" },
      "info":    { "value": "#2F7A78" }
    },
    "role": {
      "bg.app":         { "light": "#FAFAFA", "dark": "#0A0A0A" },
      "bg.surface":     { "light": "#FFFFFF", "dark": "#121212" },
      "bg.elevated":    { "light": "#FFFFFF", "dark": "#1E1E1E" },
      "text.primary":   { "light": "#212121", "dark": "#F5F5F5" },
      "text.secondary": { "light": "#616161", "dark": "#BDBDBD" },
      "text.tertiary":  { "light": "#9E9E9E", "dark": "#757575" },
      "text.onBrand":   { "light": "#FFFFFF", "dark": "#FFFFFF" },
      "border.default": { "light": "#E0E0E0", "dark": "#2A2A2A" },
      "border.strong":  { "light": "#BDBDBD", "dark": "#424242" },
      "amount.expense": { "light": "#D64545", "dark": "#FF6E6E" },
      "amount.income":  { "light": "#2E7D5B", "dark": "#5DC090" },
      "amount.transfer":{ "light": "#616161", "dark": "#9E9E9E" }
    }
  },
  "typography": {
    "fontFamily": {
      "base":  "-apple-system, BlinkMacSystemFont, 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif",
      "mono":  "'SF Mono', Menlo, Consolas, monospace",
      "number":"Tabular, -apple-system, sans-serif"
    },
    "scale": {
      "display": { "size": "32rpx", "lineHeight": "44rpx", "weight": 600 },
      "h1":      { "size": "28rpx", "lineHeight": "40rpx", "weight": 600 },
      "h2":      { "size": "24rpx", "lineHeight": "34rpx", "weight": 600 },
      "body":    { "size": "20rpx", "lineHeight": "28rpx", "weight": 400 },
      "caption": { "size": "18rpx", "lineHeight": "26rpx", "weight": 400 },
      "amount":  { "size": "40rpx", "lineHeight": "52rpx", "weight": 600, "fontFeatureSettings": "'tnum'" },
      "amount.compact": { "size": "32rpx", "lineHeight": "44rpx", "weight": 600, "fontFeatureSettings": "'tnum'", "desc": "首页摘要卡三列等宽数字、统计 Top N 列表的紧凑变体；避免三列 40rpx 挤压" }
    }
  },
  "spacing": {
    "unit": 4,
    "scale": {
      "0":  "0rpx",
      "1":  "4rpx",
      "2":  "8rpx",
      "3":  "12rpx",
      "4":  "16rpx",
      "5":  "20rpx",
      "6":  "24rpx",
      "8":  "32rpx",
      "10": "40rpx",
      "12": "48rpx",
      "16": "64rpx"
    }
  },
  "radius": {
    "none": "0rpx",
    "sm":   "4rpx",
    "md":   "8rpx",
    "lg":   "12rpx",
    "xl":   "16rpx",
    "pill": "9999rpx"
  },
  "shadow": {
    "sm":  "0 2rpx 4rpx rgba(0,0,0,0.06)",
    "md":  "0 4rpx 12rpx rgba(0,0,0,0.08)",
    "lg":  "0 8rpx 24rpx rgba(0,0,0,0.12)"
  },
  "motion": {
    "duration": {
      "instant": "0ms",
      "fast":    "120ms",
      "base":    "200ms",
      "slow":    "320ms",
      "reduced": "0ms"
    },
    "easing": {
      "standard": "cubic-bezier(0.2, 0, 0, 1)",
      "enter":    "cubic-bezier(0, 0, 0, 1)",
      "exit":     "cubic-bezier(0.4, 0, 1, 1)"
    },
    "notes": "当系统 `prefers-reduced-motion: reduce` 开启时，组件层应将 fast/base/slow 一律映射为 reduced(0ms)，并关闭 translate/scale 动画。由 miniprogram/services/theme.ts `respectReducedMotion()` 统一承接。"
  },
  "zIndex": {
    "base":    0,
    "nav":     10,
    "overlay": 100,
    "modal":   200,
    "toast":   300
  },
  "breakpoints": {
    "note": "小程序不按宽度断点，设备尺寸由 rpx 自动适配。保留此键位以便分享卡片 H5 化使用。",
    "sm": "375px",
    "md": "414px",
    "lg": "768px"
  }
}

# =============================================================================
# Costra · PG 从库专用环境变量模板（standby.env.example）
# =============================================================================
# 部署位置：机器②（从库 = staging 机器）的 /data/conf/standby.env
#
# ⚠️ 红线：本文件与 staging 自己的 /data/conf/server.env 完全独立。
#   - 绝不能用 prod 的 server.env 覆盖 staging 的 server.env（staging 服务栈依赖它跑）
#   - 本文件只含从库所需的最小键集，不含 JWT / WX / REDIS 等业务密钥
#
# ⚠️ 格式约定（务必遵守）：
#   - 严禁行尾内联注释！docker compose --env-file 与脚本的 `cut -d= -f2-` 都不剥离
#     行尾 `#`，会把注释并入取值 → compose bind IP 非法 / TCP 探测失败。
#     注释必须独占一行（本文件即示范）。
#   - 值不加引号、不留首尾空格。
#
# 使用方：
#   - infra/docker-compose.standby.yml   （读 PG_STANDBY_LAN_IP）
#   - infra/scripts/setup-replication-standby.sh
#   - infra/scripts/check-replication.sh （经 COSTRA_ENV_FILE=/data/conf/standby.env）
#   - infra/scripts/backup-db.sh         （只走容器内 Unix socket，不读取本文件密码）
#
# 落地：
#   cp infra/standby.env.example /data/conf/standby.env
#   vi /data/conf/standby.env        # 填入真实值
#   chmod 0600 /data/conf/standby.env
#
# 方案文档：docs/ops/pg-standby-backup.md §2.4
# =============================================================================

# === 复制专用账号密码 ===
# 机器②绝不保存 prod 的 PG_COSTRA_PW；备份与监控只走容器内 Unix socket。
# 必须与机器①（prod）server.env 里的 REPLICATOR_PW 完全一致（pg_basebackup 用它认证）。
# 生成方式（在机器① 上执行一次，同时写入两处）：openssl rand -base64 32 | tr -d '/+=\n'
# 轮换必须按方案 §12：先更新 standby.env，并用 --repair-existing
# --prepare-credentials-only 在线只预置 PGDATA passfile（不跑 manifest、不重启），
# 再更新主库角色；严禁手改 PGDATA。
REPLICATOR_PW=<与 prod server.env 的 REPLICATOR_PW 相同>

# === 主从内网 IP ===
# PG_PRIMARY_LAN_IP = 机器①（prod）VPC 内网 IP，从库据此连主库做流复制
PG_PRIMARY_LAN_IP=<prod 内网 IP>
# PG_STANDBY_LAN_IP = 本机（机器② = staging 机器）VPC 内网 IP
# 从库 compose 用它绑宿主机内网端口 15433（供主库故障时反向 basebackup）
PG_STANDBY_LAN_IP=<staging 内网 IP>

# === 可选：复制健康检查告警（企业微信群机器人）===
# 不配置时 check-replication.sh 仅写日志 + 非零退出码。
# WECOM_WEBHOOK_URL=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxx

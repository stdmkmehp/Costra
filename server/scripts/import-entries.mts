/**
 * Costra · 数据导入脚本
 *
 * 设计文档：docs/design/data-export-format.md
 *
 * 用法：
 *   cd server && npx tsx scripts/import-entries.mts \
 *     --file ./imports/data.csv \
 *     [--dry-run] [--force-update] \
 *     [--env-file /data/conf/server.env]
 *
 * 环境变量加载优先级：
 *   1. 已设置的 DATABASE_URL 环境变量（如在 Docker 容器内）
 *   2. --env-file 指定的文件（默认 /data/conf/server.env）
 */

import { Pool, type PoolClient } from 'pg';
import { readFileSync, writeFileSync, existsSync } from 'fs';
import { resolve, dirname, basename, join } from 'path';
import { randomBytes } from 'crypto';

// ─── 环境加载 ─────────────────────────────────────────────────────────────────

function loadEnvFile(filePath: string): void {
  if (!existsSync(filePath)) return;
  const content = readFileSync(filePath, 'utf-8');
  for (const line of content.split('\n')) {
    const trimmed = line.trim();
    if (!trimmed || trimmed.startsWith('#')) continue;
    const eqIdx = trimmed.indexOf('=');
    if (eqIdx < 0) continue;
    const key = trimmed.slice(0, eqIdx).trim();
    const val = trimmed.slice(eqIdx + 1).trim().replace(/^["']|["']$/g, '');
    if (!process.env[key]) {
      process.env[key] = val;
    }
  }
}

// ─── CLI 参数解析 ─────────────────────────────────────────────────────────────

const DEFAULT_ENV_FILE = '/data/conf/server.env';

interface Args {
  file: string;
  dryRun: boolean;
  forceUpdate: boolean;
  envFile: string;
}

function parseArgs(): Args {
  const args = process.argv.slice(2);
  const flags = new Set<string>();
  let file = '';
  let envFile = DEFAULT_ENV_FILE;

  for (let i = 0; i < args.length; i++) {
    if (args[i] === '--file' && args[i + 1]) {
      file = args[++i];
    } else if (args[i] === '--env-file' && args[i + 1]) {
      envFile = args[++i];
    } else if (args[i] === '--dry-run') {
      flags.add('dry-run');
    } else if (args[i] === '--force-update') {
      flags.add('force-update');
    }
  }

  if (!file) {
    console.error('用法: npx tsx scripts/import-entries.mts --file <csv> [--dry-run] [--force-update] [--env-file path]');
    process.exit(1);
  }

  return {
    file: resolve(file),
    dryRun: flags.has('dry-run'),
    forceUpdate: flags.has('force-update'),
    envFile,
  };
}

// ─── 常量与类型 ────────────────────────────────────────────────────────────────

const UUID_RE = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;
const DATE_RE = /^\d{4}-\d{2}-\d{2}$/;
const TIME_RE = /^([01]\d|2[0-3]):[0-5]\d$/;
const CURRENCY_RE = /^[A-Z]{3}$/;

const TYPE_MAP: Record<string, 'income' | 'expense' | 'transfer'> = {
  '支出': 'expense', 'expense': 'expense', '花费': 'expense',
  '收入': 'income', 'income': 'income', '进账': 'income',
  '转账': 'transfer', 'transfer': 'transfer', '内部转账': 'transfer',
};

const SHARED_MAP: Record<string, 'shared' | 'personal'> = {
  '共同': 'shared', 'shared': 'shared',
  '个人': 'personal', 'personal': 'personal',
};

const REQUIRED_HEADERS = ['账本ID', '记账人ID', '日期', '类型', '金额', '一级分类'];

type Severity = 'ERROR' | 'WARNING';

interface ValidationIssue {
  row: number;
  severity: Severity;
  message: string;
}

interface ParsedRow {
  rowNum: number;
  entryId: string;
  ledgerId: string;
  userId: string;
  date: string;
  time: string;
  type: 'income' | 'expense' | 'transfer';
  parentCategoryName: string;
  childCategoryName: string;
  amount: number;           // 分
  currency: string;
  sharedType: 'shared' | 'personal' | null;
  note: string;
  categoryId: string | null;
  autoGenerated: boolean;
}

// ─── CSV 解析 ──────────────────────────────────────────────────────────────────

function parseCsvLine(line: string): string[] {
  const fields: string[] = [];
  let current = '';
  let inQuotes = false;

  for (let i = 0; i < line.length; i++) {
    const ch = line[i];
    if (inQuotes) {
      if (ch === '"') {
        if (line[i + 1] === '"') {
          current += '"';
          i++;
        } else {
          inQuotes = false;
        }
      } else {
        current += ch;
      }
    } else {
      if (ch === '"') {
        inQuotes = true;
      } else if (ch === ',') {
        fields.push(current);
        current = '';
      } else {
        current += ch;
      }
    }
  }
  fields.push(current);
  return fields;
}

// ─── UUID v7 生成（带自定义时间戳） ──────────────────────────────────────────────

function generateUuidV7(timestampMs: number): string {
  const buf = Buffer.alloc(16);

  // 48-bit timestamp (ms) → bytes 0-5
  const ts = BigInt(timestampMs);
  buf[0] = Number((ts >> 40n) & 0xFFn);
  buf[1] = Number((ts >> 32n) & 0xFFn);
  buf[2] = Number((ts >> 24n) & 0xFFn);
  buf[3] = Number((ts >> 16n) & 0xFFn);
  buf[4] = Number((ts >> 8n) & 0xFFn);
  buf[5] = Number(ts & 0xFFn);

  // Random bytes 6-15
  const rand = randomBytes(10);
  buf[6] = (0x70 | (rand[0] & 0x0F)); // version 7
  buf[7] = rand[1];
  buf[8] = (0x80 | (rand[2] & 0x3F)); // variant 10xx
  buf[9] = rand[3];
  buf[10] = rand[4];
  buf[11] = rand[5];
  buf[12] = rand[6];
  buf[13] = rand[7];
  buf[14] = rand[8];
  buf[15] = rand[9];

  const hex = buf.toString('hex');
  return `${hex.slice(0, 8)}-${hex.slice(8, 12)}-${hex.slice(12, 16)}-${hex.slice(16, 20)}-${hex.slice(20)}`;
}

// ─── 金额解析 ──────────────────────────────────────────────────────────────────

function parseAmount(raw: string): { cents: number; error?: string } {
  let cleaned = raw.trim();
  cleaned = cleaned.replace(/^[¥$€£]/, '');
  cleaned = cleaned.replace(/,(?=\d{3})/g, '');
  cleaned = cleaned.replace(/^-/, '');

  const num = parseFloat(cleaned);
  if (isNaN(num) || !isFinite(num)) {
    return { cents: 0, error: `金额非法: "${raw}"` };
  }
  if (num <= 0) {
    return { cents: 0, error: `金额为0或负数: "${raw}"` };
  }

  const parts = cleaned.split('.');
  if (parts[1] && parts[1].length > 2) {
    return { cents: 0, error: `金额精度超限: "${raw}"（最多2位小数）` };
  }

  return { cents: Math.round(num * 100) };
}

// ─── 日期校验 ──────────────────────────────────────────────────────────────────

function isValidDate(dateStr: string): boolean {
  const [y, m, d] = dateStr.split('-').map(Number);
  const date = new Date(y, m - 1, d);
  return date.getFullYear() === y && date.getMonth() === m - 1 && date.getDate() === d;
}

// ─── 主逻辑 ───────────────────────────────────────────────────────────────────

async function main() {
  const args = parseArgs();

  // 加载环境文件（不覆盖已有环境变量）
  loadEnvFile(args.envFile);

  if (!process.env.DATABASE_URL) {
    console.error(`❌ 未找到 DATABASE_URL，请设置环境变量或通过 --env-file 指定配置文件（当前: ${args.envFile}）`);
    process.exit(1);
  }

  // 宿主机执行时，Docker 服务名 "postgres" 不可达 → 替换为 127.0.0.1
  let dbUrl = process.env.DATABASE_URL;
  dbUrl = dbUrl.replace(/@postgres:/, '@127.0.0.1:');

  const pool = new Pool({ connectionString: dbUrl, max: 5 });

  try {
    await run(args, pool);
  } finally {
    await pool.end();
  }
}

async function run(args: Args, pool: Pool) {
  // ═══════════════════════════════════════════════════════════════════
  // A. 文件级校验
  // ═══════════════════════════════════════════════════════════════════

  if (!existsSync(args.file)) {
    console.error(`❌ 文件不存在: ${args.file}`);
    process.exit(1);
  }

  let rawContent = readFileSync(args.file, 'utf-8');
  if (rawContent.charCodeAt(0) === 0xFEFF) rawContent = rawContent.slice(1);

  const rawLines = rawContent.split(/\r?\n/).filter((l) => l.trim() !== '');
  if (rawLines.length < 2) {
    console.error('❌ CSV 文件至少需要表头 + 1 行数据');
    process.exit(1);
  }

  // 解析表头
  const headers = parseCsvLine(rawLines[0]).map((h) => h.trim());

  for (const req of REQUIRED_HEADERS) {
    if (!headers.includes(req)) {
      console.error(`❌ CSV 缺失必填列: "${req}"。当前表头: ${headers.join(', ')}`);
      process.exit(1);
    }
  }
  if (!headers.includes('记录ID')) {
    console.error('❌ CSV 缺失"记录ID"列（列必须存在，值可为空）');
    process.exit(1);
  }

  const colIdx = (name: string) => headers.indexOf(name);

  // ═══════════════════════════════════════════════════════════════════
  // 解析数据行 + B/D/E/F 校验
  // ═══════════════════════════════════════════════════════════════════

  const issues: ValidationIssue[] = [];
  const parsedRows: ParsedRow[] = [];
  const seenEntryIds = new Map<string, number>();

  for (let i = 1; i < rawLines.length; i++) {
    const rowNum = i + 1;
    const fields = parseCsvLine(rawLines[i]);
    const get = (name: string): string => {
      const idx = colIdx(name);
      return idx >= 0 && idx < fields.length ? fields[idx].trim() : '';
    };

    let hasError = false;
    const addError = (msg: string) => { issues.push({ row: rowNum, severity: 'ERROR', message: msg }); hasError = true; };
    const addWarning = (msg: string) => { issues.push({ row: rowNum, severity: 'WARNING', message: msg }); };

    // ─── B. UUID 校验 ───
    let entryId = get('记录ID');
    let autoGenerated = false;

    if (entryId) {
      if (!UUID_RE.test(entryId)) {
        addError(`记录ID格式非法: "${entryId}"`);
      } else {
        const existing = seenEntryIds.get(entryId.toLowerCase());
        if (existing) {
          addError(`记录ID在CSV内重复（行${existing}与行${rowNum}）`);
        } else {
          seenEntryIds.set(entryId.toLowerCase(), rowNum);
        }
      }
    }

    const ledgerId = get('账本ID');
    if (!ledgerId) addError('账本ID为空');
    else if (!UUID_RE.test(ledgerId)) addError(`账本ID格式非法: "${ledgerId}"`);

    const userId = get('记账人ID');
    if (!userId) addError('记账人ID为空');
    else if (!UUID_RE.test(userId)) addError(`记账人ID格式非法: "${userId}"`);

    // ─── D. 字段格式 ───
    const dateStr = get('日期');
    if (!dateStr) addError('日期为空');
    else if (!DATE_RE.test(dateStr)) addError(`日期格式非法: "${dateStr}"（须为YYYY-MM-DD）`);
    else if (!isValidDate(dateStr)) addError(`日期不存在: "${dateStr}"`);
    else {
      const d = new Date(dateStr + 'T00:00:00+08:00');
      const tomorrow = new Date(); tomorrow.setDate(tomorrow.getDate() + 1);
      if (d > tomorrow) addError(`日期在未来: "${dateStr}"`);
      if (d < new Date('2000-01-01')) addError(`日期过早: "${dateStr}"`);
    }

    const timeStr = get('时间');
    if (timeStr && !TIME_RE.test(timeStr)) addError(`时间格式非法: "${timeStr}"（须为HH:mm）`);

    const typeRaw = get('类型');
    const type = typeRaw ? (TYPE_MAP[typeRaw] ?? TYPE_MAP[typeRaw.toLowerCase()]) : undefined;
    if (!typeRaw) addError('类型为空');
    else if (!type) addError(`类型无法识别: "${typeRaw}"`);

    const amountRaw = get('金额');
    if (!amountRaw) addError('金额为空');
    const { cents, error: amountErr } = parseAmount(amountRaw || '0');
    if (amountRaw && amountErr) addError(amountErr);

    const currencyRaw = get('币种');
    const currency = currencyRaw ? currencyRaw.toUpperCase() : 'CNY';
    if (currencyRaw && !CURRENCY_RE.test(currency)) addError(`币种格式非法: "${currencyRaw}"`);

    const sharedRaw = get('归属');
    let sharedType: 'shared' | 'personal' | null = null;
    if (sharedRaw) {
      const mapped = SHARED_MAP[sharedRaw] ?? SHARED_MAP[sharedRaw.toLowerCase()];
      if (!mapped) addError(`归属值非法: "${sharedRaw}"`);
      else sharedType = mapped;
    }

    if (type && type !== 'expense' && sharedType) {
      addWarning(`非支出类型的归属列"${sharedRaw}"将被忽略`);
      sharedType = null;
    }
    if (type === 'expense' && !sharedType) sharedType = 'shared';

    const note = get('备注');
    if (note.length > 200) addError(`备注超长(${note.length}字符，限200)`);

    // ─── E. 分类名称 ───
    const parentCategoryName = get('一级分类');
    if (!parentCategoryName) addError('一级分类为空');

    const childCategoryName = get('二级分类');

    // F1: 转账一级分类必须为"转账"
    if (type === 'transfer' && parentCategoryName && parentCategoryName !== '转账') {
      addError(`转账类型的一级分类必须为"转账"，当前为"${parentCategoryName}"`);
    }

    // ─── B2: 记录ID 为空时自动生成 ───
    if (!entryId && !hasError) {
      const t = timeStr || '12:00';
      const ts = new Date(`${dateStr}T${t}:00+08:00`).getTime();
      entryId = generateUuidV7(ts);
      autoGenerated = true;
      seenEntryIds.set(entryId.toLowerCase(), rowNum);
    } else if (!entryId && hasError) {
      entryId = '';
    }

    if (hasError) continue;

    parsedRows.push({
      rowNum, entryId, ledgerId, userId,
      date: dateStr, time: timeStr || '12:00',
      type: type!, parentCategoryName, childCategoryName,
      amount: cents, currency, sharedType, note,
      categoryId: null, autoGenerated,
    });
  }

  // ═══════════════════════════════════════════════════════════════════
  // C. 业务实体存在性校验
  // ═══════════════════════════════════════════════════════════════════

  const distinctUserIds = [...new Set(parsedRows.map((r) => r.userId))];
  const distinctLedgerIds = [...new Set(parsedRows.map((r) => r.ledgerId))];

  // C1: 用户存在
  const validUsers = new Set<string>();
  if (distinctUserIds.length > 0) {
    const res = await pool.query(
      `SELECT id FROM users WHERE id = ANY($1) AND deleted_at IS NULL`,
      [distinctUserIds],
    );
    for (const row of res.rows) validUsers.add(row.id);
  }

  // C2: 账本存在 → 获取 family_id
  const ledgerFamilyMap = new Map<string, string>();
  if (distinctLedgerIds.length > 0) {
    const res = await pool.query(
      `SELECT id, family_id FROM ledgers WHERE id = ANY($1) AND deleted_at IS NULL`,
      [distinctLedgerIds],
    );
    for (const row of res.rows) ledgerFamilyMap.set(row.id, row.family_id);
  }

  // C3: 成员归属（批量）
  const validMemberships = new Set<string>();
  const pairsToCheck = [...new Set(parsedRows.map((r) => `${r.userId}|${r.ledgerId}`))];
  if (pairsToCheck.length > 0) {
    for (const pair of pairsToCheck) {
      const [uid, lid] = pair.split('|');
      const familyId = ledgerFamilyMap.get(lid);
      if (!familyId) continue;
      const res = await pool.query(
        `SELECT 1 FROM family_members WHERE family_id = $1 AND user_id = $2 AND left_at IS NULL LIMIT 1`,
        [familyId, uid],
      );
      if (res.rows.length > 0) validMemberships.add(pair);
    }
  }

  // 标记 C 类错误
  const validRows: ParsedRow[] = [];
  for (const row of parsedRows) {
    let fail = false;
    if (!validUsers.has(row.userId)) {
      issues.push({ row: row.rowNum, severity: 'ERROR', message: `记账人不存在: ${row.userId}` });
      fail = true;
    }
    if (!ledgerFamilyMap.has(row.ledgerId)) {
      issues.push({ row: row.rowNum, severity: 'ERROR', message: `账本不存在: ${row.ledgerId}` });
      fail = true;
    }
    if (!fail && !validMemberships.has(`${row.userId}|${row.ledgerId}`)) {
      issues.push({ row: row.rowNum, severity: 'ERROR', message: `用户${row.userId}不是账本${row.ledgerId}所属家庭的活跃成员` });
      fail = true;
    }
    if (!fail) validRows.push(row);
  }

  // ═══════════════════════════════════════════════════════════════════
  // E. 分类匹配
  // ═══════════════════════════════════════════════════════════════════

  const familyIds = [...new Set([...ledgerFamilyMap.values()])];

  interface CatRow { id: string; family_id: string | null; name: string; type: string; parent_id: string | null; sort_order: number; }
  let allCategories: CatRow[] = [];
  if (familyIds.length > 0) {
    const res = await pool.query(
      `SELECT id, family_id, name, type, parent_id, sort_order
       FROM categories
       WHERE (family_id = ANY($1) OR family_id IS NULL)
         AND deleted_at IS NULL
       ORDER BY sort_order ASC`,
      [familyIds],
    );
    allCategories = res.rows;
  }

  // 分类索引
  interface CatIndex {
    parentId: string;
    children: Map<string, string>;  // childName → childId
    defaultChildId: string;
  }

  function buildCatIndex(familyId: string): Map<string, Map<string, CatIndex>> {
    const index = new Map<string, Map<string, CatIndex>>();
    const relevantParents = allCategories.filter((c) =>
      c.parent_id === null && (c.family_id === familyId || c.family_id === null),
    );

    for (const parent of relevantParents) {
      if (!index.has(parent.type)) index.set(parent.type, new Map());
      const typeMap = index.get(parent.type)!;

      const children = allCategories.filter((c) => c.parent_id === parent.id);
      const childMap = new Map<string, string>();
      for (const child of children) childMap.set(child.name, child.id);

      const defaultChildId = children.length > 0 ? children[0].id : parent.id;

      // family 分类覆盖系统同名分类
      if (parent.family_id === familyId || !typeMap.has(parent.name)) {
        typeMap.set(parent.name, { parentId: parent.id, children: childMap, defaultChildId });
      }
    }
    return index;
  }

  const catIndexByFamily = new Map<string, Map<string, Map<string, CatIndex>>>();
  for (const fid of familyIds) catIndexByFamily.set(fid, buildCatIndex(fid));

  // 逐行匹配
  const finalRows: ParsedRow[] = [];
  for (const row of validRows) {
    const familyId = ledgerFamilyMap.get(row.ledgerId)!;
    const catIndex = catIndexByFamily.get(familyId);
    if (!catIndex) {
      issues.push({ row: row.rowNum, severity: 'ERROR', message: `无法加载分类数据` });
      continue;
    }

    // 转账分类在 categories 中 type='expense'
    const lookupType = row.type === 'transfer' ? 'expense' : row.type;
    const typeIndex = catIndex.get(lookupType);
    if (!typeIndex) {
      issues.push({ row: row.rowNum, severity: 'ERROR', message: `一级分类"${row.parentCategoryName}"不存在（类型${row.type}）` });
      continue;
    }

    const parentEntry = typeIndex.get(row.parentCategoryName);
    if (!parentEntry) {
      issues.push({ row: row.rowNum, severity: 'ERROR', message: `一级分类"${row.parentCategoryName}"在该账本下不存在` });
      continue;
    }

    if (row.childCategoryName) {
      const childId = parentEntry.children.get(row.childCategoryName);
      if (childId) {
        row.categoryId = childId;
      } else {
        row.categoryId = parentEntry.defaultChildId;
        issues.push({ row: row.rowNum, severity: 'WARNING', message: `二级分类"${row.childCategoryName}"不存在，降级为默认子分类` });
      }
    } else {
      row.categoryId = parentEntry.defaultChildId;
    }

    finalRows.push(row);
  }

  // ═══════════════════════════════════════════════════════════════════
  // 去重检查
  // ═══════════════════════════════════════════════════════════════════

  const nonAutoIds = finalRows.filter((r) => !r.autoGenerated).map((r) => r.entryId);
  const existingIds = new Set<string>();
  if (nonAutoIds.length > 0) {
    const BATCH = 500;
    for (let i = 0; i < nonAutoIds.length; i += BATCH) {
      const batch = nonAutoIds.slice(i, i + BATCH);
      const res = await pool.query(`SELECT id FROM entries WHERE id = ANY($1)`, [batch]);
      for (const row of res.rows) existingIds.add(row.id);
    }
  }

  // ═══════════════════════════════════════════════════════════════════
  // 入库
  // ═══════════════════════════════════════════════════════════════════

  let inserted = 0;
  let updated = 0;
  let skipped = 0;

  if (!args.dryRun && finalRows.length > 0) {
    const client: PoolClient = await pool.connect();
    try {
      await client.query('BEGIN');

      for (const row of finalRows) {
        const alreadyExists = existingIds.has(row.entryId);

        if (alreadyExists && !args.forceUpdate) {
          skipped++;
          continue;
        }

        const occurredAt = `${row.date}T${row.time}:00+08:00`;

        if (alreadyExists && args.forceUpdate) {
          await client.query(
            `UPDATE entries
             SET amount = $2, currency = $3, type = $4, category_id = $5,
                 note = $6, occurred_at = $7, shared_type = $8,
                 version = version + 1,
                 change_seq = nextval('entries_change_seq'),
                 updated_at = now()
             WHERE id = $1 AND deleted_at IS NULL`,
            [row.entryId, row.amount, row.currency, row.type, row.categoryId, row.note || null, occurredAt, row.sharedType],
          );
          updated++;
        } else {
          const res = await client.query(
            `INSERT INTO entries (id, ledger_id, amount, currency, type, category_id,
                                  account_id, to_account_id, note, occurred_at, created_by, shared_type)
             VALUES ($1, $2, $3, $4, $5, $6, NULL, NULL, $7, $8, $9, $10)
             ON CONFLICT (id) DO NOTHING
             RETURNING id`,
            [row.entryId, row.ledgerId, row.amount, row.currency, row.type, row.categoryId, row.note || null, occurredAt, row.userId, row.sharedType],
          );
          if (res.rows.length > 0) {
            inserted++;
          } else {
            // UUID 碰撞兜底：重新生成
            const ts = new Date(occurredAt).getTime();
            const newId = generateUuidV7(ts);
            await client.query(
              `INSERT INTO entries (id, ledger_id, amount, currency, type, category_id,
                                    account_id, to_account_id, note, occurred_at, created_by, shared_type)
               VALUES ($1, $2, $3, $4, $5, $6, NULL, NULL, $7, $8, $9, $10)`,
              [newId, row.ledgerId, row.amount, row.currency, row.type, row.categoryId, row.note || null, occurredAt, row.userId, row.sharedType],
            );
            inserted++;
            issues.push({ row: row.rowNum, severity: 'WARNING', message: `UUID碰撞已自动重新生成: ${row.entryId} → ${newId}` });
          }
        }
      }

      await client.query('COMMIT');
    } catch (err) {
      await client.query('ROLLBACK');
      throw err;
    } finally {
      client.release();
    }
  } else if (args.dryRun) {
    for (const row of finalRows) {
      const alreadyExists = existingIds.has(row.entryId);
      if (alreadyExists && !args.forceUpdate) skipped++;
      else if (alreadyExists && args.forceUpdate) updated++;
      else inserted++;
    }
  }

  // ═══════════════════════════════════════════════════════════════════
  // 输出报告
  // ═══════════════════════════════════════════════════════════════════

  const errorCount = issues.filter((i) => i.severity === 'ERROR').length;
  const warningCount = issues.filter((i) => i.severity === 'WARNING').length;
  const prefix = args.dryRun ? '[DRY-RUN] ' : '';

  console.log('');
  console.log(`${prefix}═══ 导入报告 ═══`);
  console.log(`${prefix}✅ ${args.dryRun ? '将' : '已'}成功导入: ${inserted} 条`);
  if (updated > 0) console.log(`${prefix}🔄 ${args.dryRun ? '将' : '已'}覆盖更新: ${updated} 条`);
  if (skipped > 0) console.log(`${prefix}⏭️  跳过(重复): ${skipped} 条`);
  if (warningCount > 0) console.log(`${prefix}⚠️  警告: ${warningCount} 条`);
  if (errorCount > 0) console.log(`${prefix}❌ 失败(校验不通过): ${errorCount} 条`);
  console.log(`${prefix}📊 总行数: ${rawLines.length - 1} | 有效: ${finalRows.length} | 错误: ${errorCount}`);

  // 写入详细报告
  if (issues.length > 0) {
    const errLines = ['行号,级别,原因'];
    for (const issue of issues) {
      errLines.push(`${issue.row},${issue.severity},${csvEscapeSimple(issue.message)}`);
    }
    const reportName = basename(args.file, '.csv') + '_report.csv';
    const reportPath = join(dirname(args.file), reportName);
    writeFileSync(reportPath, '\uFEFF' + errLines.join('\r\n') + '\r\n', 'utf-8');
    console.log(`${prefix}📄 详细报告: ${reportPath}`);
  }

  // 自动生成 ID 映射表
  const autoRows = finalRows.filter((r) => r.autoGenerated);
  if (autoRows.length > 0 && !args.dryRun) {
    const mapLines = ['行号,生成的记录ID'];
    for (const row of autoRows) {
      mapLines.push(`${row.rowNum},${row.entryId}`);
    }
    const mapName = basename(args.file, '.csv') + '_id_map.csv';
    const mapPath = join(dirname(args.file), mapName);
    writeFileSync(mapPath, '\uFEFF' + mapLines.join('\r\n') + '\r\n', 'utf-8');
    console.log(`${prefix}🆔 自动生成ID映射: ${mapPath}`);
  }

  console.log('');
  process.exit(errorCount > 0 ? 1 : 0);
}

function csvEscapeSimple(value: string): string {
  if (value.includes(',') || value.includes('"') || value.includes('\n')) {
    return `"${value.replace(/"/g, '""')}"`;
  }
  return value;
}

main().catch((err) => {
  console.error('❌ 导入失败:', err.message ?? err);
  process.exit(1);
});

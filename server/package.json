{
  "name": "@costra/server",
  "version": "0.2.0",
  "private": true,
  "description": "Costra Server · Fastify 5 · PostgreSQL 15 · Redis 7 (COSTRA-101 实装版)",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.0.0"
  },
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "lint": "echo \"[COSTRA-117] ESLint wiring deferred to DevOps\" && exit 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down -v",
    "db:migrate": "bash scripts/dev/migrate.sh",
    "db:reset-data": "bash scripts/dev/reset-data.sh",
    "db:seed:curl-test": "bash scripts/dev/seed-curl-test.sh"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/jwt": "^10.0.0",
    "@fastify/multipart": "^10.0.0",
    "@fastify/sensible": "^6.0.1",
    "dotenv": "^16.4.5",
    "fastify": "^5.1.0",
    "ioredis": "^5.4.1",
    "luxon": "^3.5.0",
    "pg": "^8.13.1",
    "pino": "^9.5.0",
    "uuidv7": "^1.0.2"
  },
  "devDependencies": {
    "@types/luxon": "^3.4.0",
    "@types/node": "^20.17.6",
    "@types/pg": "^8.11.10",
    "@vitest/coverage-v8": "^4.1.5",
    "ioredis-mock": "^8.9.0",
    "pg-mem": "^3.0.3",
    "pino-pretty": "^11.3.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^4.1.5"
  }
}

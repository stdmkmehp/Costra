# ==============================================================
# Costra Server · .env 模板
# 卡号：COSTRA-101 · 首次完整落地（此前只有 subject 段）
# ==============================================================

# ---- 运行环境 ----
NODE_ENV=development
PORT=8080
LOG_LEVEL=info

# ---- 数据库（PostgreSQL 15，见 ADR-0006）----
DATABASE_URL=postgres://costra:costra_dev_pw@localhost:5432/costra

# ---- 缓存（Redis 7）----
REDIS_URL=redis://localhost:6379/0

# ---- JWT 签发 ----
# 生产环境必须 >= 64 字节随机字符串（openssl rand -base64 48）
JWT_SECRET=__dev_only_change_in_prod_please__change_me_to_a_long_random_string__
JWT_ISSUER=costra-server
JWT_AUDIENCE=costra-miniapp

# ---- 微信小程序（由 Human 在 D-007 外部资源卡后填入） ----
WX_APP_ID=wx_placeholder_app_id
WX_APP_SECRET=wx_placeholder_app_secret
# 微信 code2Session 上游（保留可配置，便于测试期替换 mock server）
WX_CODE2SESSION_URL=https://api.weixin.qq.com/sns/jscode2session

# ---- TTL（见 docs/api/ttl-policy.md §4.1） ----
TTL_ACCESS_TOKEN_SEC=7200
TTL_REFRESH_TOKEN_SEC=2592000
TTL_INVITE_DEFAULT_HOURS=24
TTL_INVITE_MAX_HOURS=168
TTL_IDEMPOTENCY_HOURS=24
TTL_AUDIT_HOT_DAYS=180
TTL_CURSOR_HOURS=72
TTL_RATE_WINDOW_SEC=60
TTL_WX_SESSION_KEY_SEC=259200
# GM 用户双榜单（近7天活跃 + 最近注册）Redis 缓存时效（秒）
TTL_GM_ACTIVE_USERS_SEC=1800
# 赞赏对账（tech-spec v1.2 §6.1）：调度器 tick 周期 / 探测租约节流 / created 观察窗口 / 单批上限
TTL_TIP_SCHEDULER_TICK_SEC=60
TTL_TIP_PROBE_MIN_INTERVAL_SEC=3
TTL_TIP_PROBE_WINDOW_SEC=1800
TTL_TIP_PROBE_BATCH_SIZE=50

# ---- 虚拟支付（赞赏 · tech-spec v1.2 §2.5 · 个人主体虚拟支付） ----
# 灰度模式：off（关闭）/ allowlist（仅白名单可下单）/ on（全量）
WX_PAY_MODE=off
# 灰度白名单（用户 UUID，逗号分隔；非法 UUID 启动失败）
WX_PAY_TEST_USER_IDS=
# 虚拟支付 OfferID 与 AppKey（开通虚拟支付后由微信分配 · WX_PAY_MODE != off 时必填）
WX_PAY_OFFER_ID=
WX_PAY_APP_KEY=
# 消息推送 Token（可选 · 配置后 GET /v1/tips/notify 启用签名校验握手）
WX_MSG_PUSH_TOKEN=

# ---- 主体（D-008 / COSTRA-113 · subject.ts 消费） ----
SUBJECT_NAME=张三
SUBJECT_TYPE=individual
SUBJECT_ICP_NUMBER=
SUBJECT_CONTACT_EMAIL=support@costra.cloud
SUBJECT_CONTACT_PHONE=
SUBJECT_PRIVACY_EFFECTIVE_DATE=2026-04-20
SUBJECT_DATA_CONTROLLER=

# ---- 腾讯云 COS（导入导出产物对象存储 · cos-offload-phase1 v0.2 · infra/cos-setup.md） ----
# 私有桶 + 自定义下载域名；CAM 子账号最小权限密钥（只落 server.env · 严禁入库/入镜像）。
# 全部可选：测试环境无需配置；缺失在首次使用 COS 时才报错（cosClient 惰性单例）。
COS_SECRET_ID=
COS_SECRET_KEY=
COS_REGION=ap-shanghai
COS_BUCKET_EXPORTS=
COS_DOWNLOAD_BASE=
# 二期头像桶（公有读私有写 · 禁止生命周期 · docs/design/cos-offload-phase2-avatar.md §6）
COS_BUCKET_AVATARS=
COS_AVATAR_BASE=

# ---- 构建标识（运维注入；本地留空） ----
BUILD_SHA=

<!-- pages-recurring/edit/index.wxml · 定时记账编辑页 -->
<view class="recedit">
<!-- 自定义导航栏 -->
  <view class="recedit__nav" style="padding-top: {{statusBarHeight}}px; height: {{navBarHeight}}px;">
    <view class="recedit__nav-back" bindtap="onTapBack">
      <view class="recedit__nav-back-arrow"></view>
    </view>
    <text class="recedit__nav-title">{{mode === 'edit' ? '编辑定时' : '新建定时'}}</text>
  </view>

  <scroll-view wx:if="{{!loading}}" class="recedit__scroll" scroll-y
    style="padding-top: {{navBarTotalHeight + 8}}px;">
    <view class="recedit__scroll-inner">
    <!-- 卡片1：记什么 -->
  <view class="recedit__card {{saveFlashError && validationSection === 1 ? 'recedit__card--error-flash' : ''}}">
      <!-- 金额 -->
      <view class="recedit__row {{saveFlashError && amountCents <= 0 ? 'recedit__row--error' : ''}}">
  <text class="recedit__label">金额</text>
     <view class="recedit__amount-input-wrap">
      <text class="recedit__amount-prefix">¥</text>
          <input class="recedit__amount-input tnum" type="digit" placeholder="0.00"
           value="{{amountDisplay}}" bindblur="onAmountBlur" bindinput="onAmountInput"
    placeholder-class="recedit__amount-placeholder" />
        </view>
      </view>

      <!-- 分类 -->
      <view class="recedit__row" bindtap="onShowCategoryPicker" hover-class="recedit__row--hover">
        <text class="recedit__label">分类</text>
        <view class="recedit__value">
    <text wx:if="{{categoryId && entryTypeLabel}}" class="recedit__type-badge">{{entryTypeLabel}}</text>
          <text wx:if="{{categoryIcon}}" class="recedit__category-icon">{{categoryIcon}}</text>
          <text>{{categoryName || '请选择'}}</text>
        </view>
    <text class="recedit__arrow">›</text>
</view>

      <!-- 账本 -->
      <view class="recedit__row" bindtap="onTapLedger" hover-class="recedit__row--hover">
        <text class="recedit__label">账本</text>
    <text class="recedit__value">{{ledgerName || '请选择'}}</text>
        <text class="recedit__arrow">›</text>
    </view>

   <!-- 归属 -->
      <view class="recedit__row {{sharedDisabled ? 'recedit__row--disabled' : ''}}">
        <text class="recedit__label">归属</text>
    <view class="recedit__capsules">
          <view class="recedit__capsule {{sharedType === 'shared' ? 'recedit__capsule--active' : ''}} {{sharedDisabled ? 'recedit__capsule--disabled' : ''}}"
       data-val="shared" bindtap="onToggleShared">公共</view>
          <view class="recedit__capsule {{sharedType === 'personal' ? 'recedit__capsule--active' : ''}} {{sharedDisabled ? 'recedit__capsule--disabled' : ''}}"
       data-val="personal" bindtap="onToggleShared">个人</view>
        </view>
      </view>

 <!-- 备注 -->
      <view class="recedit__row">
  <text class="recedit__label">备注</text>
        <input class="recedit__input" placeholder="选填" value="{{note}}" bindinput="onNoteInput" />
      </view>
    </view>

    <!-- 卡片2：什么时候记 -->
    <view class="recedit__card {{saveFlashError && validationSection === 2 ? 'recedit__card--error-flash' : ''}}">
      <!-- 周期选择 -->
      <view class="recedit__row" bindtap="onShowPeriodSheet" hover-class="recedit__row--hover">
        <text class="recedit__label">周期</text>
   <text class="recedit__value">{{periodLabel}}</text>
     <text class="recedit__arrow">›</text>
      </view>

      <!-- 工作日说明 -->
      <view wx:if="{{period === 'workday'}}" class="recedit__workday-hint">
        工作日定义依据中国国务院办公厅发布的节假日安排，包含调休补班日，自动跳过法定节假日。
      </view>

      <!-- 每 N 天说明 -->
      <view wx:if="{{period === 'daily'}}" class="recedit__workday-hint">
        从起始日起算，每 {{periodInterval}} 天自动执行一次，不区分工作日与节假日。
      </view>

      <!-- DOW 控件（每周/每两周） -->
      <recurring-dow-picker
        wx:if="{{period === 'weekly'}}"
        value="{{daysOfWeek}}"
    period="{{period}}"
      bind:change="onDowChange"
      bind:clear="onDowClear"
        bind:limit="onDowLimit"
      />

      <!-- DOM 控件（每月/每两月/每三月） -->
      <recurring-dom-picker
        wx:if="{{period === 'monthly'}}"
   value="{{daysOfMonth}}"
        period="{{period}}"
     bind:change="onDomChange"
        bind:clear="onDomClear"
        bind:limit="onDomLimit"
      />

      <!-- Yearly 控件 -->
      <recurring-yearly-picker
     wx:if="{{period === 'yearly'}}"
    value="{{yearMonthDays}}"
 bind:change="onYearlyChange"
     bind:clear="onYearlyClear"
        bind:limit="onYearlyLimit"
      />

      <!-- 时段 -->
      <recurring-bucket-picker
        value="{{bucket}}"
   bind:change="onBucketChange"
      />

      <!-- 起始日 -->
   <picker mode="date" value="{{startDate}}" start="{{startDateMin}}" end="{{startDateMax}}" bindchange="onStartDateChange">
        <view class="recedit__row" hover-class="recedit__row--hover">
          <text class="recedit__label">起始日</text>
          <view class="recedit__value recedit__date-value">
            <text class="tnum">{{startDate}}</text>
            <text class="recedit__date-suffix">0点</text>
          </view>
  <text class="recedit__arrow">›</text>
        </view>
      </picker>

      <!-- 结束日 -->
      <view class="recedit__row">
        <text class="recedit__label">结束日</text>
        <view class="recedit__end-date-right">
          <switch class="recedit__switch" checked="{{hasEndDate}}" bindchange="onToggleEndDate" color="#8AA98F" />
          <picker wx:if="{{hasEndDate}}" mode="date" value="{{endDate}}" start="{{endDateMin}}" end="{{endDateMax}}" bindchange="onEndDateChange">
            <view class="recedit__value recedit__end-date-text recedit__date-value">
              <text class="tnum">{{endDate || '请选择'}}</text>
              <text class="recedit__date-suffix">24点</text>
            </view>
          </picker>
          <text wx:else class="recedit__value recedit__end-date-text">永不结束</text>
          <text wx:if="{{hasEndDate}}" class="recedit__arrow">›</text>
        </view>
      </view>
    </view>

    <!-- 卡片3：预览 -->
    <view class="recedit__card recedit__card--preview">
      <view class="recedit__preview-main">
        <text class="recedit__preview-icon">⟳</text>
        <text class="recedit__preview-desc">{{previewDesc || '—'}}</text>
      </view>
      <view class="recedit__preview-next">
        <text class="recedit__preview-label">预计下次执行</text>
        <view class="recedit__preview-datetime">
          <text class="recedit__preview-date tnum">{{previewDate}}</text>
          <text class="recedit__preview-bucket" wx:if="{{previewBucket}}">{{previewBucket}}</text>
        </view>
      </view>
    </view>

    <!-- 底部保存按钮 -->
    <view class="recedit__save-btn {{isValid && !saving ? 'recedit__save-btn--active' : ''}}" bindtap="onSave">
      <text>{{saving ? '保存中…' : '保存'}}</text>
    </view>
    </view><!-- .recedit__scroll-inner -->
  </scroll-view>

  <!-- 加载态：编辑/复制模式拉取规则 + 分类时遮罩，避免分类栏短促显示"请选择" -->
  <view wx:if="{{loading}}" class="recedit__loading" style="padding-top: {{navBarTotalHeight + 8}}px;">
    <view class="recedit__loading-spinner"></view>
    <text class="recedit__loading-text">加载中…</text>
  </view>

  <!-- 周期选择 action-sheet -->
  <recurring-period-selector
  show="{{showPeriodSheet}}"
    value="{{period}}"
    period-interval="{{periodInterval}}"
    bind:change="onPeriodChange"
    bind:close="onPeriodClose"
  />

  <!-- 分类选择器 -->
  <category-grid
    show="{{showCategoryPicker}}"
    value="{{categoryId}}"
    current-type="{{entryType}}"
    family-id="{{ledgerFamilyId}}"
    auto-commit="{{true}}"
  auto-select-first-child="{{true}}"
    lock-type="{{false}}"
    bind:select="onCategorySelect"
    bind:close="onCategoryClose"
  />
</view>

<!-- pages-recurring/list/index.wxml · 定时记账列表页 -->
<view class="reclist">
  <!-- 自定义导航栏 -->
  <view class="reclist__nav" style="padding-top: {{statusBarHeight}}px; height: {{navBarHeight}}px;">
    <view class="reclist__nav-back" bindtap="onTapBack">
      <text class="reclist__nav-back-icon">‹</text>
    </view>
    <text class="reclist__nav-title">定时记账</text>
  </view>

  <!-- 内容区 -->
  <view class="reclist__content" style="padding-top: {{navBarTotalHeight}}px;">
    <!-- 加载态 -->
  <view wx:if="{{loading}}" class="reclist__loading">
      <text class="reclist__loading-text">加载中…</text>
 </view>

    <!-- 错误态 -->
    <view wx:elif="{{error}}" class="reclist__error">
      <text class="reclist__error-text">加载失败</text>
      <view class="reclist__error-btn" bindtap="onRefresh">重试</view>
    </view>

    <!-- 空态 -->
    <view wx:elif="{{isEmpty}}" class="reclist__empty">
      <text class="reclist__empty-title">还没有定时记账</text>
 <text class="reclist__empty-sub">设一次，Costra 帮你自动记</text>
      <view class="reclist__empty-btn" bindtap="onTapAdd">+ 添加定时</view>
    </view>

    <!-- 有数据 -->
    <view wx:else class="reclist__body">
   <!-- 顶部计数摘要 -->
    <view class="reclist__summary" wx:if="{{summaryText}}">
      <text>{{summaryText}}</text>
      <text class="reclist__summary-hint">· 长按规则可展开更多操作</text>
      </view>

      <!-- 启用分组 -->
      <view class="reclist__card" wx:if="{{enabledRules.length > 0}}">
   <view wx:for="{{enabledRules}}" wx:key="id"
       class="reclist__item {{longPressRuleId === item.id ? 'reclist__item--highlight' : ''}}"
              data-id="{{item.id}}" bindtap="onTapRule"
      bindlongpress="onLongPressRule"
              hover-class="reclist__item--hover" hover-stay-time="60">
   <view class="reclist__item-sep" wx:if="{{index > 0}}"></view>
  <view class="reclist__item-inner">
            <view class="reclist__icon reclist__icon--glyph">{{item.categoryIcon}}</view>
 <view class="reclist__mid">
              <text class="reclist__title">{{item.title}}</text>
        <text class="reclist__sub">{{item.subtitle}}</text>
         </view>
            <text class="reclist__amount tnum">{{item.amountText}}</text>
          </view>
        </view>
      </view>

      <!-- 禁用分组 -->
    <view wx:if="{{disabledRules.length > 0}}" class="reclist__disabled-section">
        <view class="reclist__disabled-title">── 已禁用 ──</view>
        <view class="reclist__card reclist__card--disabled">
          <view wx:for="{{disabledRules}}" wx:key="id"
      class="reclist__item reclist__item--disabled {{longPressRuleId === item.id ? 'reclist__item--highlight' : ''}}"
       data-id="{{item.id}}" bindtap="onTapRule"
           bindlongpress="onLongPressRule"
  hover-class="reclist__item--hover" hover-stay-time="60">
    <view class="reclist__item-sep" wx:if="{{index > 0}}"></view>
    <view class="reclist__item-inner">
              <view class="reclist__icon reclist__icon--glyph">{{item.categoryIcon}}</view>
         <view class="reclist__mid">
                <text class="reclist__title">{{item.title}}</text>
           <text class="reclist__sub">{{item.subtitle}} · <text class="reclist__tag--amber">{{item.statusHint}}</text></text>
            </view>
       <text class="reclist__amount tnum">{{item.amountText}}</text>
         </view>
          </view>
    </view>
      </view>

      <!-- 底部添加按钮 -->
      <view class="reclist__add-bottom" bindtap="onTapAdd">+ 添加定时</view>
    </view>
  </view>

  <!-- 长按上下文菜单（与明细页共用 .ctx-menu* 设计语言） -->
  <view wx:if="{{ctxMenuVisible}}" class="ctx-menu-overlay" bindtap="onCloseCtxMenu">
<view class="ctx-menu" style="left:{{ctxMenuX}}px;top:{{ctxMenuY}}px;" catchtap="onCtxMenuNoop">
      <view class="ctx-menu__item" bindtap="onCtxCopy">
        <view class="ctx-ic ctx-ic--copy"><view></view><view></view></view>
        <text class="ctx-menu__text">复制规则</text>
      </view>
      <view class="ctx-menu__item" bindtap="onCtxEdit">
        <view class="ctx-ic ctx-ic--edit">
          <view class="pencil">
            <view class="pencil-tip"></view>
            <view class="pencil-ferrule"></view>
            <view class="pencil-end"></view>
          </view>
        </view>
        <text class="ctx-menu__text">修改规则</text>
      </view>
      <view class="ctx-menu__item" bindtap="onCtxToggle">
        <view class="ctx-ic ctx-ic--play" wx:if="{{ctxMenuRule.status === 'paused' || ctxMenuRule.status === 'ended' || ctxMenuRule.status === 'auto_paused'}}"></view>
        <view class="ctx-ic ctx-ic--pause" wx:else><view></view><view></view></view>
        <text class="ctx-menu__text">{{ctxMenuRule.status === 'active' ? '禁用' : '启用'}}</text>
      </view>
      <view class="ctx-menu__item ctx-menu__item--danger" bindtap="onCtxDelete">
        <view class="ctx-ic ctx-ic--trash"><view class="lid"></view><view class="can"></view></view>
        <text class="ctx-menu__text">删除</text>
      </view>
    </view>
  </view>
</view>

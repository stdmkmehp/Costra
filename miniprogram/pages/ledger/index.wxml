<!-- pages/ledger/index.wxml · 明细页（首屏 Tab1） -->
<!-- 卡号: COSTRA-203 / COSTRA-220 · 明细首屏巨大月支出+日期分组吸顶流水列表+左滑删除+账本切换+真实数据对接 -->
<!-- 设计源: design/ui/design_spec.md §6.2 + design/ui/interaction_flow.md §4 -->
<!-- ready gate: bootstrap 完成且已登录前页面完全空白，消除冷启动框架闪现 -->

<view class="ledger" bindtap="onTapPage" wx:if="{{ready}}">

  <!-- ─── 自定义导航栏（账本切换器 · 锚定下拉气泡）───────────────────────────── -->
  <ledger-switcher name="{{ledgerName}}" />

  <!-- ─── 头部汇总区 ───────────────────────────────────────────────────────── -->
  <view class="header" style="padding-top: {{navBarTotalHeight + 8}}px;">
    <view class="header__left">
      <!-- 巨大当月总支出 · 112rpx / 600 / tnum -->
      <text class="header__total-expense tnum">{{totalExpense}}</text>
      <!-- 收入 + 结余 辅助行 · 28rpx / secondary -->
      <text class="header__sub">{{totalBalance}}</text>
      <!-- COSTRA-4xx · 第 3 行：预算 + 资产 · 顺序：预算 在前、资产 在后，中点分隔 -->
      <view class="header__asset-budget">
        <!-- 预算（剩余 / 上限） -->
        <view class="header__budget" catchtap="onTapBudgetEdit">
          <text class="header__budget-label">预算</text>
          <block wx:if="{{budgetDisplay}}">
            <text class="header__budget-remain tnum {{budgetColorClass}}">{{budgetDisplay.remain}}</text>
            <text class="header__budget-sep">/</text>
            <text class="header__budget-total tnum">{{budgetDisplay.total}}</text>
          </block>
          <text wx:else class="header__budget-unset">--</text>
          <text class="header__edit-icon" aria-hidden="true">✎</text>
        </view>
        <!-- 中点分隔符（与「收入 · 结余」视觉一致） -->
        <text class="header__asset-budget__sep" aria-hidden="true">·</text>
        <!-- 资产（带 ✎ 编辑图标） -->
        <view class="header__asset" catchtap="onTapAssetEdit">
          <text class="header__asset-label">资产</text>
          <text class="header__asset-value tnum">{{assetDisplay}}</text>
          <text class="header__edit-icon" aria-hidden="true">✎</text>
        </view>
      </view>
    </view>
  </view>


  <!-- ─── 时间导航 + 筛选行（支出/收入下方、流水上方） ───────────────────────── -->
  <view class="filter-row">
    <view class="filter-row__left">
      <view class="filter-row__arrow month-switcher__arrow month-switcher__arrow--prev" hover-class="month-switcher__arrow--pressed" hover-stay-time="80" bindtap="onPrevMonth">
        <text class="filter-row__arrow-icon month-switcher__arrow-icon">‹</text>
      </view>
      <picker mode="date" fields="month" value="{{currentMonth}}" bindchange="onMonthChange">
        <view class="filter-row__month month-switcher__value" hover-class="month-switcher__value--pressed" hover-stay-time="80">
          <text class="filter-row__month-text">{{monthDisplay}}</text>
          <text class="filter-row__dropdown">▼</text>
        </view>
      </picker>
      <view class="filter-row__arrow month-switcher__arrow month-switcher__arrow--next" hover-class="month-switcher__arrow--pressed" hover-stay-time="80" bindtap="onNextMonth">
        <text class="filter-row__arrow-icon month-switcher__arrow-icon">›</text>
      </view>
      <!-- 返回当月按钮：仅在非当前月时显示 -->
      <view
        wx:if="{{!isCurrentMonth}}"
        class="month-switcher__today"
        hover-class="month-switcher__today--pressed"
        hover-stay-time="80"
        bindtap="onBackToCurrentMonth"
      >
        <text class="month-switcher__today-icon">⤺</text>
        <text class="month-switcher__today-text">返回本月</text>
      </view>
    </view>
    <!-- 筛选按钮（始终显示：支持类型/成员/分类/搜索筛选） -->
    <view class="filter-row__right {{filterActive ? 'is-active' : ''}}" catchtap="onTapMemberFilter">
      <text class="filter-row__member-text">{{memberFilterText}}</text>
      <text class="filter-row__member-arrow {{filterPanelVisible ? 'is-rotated' : ''}}">▼</text>
    </view>
  </view>

  <!-- ─── 流水列表（含筛选面板浮层） ─────────────────────────────────────────── -->
  <view class="list-container">
    <!-- 筛选面板（浮于列表上方） -->
    <filter-panel
      visible="{{filterPanelVisible}}"
      members="{{filterMembers}}"
      entryType="{{filterEntryType}}"
      categories="{{filterCategories}}"
      expandedCategoryId="{{filterExpandedCategoryId}}"
      categoryAllSelected="{{filterCategoryAllSelected}}"
      searchKeyword="{{filterSearchKeyword}}"
      bind:entryTypeChange="onFilterEntryTypeChange"
      bind:memberToggle="onFilterMemberToggle"
      bind:selectAll="onFilterSelectAll"
      bind:close="onFilterPanelClose"
      bind:searchInput="onFilterSearchInput"
      bind:categoryExpand="onFilterCategoryExpand"
      bind:categoryToggle="onFilterCategoryToggle"
      bind:categorySolo="onFilterCategorySolo"
      bind:categorySelectAll="onFilterCategorySelectAll"
      bind:categoryToggleAll="onFilterCategoryToggleAll"
      bind:categoryReset="onFilterCategoryReset"
    />

    <scroll-view
      class="entry-list"
      style="padding-bottom: {{entryListBottomPadding}}px;"
      scroll-y
      using-sticky
      enhanced
      show-scrollbar="{{false}}"
      scroll-top="{{listScrollTop}}"
      catchtap="onFilterPanelClose"
      bindscroll="onListScroll"
    >
    <view
      class="ledger-loading-state"
      wx:if="{{ledgerLoadingState === 'validating-ledger' || ledgerLoadingState === 'loading-cache' || ledgerLoadingState === 'loading-remote'}}"
    >
      <view class="ledger-loading-state__spinner"></view>
      <text class="ledger-loading-state__text">{{ledgerLoadingText}}</text>
      <view class="ledger-skeleton">
        <view wx:for="{{ledgerSkeletonRows}}" wx:key="*this" class="ledger-skeleton__row">
          <view class="ledger-skeleton__icon"></view>
          <view class="ledger-skeleton__content">
            <view class="ledger-skeleton__line ledger-skeleton__line--main"></view>
            <view class="ledger-skeleton__line ledger-skeleton__line--sub"></view>
          </view>
          <view class="ledger-skeleton__amount"></view>
        </view>
      </view>
    </view>

    <view class="ledger-partial-hint" wx:if="{{ledgerLoadingState === 'ready-partial'}}">
      <text>{{ledgerLoadingText}}</text>
    </view>

    <block wx:if="{{ledgerLoadingState !== 'validating-ledger' && ledgerLoadingState !== 'loading-cache' && ledgerLoadingState !== 'loading-remote' && !isEmpty}}">
      <block wx:for="{{dateGroups}}" wx:key="dateKey" wx:for-item="group">
        <!-- 日期分组头（sticky 吸顶） -->
        <view class="date-header">
          <text class="date-header__label">{{group.dateLabel}}</text>
          <text class="date-header__summary tnum">{{group.daySummary}}</text>
        </view>

        <!-- 条目列表 -->
        <view
          wx:for="{{group.entries}}"
          wx:key="client_ref_id"
          wx:for-item="entry"
          class="entry-item-wrap"
        >
          <!-- 滑动容器 -->
          <view
            class="entry-item {{entry.type === 'income' ? 'entry-item--income' : ''}} {{entry.client_ref_id === ctxActiveRefId || entry.client_ref_id === editActiveRefId ? 'entry-item--ctx-active' : ''}}"
            style="{{entry.translateStyle}}"
            data-refid="{{entry.client_ref_id}}"
            bindtouchstart="onTouchStart"
            bindtouchmove="onTouchMove"
            bindtouchend="onTouchEnd"
            bindtouchcancel="onTouchCancel"
            bindlongpress="onEntryLongPress"
          >
            <!-- 极简单色圆形图标 · COSTRA-227: 点击编辑分类 -->
            <view class="entry-icon" data-refid="{{entry.client_ref_id}}" catchtap="onTapEntryCategory">
              <text class="entry-icon__text">{{entry.icon}}</text>
              <!-- 单人账本：角标依附分类图标；固定“定 公”顺序 -->
              <view wx:if="{{!showMemberFilter && (entry.isRecurring || entry.isShared)}}" class="entry-member__badge">
                <text wx:if="{{entry.isRecurring}}" class="entry-member__badge-text entry-member__badge-text--recurring">定</text>
                <text wx:if="{{entry.isShared}}" class="entry-member__badge-text entry-member__badge-text--shared">公</text>
              </view>
            </view>
            <!-- 分类名/备注 · COSTRA-227: 点击原地编辑备注 -->
            <view class="entry-label grow" data-refid="{{entry.client_ref_id}}" catchtap="onTapEntryNote">
              <text wx:if="{{editingNoteRefId !== entry.client_ref_id}}" class="entry-label__text">{{entry.label}}</text>
              <!-- 保存由键盘「完成」键(bindconfirm)或点编辑框外区域触发；
                   刻意不绑 bindblur，避免失焦抢先清态导致点击穿透打开面板(见 _consumeNoteEditingIfActive) -->
              <input
                wx:if="{{editingNoteRefId === entry.client_ref_id}}"
                class="entry-label__input"
                value="{{editNoteValue}}"
                placeholder="添加备注..."
                focus="{{true}}"
                bindinput="onEditNoteInput"
                bindconfirm="onConfirmEditNote"
                maxlength="200"
              />
            </view>
            <!-- 金额 · COSTRA-227: 点击编辑金额 -->
            <!-- 成员头像（协作账本 · 贴金额左侧） -->
            <view wx:if="{{showMemberFilter}}" class="entry-member" data-refid="{{entry.client_ref_id}}" catchtap="onTapEntryAmount">
              <image
                wx:if="{{entry.avatarUrl}}"
                class="entry-member__avatar"
                src="{{entry.avatarUrl}}"
                mode="aspectFill"
                lazy-load
              />
              <view wx:elif="{{entry.memberInitial}}" class="entry-member__fallback">
                <text class="entry-member__initial">{{entry.memberInitial}}</text>
              </view>
              <!-- 协作账本：角标依附成员头像；固定“定 公”顺序 -->
              <view wx:if="{{entry.isRecurring || entry.isShared}}" class="entry-member__badge">
                <text wx:if="{{entry.isRecurring}}" class="entry-member__badge-text entry-member__badge-text--recurring">定</text>
                <text wx:if="{{entry.isShared}}" class="entry-member__badge-text entry-member__badge-text--shared">公</text>
              </view>
            </view>
            <view class="entry-amount-wrap" data-refid="{{entry.client_ref_id}}" catchtap="onTapEntryAmount">
              <text class="entry-amount tnum {{entry.type === 'income' ? 'entry-amount--income' : ''}} {{entry.type === 'transfer' ? 'entry-amount--transfer' : ''}}">{{entry.amountText}}</text>
            </view>
          </view>
          <!-- 左滑删除按钮 -->
          <view
            class="entry-delete"
            data-refid="{{entry.client_ref_id}}"
            catchtap="onDeleteEntry"
          >
            <text class="entry-delete__text">删除</text>
          </view>
        </view>
      </block>
    </block>

    <!-- ─── 空状态 / 失败状态 ──────────────────── -->
    <view class="empty-state" wx:if="{{ledgerLoadingState === 'empty-confirmed'}}">
      <text class="empty-state__title">{{emptyTitle}}</text>
      <text class="empty-state__hint">{{emptyHint}}</text>
    </view>

    <view class="empty-state empty-state--failed" wx:if="{{ledgerLoadingState === 'failed'}}">
      <text class="empty-state__title">{{ledgerLoadingText}}</text>
      <text class="empty-state__hint">{{ledgerLoadError || '检查网络后再试一次'}}</text>
      <button class="empty-state__retry" bindtap="onRetryLedgerLoad">重试</button>
    </view>
  </scroll-view>
  </view><!-- /.list-container -->

  <!-- ═══ COSTRA-227: 全屏分类选择面板（复用 category-grid 组件） ═══ -->
  <category-grid
    show="{{editCategoryVisible}}"
    value="{{editSelectedTier2Id}}"
    current-type="{{editCategoryLockedType}}"
    family-id="{{activeFamilyId}}"
    lock-type="{{true}}"
    auto-commit="{{true}}"
    auto-select-first-child="{{true}}"
    bind:select="onEditCategoryGridSelect"
    bind:close="onCloseEditCategory"
  />

  <!-- ═══ COSTRA-227: 底部金额编辑键盘面板（半屏，上方仍显示明细） ═══ -->
  <view class="edit-amount-panel {{editAmountVisible ? 'is-visible' : ''}}">
    <view class="edit-amount-panel__mask" bindtap="onCloseEditAmount"></view>
    <view class="edit-amount-panel__sheet keypad-sheet" style="padding-bottom: env(safe-area-inset-bottom, 0px);">
      <!-- 金额显示（公共样式） -->
      <view class="keypad-sheet__amount">
        <text class="keypad-sheet__prefix">¥</text>
        <text class="keypad-sheet__value tnum">{{editAmountDisplay}}</text>
      </view>
      <!-- 操作行：费用性质 -->
      <view class="keypad-sheet__actions">
        <view class="keypad-shared {{editAmountShowShared ? 'is-visible' : ''}}" bindtap="onEditAmountToggleShared">
          <text class="keypad-shared__text {{editAmountSharedType === 'personal' ? 'is-active' : ''}}">个人支出</text>
          <text class="keypad-shared__sep">|</text>
          <text class="keypad-shared__text {{editAmountSharedType === 'shared' ? 'is-active' : ''}}">公共支出</text>
        </view>
      </view>
      <!-- 数字键盘（公共样式 · 2026-07-16 从 4 行扩至 5 行：AC / 粘贴 / × / ÷） -->
      <view class="keypad">
        <!-- 第 1 行：AC 粘贴 日期 × -->
        <view class="keypad__row">
          <view class="keypad__key keypad__key--fn keypad__key--clear" data-key="clear" bindtap="onEditAmountKey"><text>AC</text></view>
          <view class="keypad__key keypad__key--fn keypad__key--paste" data-key="paste" bindtap="onEditAmountKey"><text>Paste</text></view>
          <picker class="keypad__picker" mode="date" value="{{editAmountDate}}" bindchange="onEditAmountDateChange">
            <view class="keypad__key keypad__key--fn keypad__key--date"><text>{{editAmountDateText}}</text></view>
          </picker>
          <view class="keypad__key keypad__key--fn keypad__key--op" data-key="*" bindtap="onEditAmountKey"><text>×</text></view>
        </view>
        <!-- 第 2 行：1 2 3 ÷ -->
        <view class="keypad__row">
          <view class="keypad__key" data-key="1" bindtap="onEditAmountKey"><text>1</text></view>
          <view class="keypad__key" data-key="2" bindtap="onEditAmountKey"><text>2</text></view>
          <view class="keypad__key" data-key="3" bindtap="onEditAmountKey"><text>3</text></view>
          <view class="keypad__key keypad__key--fn keypad__key--op" data-key="/" bindtap="onEditAmountKey"><text>÷</text></view>
        </view>
        <!-- 第 3 行：4 5 6 + -->
        <view class="keypad__row">
          <view class="keypad__key" data-key="4" bindtap="onEditAmountKey"><text>4</text></view>
          <view class="keypad__key" data-key="5" bindtap="onEditAmountKey"><text>5</text></view>
          <view class="keypad__key" data-key="6" bindtap="onEditAmountKey"><text>6</text></view>
          <view class="keypad__key keypad__key--fn keypad__key--op" data-key="+" bindtap="onEditAmountKey"><text>+</text></view>
        </view>
        <!-- 第 4 行：7 8 9 - -->
        <view class="keypad__row">
          <view class="keypad__key" data-key="7" bindtap="onEditAmountKey"><text>7</text></view>
          <view class="keypad__key" data-key="8" bindtap="onEditAmountKey"><text>8</text></view>
          <view class="keypad__key" data-key="9" bindtap="onEditAmountKey"><text>9</text></view>
          <view class="keypad__key keypad__key--fn keypad__key--op" data-key="-" bindtap="onEditAmountKey"><text>-</text></view>
        </view>
        <!-- 第 5 行：. 0 ⌫ 保存/= -->
        <view class="keypad__row">
          <view class="keypad__key" data-key="." bindtap="onEditAmountKey"><text>.</text></view>
          <view class="keypad__key" data-key="0" bindtap="onEditAmountKey"><text>0</text></view>
          <view class="keypad__key keypad__key--fn keypad__key--backspace" data-key="backspace" bindtap="onEditAmountKey" aria-label="删除">
            <view class="ic-backspace"></view>
          </view>
          <view
            class="keypad__key keypad__key--action {{editAmountCalc.actionState === 'done' ? 'keypad__key--done' : 'keypad__key--equals'}}"
            data-key="done"
            bindtap="onEditAmountKey"
          >
            <text>{{editAmountCalc.actionState === 'done' ? '保存' : '='}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- ═══ 长按上下文菜单（原地弹出于触点附近） ═══ -->
  <view
    wx:if="{{ctxMenuVisible}}"
    class="ctx-menu-overlay"
    catchtap="onCtxMenuClose"
    catchtouchmove="noop"
  >
    <view
      class="ctx-menu"
      style="top: {{ctxMenuTop}}px; left: {{ctxMenuLeft}}px;"
      catchtap="noop"
    >
      <view class="ctx-menu__item" catchtap="onCtxCopy">
        <view class="ctx-ic ctx-ic--copy"><view></view><view></view></view>
        <text class="ctx-menu__text">复制流水</text>
      </view>
      <view class="ctx-menu__item" catchtap="onCtxNote">
        <view class="ctx-ic ctx-ic--note"><view></view><view></view></view>
        <text class="ctx-menu__text">修改备注</text>
      </view>
      <view class="ctx-menu__item" catchtap="onCtxAmount">
        <view class="ctx-ic ctx-ic--amount"><text>¥</text></view>
        <text class="ctx-menu__text">修改金额</text>
      </view>
      <view class="ctx-menu__item" catchtap="onCtxCategory">
        <view class="ctx-ic ctx-ic--grid"><view></view><view></view><view></view><view></view></view>
        <text class="ctx-menu__text">修改分类</text>
      </view>
      <view class="ctx-menu__item ctx-menu__item--danger" catchtap="onCtxDelete">
        <view class="ctx-ic ctx-ic--trash"><view class="lid"></view><view class="can"></view></view>
        <text class="ctx-menu__text">删除流水</text>
      </view>
    </view>
  </view>

  <!-- ═══ COSTRA-4xx: 资产修改弹窗（居中弹窗） ═══ -->
  <!-- wx:if 控制渲染：避免 input 原生组件在 opacity:0+visibility:hidden 父容器下
       仍把 value 文本绘制到屏幕上（小程序原生 input 与 CSS 隐藏的已知兼容性问题） -->
  <view class="quickedit-mask {{editAssetVisible ? 'is-visible' : ''}}" wx:if="{{editAssetVisible}}" bindtap="onCloseEditAsset"></view>
  <view class="quickedit-sheet {{editAssetVisible ? 'is-visible' : ''}}" wx:if="{{editAssetVisible}}">
    <view class="quickedit-header">
      <text class="quickedit-header__title">修改资产</text>
    </view>
    <view class="quickedit-amount">
      <text class="quickedit-amount__prefix">¥</text>
      <input
        class="quickedit-amount__input tnum"
        type="digit"
        value="{{editAssetDisplay}}"
        focus="{{editAssetVisible}}"
        adjust-position="{{false}}"
        bindinput="onEditAssetInput"
        bindconfirm="onConfirmEditAssetInput"
        maxlength="14"
        placeholder="0"
      />
    </view>
    <view class="quickedit-hint">
      <text>新流水操作将叠加到修改后的资产上</text>
    </view>
    <view class="quickedit-actions">
      <view class="quickedit-actions__btn quickedit-actions__btn--cancel" bindtap="onCloseEditAsset">取消</view>
      <view class="quickedit-actions__btn quickedit-actions__btn--confirm" bindtap="onConfirmEditAssetInput">确认</view>
    </view>
  </view>

  <!-- ═══ COSTRA-4xx: 预算修改弹窗（居中弹窗） ═══ -->
  <view class="quickedit-mask {{editBudgetVisible ? 'is-visible' : ''}}" wx:if="{{editBudgetVisible}}" bindtap="onCloseEditBudget"></view>
  <view class="quickedit-sheet {{editBudgetVisible ? 'is-visible' : ''}}" wx:if="{{editBudgetVisible}}">
    <view class="quickedit-header">
      <text class="quickedit-header__title">设置当月预算上限</text>
    </view>
    <view class="quickedit-amount">
      <text class="quickedit-amount__prefix">¥</text>
      <input
        class="quickedit-amount__input tnum"
        type="digit"
        value="{{editBudgetDisplay}}"
        focus="{{editBudgetVisible}}"
        adjust-position="{{false}}"
        bindinput="onEditBudgetInput"
        bindconfirm="onConfirmEditBudgetInput"
        maxlength="14"
        placeholder="0"
      />
    </view>
    <view class="quickedit-hint">
      <text>预算余额 = 预算上限 - 当月支出</text>
      <text class="quickedit-hint__sub">设置 0 意为无预算上限</text>
    </view>
    <view class="quickedit-actions">
      <view class="quickedit-actions__btn quickedit-actions__btn--cancel" bindtap="onCloseEditBudget">取消</view>
      <view class="quickedit-actions__btn quickedit-actions__btn--confirm" bindtap="onConfirmEditBudgetInput">确认</view>
    </view>
  </view>

  <!-- 记账覆盖层 -->
  <expense-overlay id="expense-overlay" />
</view>

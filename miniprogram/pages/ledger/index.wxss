/* pages/ledger/index.wxss · 明细页 */
/* 卡号: COSTRA-203 · 设计源: design/ui/design_spec.md §6.2 */
/* 色值对齐 tokens/index.ts v2.0.0 + app.wxss CSS 变量 */

/* ---- 页面容器 ---- */
.ledger {
  height: 100vh;
  background: var(--color-role-bg-app, #f1f2ec);
  display: flex;
  flex-direction: column;
}

/* ---- 自定义导航栏 ---- */
/* 导航栏样式已迁入 <ledger-switcher> 组件 */

/* ---- 头部汇总区 ---- */
.header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding-left: 32rpx;
  padding-right: 32rpx;
  padding-bottom: 24rpx;
}

.header__left {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  flex: 1;
  min-width: 0;
}

.header__total-expense {
  font-size: 80rpx;
  font-weight: 600;
  line-height: 1.07;
  letter-spacing: -2rpx;
  color: var(--color-role-amount-expense, #1c1b1a);
  font-variant-numeric: tabular-nums;
  font-feature-settings: "tnum";
  word-break: break-all;
}

.header__sub {
  font-size: 28rpx;
  line-height: 1.5;
  color: var(--color-role-text-secondary, rgba(28,27,26,0.48));
  font-variant-numeric: tabular-nums;
  font-feature-settings: "tnum";
}

/* ---- COSTRA-4xx · 第 3 行：资产 + 预算 ---- */
.header__asset-budget {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-top: 4rpx;
}

.header__asset,
.header__budget {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}

/* 资产/预算与上一行「收入/结余」使用同字号同色：28rpx / secondary，保持视觉一致 */
.header__asset-label,
.header__budget-label {
  font-size: 28rpx;
  color: var(--color-role-text-secondary, rgba(28,27,26,0.48));
  line-height: 1.5;
}

.header__asset-value {
  font-size: 28rpx;
  color: var(--color-role-text-secondary, rgba(28,27,26,0.48));
  line-height: 1.5;
  font-variant-numeric: tabular-nums;
  font-feature-settings: "tnum";
}

/* ✎ 编辑图标：unicode 字符 ✎（U+270E）+ 水平翻转，
   使笔尖朝左下、笔尾朝右上。资产/预算共用，暗示可点击修改。 */
.header__edit-icon {
  font-size: 24rpx;
  line-height: 1;
  margin-left: 4rpx;
  transform: scaleX(-1);
  display: inline-block;
}
.header__asset,
.header__budget {
  color: var(--color-role-text-secondary, rgba(28,27,26,0.48));
}

/* 预算剩余数值莫兰迪 4 段色阶 */
.header__budget-remain {
  font-size: 28rpx;
  line-height: 1.5;
  font-variant-numeric: tabular-nums;
  font-feature-settings: "tnum";
}
.header__budget-remain.is-safe { color: #8AA689; }   /* 莫兰迪绿灰 · p ≥ 50% */
.header__budget-remain.is-hint { color: #C4B58D; }   /* 莫兰迪米黄 · 20~50% */
.header__budget-remain.is-warn { color: #C39A80; }   /* 莫兰迪陶土 · 0~20% */
.header__budget-remain.is-over { color: #A87878; }    /* 莫兰迪暗玫瑰 · ≤ 0 */

.header__budget-sep {
  font-size: 28rpx;
  color: var(--color-role-text-secondary, rgba(28,27,26,0.48));
  margin: 0 2rpx;
}
.header__budget-total {
  font-size: 28rpx;
  color: var(--color-role-text-secondary, rgba(28,27,26,0.48));
  line-height: 1.5;
  font-variant-numeric: tabular-nums;
  font-feature-settings: "tnum";
}
.header__budget-unset {
  font-size: 28rpx;
  color: var(--color-role-text-secondary, rgba(28,27,26,0.48));
  text-decoration: underline;
  text-underline-offset: 4rpx;
}

/* 资产/预算编辑键盘的提示行（共用 .keypad-sheet 已有样式） */
.keypad-sheet__hint {
  text-align: center;
  font-size: 24rpx;
  color: var(--color-role-text-tertiary, rgba(28,27,26,0.28));
  padding: 4rpx 0 16rpx;
}

/* 空白键位（资产/预算键盘行尾留白） */
.keypad__key--placeholder {
  background: transparent;
  pointer-events: none;
}

/* ---- 时间导航 + 筛选行 ---- */
.filter-row {
  position: relative;
  z-index: 20;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 32rpx 16rpx;
  background: var(--color-role-bg-app, #f1f2ec);
}

.filter-row__left {
  display: flex;
  align-items: center;
}

.filter-row__month {
  display: flex;
  align-items: center;
  padding: 0 8rpx;
}

.filter-row__month-text {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-role-text-primary, #1c1b1a);
}

.filter-row__dropdown {
  font-size: 18rpx;
  margin-left: 6rpx;
  color: var(--color-role-text-tertiary, rgba(28,27,26,0.28));
}

.filter-row__right {
  display: flex;
  align-items: center;
  gap: 4rpx;
  padding: 8rpx 16rpx;
  border-radius: var(--radius-pill, 9999rpx);
  background: rgba(28, 27, 26, 0.04);
  transition: all 180ms ease;
}

.filter-row__right.is-active {
  background: #07C160;
}

.filter-row__member-text {
  font-size: 24rpx;
  color: var(--color-role-text-primary, #1c1b1a);
  font-weight: 500;
  transition: color 180ms ease;
}

.filter-row__right.is-active .filter-row__member-text {
  color: #ffffff;
}

.filter-row__member-arrow {
  font-size: 16rpx;
  color: var(--color-role-text-secondary, rgba(28,27,26,0.48));
  transition: transform 280ms ease, color 180ms ease;
}

.filter-row__member-arrow.is-rotated {
  transform: rotate(180deg);
}

.filter-row__right.is-active .filter-row__member-arrow {
  color: rgba(255, 255, 255, 0.7);
}

/* ─── 列表容器（筛选面板的定位参照） ─── */
.list-container {
  position: relative;
  z-index: 0;
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

/* ---- 流水列表 ---- */
.entry-list {
  flex: 1;
  /* flex item 默认 min-height:auto 会被内容撑高导致整页原生滚动，
     置 0 使 scroll-view 收缩到剩余空间内、改为列表内部滚动，
     从而固定住上方汇总区 + 月份/筛选行 */
  min-height: 0;
  /* 底部留白由 JS 统一注入：固定 TabBar 空间 + 底部视觉安全区 */
}

/* ---- 日期分组头（sticky 吸顶） ---- */
.date-header {
  position: sticky;
  top: 0;
  z-index: 10;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 32rpx;
  background: #f1f2ec;
}

.date-header__label {
  font-size: 24rpx;
  font-weight: 500;
  color: var(--color-role-text-secondary, rgba(28,27,26,0.48));
}

.date-header__summary {
  font-size: 22rpx;
  color: var(--color-role-text-tertiary, rgba(28,27,26,0.28));
  font-variant-numeric: tabular-nums;
  font-feature-settings: "tnum";
}

/* ---- 条目行 ---- */
.entry-item-wrap {
  position: relative;
  overflow: hidden;
}

.entry-item {
  display: flex;
  align-items: center;
  padding: 18rpx 32rpx;
  transition: transform 150ms cubic-bezier(0.25, 0.1, 0.25, 1), background-color 160ms ease;
  background: var(--color-role-bg-app, #f1f2ec);
  position: relative;
  z-index: 2;
  gap: 12rpx;
}

/* 长按上下文菜单打开时，目标流水泛起暖光弱提醒（满宽，无卡片，贴合明细列表无卡片设计） */
.entry-item--ctx-active {
  background: #faf9f5;
}

.entry-icon {
  position: relative;
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: rgba(28, 27, 26, 0.06);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.entry-icon__text {
  font-family: "costra-icons";
  font-size: 34rpx;
  line-height: 1;
  color: var(--color-role-text-primary, #1c1b1a);
  line-height: 1;
}

/* ---- 成员头像（协作账本 · 金额左侧） ---- */
.entry-member {
  position: relative;
  width: 48rpx;
  height: 48rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.entry-member__avatar {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
}

.entry-member__fallback {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: rgba(28, 27, 26, 0.08);
  display: flex;
  align-items: center;
  justify-content: center;
}

.entry-member__initial {
  font-size: 20rpx;
  color: var(--color-role-text-secondary, rgba(28,27,26,0.48));
  font-weight: 500;
  line-height: 1;
}

/**
 * 公共支出角标 · 仅文字浮于头像右下，不带背景/底圆，避免遮挡头像。
 * 用 text-shadow 八向投影做外描边（仅向外扩展，不侵蚀字芯），
 * 保证小字号下绿色字芯依然饱满可读。
 */
.entry-member__badge {
  position: absolute;
  right: -6rpx;
  bottom: -6rpx;
  display: flex;
  align-items: center;
  gap: 2rpx;
  line-height: 1;
  pointer-events: none;
  white-space: nowrap;
}

.entry-member__badge-text {
  font-size: 18rpx;
  line-height: 1;
  font-weight: 800;
  text-shadow:
    1rpx 0 0 var(--color-role-bg-app, #f1f2ec),
    -1rpx 0 0 var(--color-role-bg-app, #f1f2ec),
    0 1rpx 0 var(--color-role-bg-app, #f1f2ec),
    0 -1rpx 0 var(--color-role-bg-app, #f1f2ec),
    1rpx 1rpx 0 var(--color-role-bg-app, #f1f2ec),
    -1rpx -1rpx 0 var(--color-role-bg-app, #f1f2ec),
    1rpx -1rpx 0 var(--color-role-bg-app, #f1f2ec),
    -1rpx 1rpx 0 var(--color-role-bg-app, #f1f2ec);
}

.entry-member__badge-text--recurring {
  color: #A88A5E;
}

.entry-member__badge-text--shared {
  color: #6B9B8F;
}

.entry-label {
  height: 48rpx;
  overflow: hidden;
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
}

.entry-label__text {
  display: block;
  font-size: 28rpx;
  line-height: 28rpx;
  color: var(--color-role-text-primary, #1c1b1a);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.entry-amount {
  display: block;
  height: 48rpx;
  font-size: 32rpx;
  line-height: 48rpx;
  font-weight: 500;
  color: var(--color-role-amount-expense, #1c1b1a);
  font-variant-numeric: tabular-nums;
  font-feature-settings: "tnum";
  flex-shrink: 0;
}

.entry-amount--income {
  color: var(--color-role-amount-income, #07C160);
}

.entry-amount--transfer {
  color: var(--color-text-placeholder, #b0b0b0);
}

.entry-delete {
  position: absolute;
  right: 0;
  top: 0;
  bottom: 0;
  width: 160rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-semantic-danger, #FA5151);
  z-index: 1;
}

.entry-delete__text {
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 500;
}

.ledger-loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 96rpx 32rpx 32rpx;
  gap: 20rpx;
}

.ledger-loading-state__spinner {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(28, 27, 26, 0.08);
  border-top-color: rgba(28, 27, 26, 0.36);
  animation: ledger-spin 900ms linear infinite;
}

.ledger-loading-state__text {
  font-size: 26rpx;
  color: var(--color-role-text-secondary, rgba(28,27,26,0.48));
}

.ledger-skeleton {
  width: 100%;
  margin-top: 16rpx;
}

.ledger-skeleton__row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 0;
}

.ledger-skeleton__icon,
.ledger-skeleton__line,
.ledger-skeleton__amount {
  background: rgba(28, 27, 26, 0.06);
  overflow: hidden;
  position: relative;
}

.ledger-skeleton__icon::after,
.ledger-skeleton__line::after,
.ledger-skeleton__amount::after {
  content: '';
  position: absolute;
  inset: 0;
  transform: translateX(-100%);
  background: linear-gradient(90deg, transparent, rgba(255,255,255,0.45), transparent);
  animation: ledger-shimmer 1400ms ease-in-out infinite;
}

.ledger-skeleton__icon {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.ledger-skeleton__content {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.ledger-skeleton__line {
  height: 24rpx;
  border-radius: 999rpx;
}

.ledger-skeleton__line--main {
  width: 56%;
}

.ledger-skeleton__line--sub {
  width: 34%;
  opacity: 0.72;
}

.ledger-skeleton__amount {
  width: 116rpx;
  height: 28rpx;
  border-radius: 999rpx;
  flex-shrink: 0;
}

.ledger-partial-hint {
  margin: 12rpx 32rpx 8rpx;
  padding: 12rpx 20rpx;
  border-radius: var(--radius-card, 24rpx);
  background: rgba(28, 27, 26, 0.04);
  color: var(--color-role-text-secondary, rgba(28,27,26,0.48));
  font-size: 24rpx;
}

@keyframes ledger-spin {
  to { transform: rotate(360deg); }
}

@keyframes ledger-shimmer {
  100% { transform: translateX(100%); }
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 96rpx 48rpx 0;
  gap: 16rpx;
}

.empty-state__title {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--color-role-text-secondary, rgba(28,27,26,0.48));
}

.empty-state__hint {
  font-size: 26rpx;
  color: var(--color-role-text-tertiary, rgba(28,27,26,0.28));
  text-align: center;
}

.empty-state--failed .empty-state__title {
  color: var(--color-role-text-primary, #1c1b1a);
}

.empty-state__retry {
  margin-top: 16rpx;
  min-width: 160rpx;
  height: 64rpx;
  line-height: 64rpx;
  border-radius: var(--radius-pill, 9999rpx);
  background: #1c1b1a;
  color: #ffffff;
  font-size: 26rpx;
  padding: 0 32rpx;
}

.empty-state__retry::after {
  border: none;
}

/* ─── COSTRA-227: 金额包装层（用于点击区域扩大） ─── */
.entry-amount-wrap {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  padding: 8rpx 0 8rpx 16rpx;
}

/* ─── COSTRA-227: inline 备注输入 ─── */
.entry-label__input {
  font-size: 28rpx;
  color: #1c1b1a;
  width: 100%;
  height: 48rpx;
  line-height: 48rpx;
}

/* ─── COSTRA-227: 全屏分类选择面板 ─── */
.edit-category-overlay {
  position: fixed;
  inset: 0;
  z-index: 9999;
  background: var(--color-role-bg-app, #f1f2ec);
  transform: translateY(100%);
  transition: transform 350ms cubic-bezier(0.25, 0.1, 0.25, 1);
}
.edit-category-overlay.is-visible {
  transform: translateY(0);
}
.edit-category-shell {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: var(--color-role-bg-app, #f1f2ec);
}
.edit-category-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-shrink: 0;
  padding: 0 32rpx 16rpx;
}
.edit-category-header__close {
  color: rgba(28, 27, 26, 0.48);
  font-size: 28rpx;
  padding: 12rpx 8rpx;
}
.edit-category-header__tabs {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
}
/* COSTRA-228: tab 改为 column flex 承载文字 + 短线指示器（对齐 expense-overlay） */
.edit-category-header__tab {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 4rpx 0;
}
.edit-category-header__tab-text {
  font-size: 34rpx;
  color: rgba(28, 27, 26, 0.28);
  font-weight: 400;
  line-height: 1;
  transition: color 150ms cubic-bezier(0.25, 0.1, 0.25, 1),
              font-weight 150ms cubic-bezier(0.25, 0.1, 0.25, 1);
}
.edit-category-header__tab.is-active .edit-category-header__tab-text {
  color: #1c1b1a;
  font-weight: 600;
}
/* 黑色短线指示器：绝对定位悬挂在 tab 文字下方 */
.edit-category-header__tab-indicator {
  position: absolute;
  left: 50%;
  bottom: -12rpx;
  transform: translateX(-50%);
  width: 24rpx;
  height: 4rpx;
  border-radius: 2rpx;
  background: transparent;
  transition: background 200ms cubic-bezier(0.25, 0.1, 0.25, 1);
}
.edit-category-header__tab.is-active .edit-category-header__tab-indicator {
  background: #1c1b1a;
}
.edit-category-header__sep {
  font-size: 28rpx;
  color: rgba(28, 27, 26, 0.2);
}
.edit-category-header__placeholder {
  width: 80rpx;
}
/* COSTRA-228: 分类区 swiper（跟手横滑切换支出/收入） */
.edit-category-swiper {
  flex: 1;
  min-height: 0;
  width: 100%;
}
.edit-category-scroll {
  height: 100%;
  width: 100%;
  box-sizing: border-box;
  padding: 0 28rpx;
}

/* 分类网格（公共样式 · COSTRA-227 抽取） */
@import '../../styles/category-grid.wxss';

/* ─── COSTRA-227: 金额编辑半屏底部面板 ─── */

/* 键盘公共样式 */
@import '../../styles/keypad.wxss';

.edit-amount-panel {
  position: fixed;
  inset: 0;
  z-index: 9999;
  pointer-events: none;
  opacity: 0;
  transition: opacity 200ms;
}
.edit-amount-panel.is-visible {
  pointer-events: auto;
  opacity: 1;
}
.edit-amount-panel__mask {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background: transparent;
}
.edit-amount-panel__sheet {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: #ffffff;
  border-top-left-radius: 24rpx;
  border-top-right-radius: 24rpx;
  transform: translateY(100%);
  transition: transform 250ms cubic-bezier(0.25, 0.1, 0.25, 1);
}
.edit-amount-panel.is-visible .edit-amount-panel__sheet {
  transform: translateY(0);
}

/* 费用性质开关样式已移至 styles/keypad.wxss，此处无需重复定义 */

/* 长按上下文菜单共享样式（与定时记账页共用同一套设计） */
@import '../../styles/ctx-menu.wxss';

/* ─── COSTRA-4xx: 资产/预算快速编辑弹窗（系统数字键盘 · 键盘高度驱动避让） ─── */
/* 关键：不用 position:fixed 半屏面板承载 input，而用「全屏遮罩 + 贴底 sheet」，
   sheet 由 bindkeyboardheightchange 驱动 inline transform 上移（expense-overlay 同构），
   彻底规避 fixed 定位被系统键盘挤压错位（数字/按钮被挤到左上角）的问题。 */

/* 全屏遮罩：点遮罩 = 取消，保证修改需用户明确确认/取消 */
.quickedit-mask {
  position: fixed;
  inset: 0;
  z-index: 9998;
  background: rgba(28, 27, 26, 0.4);
  opacity: 0;
  visibility: hidden;
  pointer-events: none;
  transition: opacity 200ms ease;
}
.quickedit-mask.is-visible {
  opacity: 1;
  visibility: visible;
  pointer-events: auto;
}

/* 贴底 sheet：transform 完全由 inline style（editAssetOffsetY）驱动键盘避让；
   显隐仅靠 opacity/visibility，位移只随键盘高度变化，避免 CSS/内联 transform 抢占冲突 */
.quickedit-sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 9999;
  background: #ffffff;
  border-top-left-radius: 24rpx;
  border-top-right-radius: 24rpx;
  opacity: 0;
  visibility: hidden;
  pointer-events: none;
  transition-property: transform, opacity;
  transition-timing-function: cubic-bezier(0.25, 0.1, 0.25, 1);
}
.quickedit-sheet.is-visible {
  opacity: 1;
  visibility: visible;
  pointer-events: auto;
}

/* 视觉参考 pages-recurring/edit 的金额输入区 · 顶部取消/标题/保存 三段式 */
.quickedit-nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 32rpx 16rpx;
}
.quickedit-nav__title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1c1b1a;
}
.quickedit-nav__btn {
  font-size: 28rpx;
  color: rgba(28, 27, 26, 0.48);
  padding: 8rpx 0;
  min-width: 80rpx;
  transition: opacity 120ms ease;
}
.quickedit-nav__btn:active {
  opacity: 0.6;
}
.quickedit-nav__btn--primary {
  color: #1c1b1a;
  font-weight: 600;
  text-align: right;
}

/* 金额输入区（与 recedit__amount-input 同视觉） */
.quickedit-amount {
  display: flex;
  align-items: baseline;
  justify-content: center;
  padding: 24rpx 32rpx 16rpx;
  min-height: 80rpx;
}
.quickedit-amount__prefix {
  font-size: 32rpx;
  font-weight: 600;
  color: #1c1b1a;
  margin-right: 8rpx;
}
.quickedit-amount__input {
  flex: 1;
  min-width: 0;
  font-size: 48rpx;
  font-weight: 600;
  color: #1c1b1a;
  text-align: left;
  caret-color: #1c1b1a;
  line-height: 1.2;
  letter-spacing: -1rpx;
}

.quickedit-hint {
  text-align: center;
  font-size: 24rpx;
  color: var(--color-role-text-tertiary, rgba(28, 27, 26, 0.28));
  padding: 4rpx 32rpx 24rpx;
}


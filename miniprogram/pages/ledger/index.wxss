/* pages/ledger/index.wxss · 明细页 */
/* 卡号: COSTRA-203 · 设计源: design/ui/design_spec.md §6.2 */
/* 色值对齐 tokens/index.ts v2.0.0 + app.wxss CSS 变量 */

/* ---- 页面容器 ---- */
.ledger {
  min-height: 100vh;
  background: var(--color-role-bg-app, #f1f2ec);
  display: flex;
  flex-direction: column;
}

/* ---- 自定义导航栏 ---- */
.nav-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background: rgba(241, 242, 236, 0.92);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
}

@supports not (backdrop-filter: blur(1px)) {
  .nav-bar {
    background: #f1f2ec;
  }
}

.nav-bar__content {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 32rpx;
}

.nav-bar__center {
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.nav-bar__title {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--color-role-text-primary, #1c1b1a);
  line-height: 1.2;
}

.nav-bar__arrow {
  font-size: 18rpx;
  color: var(--color-role-text-secondary, rgba(28,27,26,0.48));
}

/* ---- 头部汇总区 ---- */
.header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding-left: 32rpx;
  padding-right: 32rpx;
  padding-bottom: 24rpx;
}

.header__left {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  flex: 1;
  min-width: 0;
}

.header__total-expense {
  font-size: 80rpx;
  font-weight: 600;
  line-height: 1.07;
  letter-spacing: -2rpx;
  color: var(--color-role-amount-expense, #1c1b1a);
  font-variant-numeric: tabular-nums;
  font-feature-settings: "tnum";
  word-break: break-all;
}

.header__sub {
  font-size: 28rpx;
  line-height: 1.5;
  color: var(--color-role-text-secondary, rgba(28,27,26,0.48));
  font-variant-numeric: tabular-nums;
  font-feature-settings: "tnum";
}

/* ---- 时间导航 + 筛选行 ---- */
.filter-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 32rpx 16rpx;
}

.filter-row__left {
  display: flex;
  align-items: center;
}

.filter-row__arrow {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.filter-row__arrow-icon {
  font-size: 32rpx;
  color: var(--color-role-text-secondary, rgba(28,27,26,0.48));
  font-weight: 300;
}

.filter-row__month {
  display: flex;
  align-items: center;
  padding: 0 8rpx;
}

.filter-row__month-text {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-role-text-primary, #1c1b1a);
}

.filter-row__dropdown {
  font-size: 16rpx;
  margin-left: 6rpx;
  color: var(--color-role-text-tertiary, rgba(28,27,26,0.28));
}

.filter-row__right {
  display: flex;
  align-items: center;
  gap: 4rpx;
  padding: 8rpx 16rpx;
  border-radius: var(--radius-pill, 9999rpx);
  background: rgba(28, 27, 26, 0.04);
}

.filter-row__member-text {
  font-size: 24rpx;
  color: var(--color-role-text-primary, #1c1b1a);
  font-weight: 500;
}

.filter-row__member-arrow {
  font-size: 16rpx;
  color: var(--color-role-text-secondary, rgba(28,27,26,0.48));
}

/* ---- 流水列表 ---- */
.entry-list {
  flex: 1;
  padding-bottom: calc(env(safe-area-inset-bottom) + 120rpx);
}

/* ---- 日期分组头（sticky 吸顶） ---- */
.date-header {
  position: sticky;
  top: 0;
  z-index: 10;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 32rpx;
  background: rgba(241, 242, 236, 0.95);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
}

@supports not (backdrop-filter: blur(1px)) {
  .date-header {
    background: #f1f2ec;
  }
}

.date-header__label {
  font-size: 24rpx;
  font-weight: 500;
  color: var(--color-role-text-secondary, rgba(28,27,26,0.48));
}

.date-header__summary {
  font-size: 22rpx;
  color: var(--color-role-text-tertiary, rgba(28,27,26,0.28));
  font-variant-numeric: tabular-nums;
  font-feature-settings: "tnum";
}

/* ---- 条目行 ---- */
.entry-item-wrap {
  position: relative;
  overflow: hidden;
}

.entry-item {
  display: flex;
  align-items: center;
  padding: 18rpx 32rpx;
  transition: transform 150ms cubic-bezier(0.25, 0.1, 0.25, 1);
  background: var(--color-role-bg-app, #f1f2ec);
  position: relative;
  z-index: 2;
  gap: 12rpx;
}

.entry-icon {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: rgba(28, 27, 26, 0.06);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.entry-icon__text {
  font-size: 22rpx;
  color: var(--color-role-text-primary, #1c1b1a);
  font-weight: 500;
  line-height: 1;
}

.entry-avatar {
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.entry-label {
  height: 48rpx;
  overflow: hidden;
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
}

.entry-label__text {
  display: block;
  font-size: 28rpx;
  line-height: 28rpx;
  color: var(--color-role-text-primary, #1c1b1a);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.entry-amount {
  display: block;
  height: 48rpx;
  font-size: 32rpx;
  line-height: 48rpx;
  font-weight: 500;
  color: var(--color-role-amount-expense, #1c1b1a);
  font-variant-numeric: tabular-nums;
  font-feature-settings: "tnum";
  flex-shrink: 0;
}

.entry-amount--income {
  color: var(--color-role-amount-income, #07C160);
}

.entry-delete {
  position: absolute;
  right: 0;
  top: 0;
  bottom: 0;
  width: 160rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-semantic-danger, #FA5151);
  z-index: 1;
}

.entry-delete__text {
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 500;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 200rpx;
  gap: 16rpx;
}

.empty-state__title {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--color-role-text-secondary, rgba(28,27,26,0.48));
}

.empty-state__hint {
  font-size: 26rpx;
  color: var(--color-role-text-tertiary, rgba(28,27,26,0.28));
}

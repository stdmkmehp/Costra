/* pages/ledger/index.wxss · 明细页 */
/* 卡号: COSTRA-203 · 设计源: design/ui/design_spec.md §6.2 */
/* 色值对齐 tokens/index.ts v2.0.0 + app.wxss CSS 变量 */

/* ---- 页面容器 ---- */
.ledger {
  height: 100vh;
  background: var(--color-role-bg-app, #f1f2ec);
  display: flex;
  flex-direction: column;
}

/* ---- 自定义导航栏 ---- */
.nav-bar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 100;
  background: rgba(241, 242, 236, 0.92);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
}

@supports not (backdrop-filter: blur(1px)) {
  .nav-bar {
    background: #f1f2ec;
  }
}

.nav-bar__content {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 32rpx;
}

.nav-bar__center {
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.nav-bar__title {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--color-role-text-primary, #1c1b1a);
  line-height: 1.2;
}

.nav-bar__arrow {
  font-size: 20rpx;
  color: var(--color-role-text-tertiary, rgba(28,27,26,0.28));
}

/* ---- 头部汇总区 ---- */
.header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding-left: 32rpx;
  padding-right: 32rpx;
  padding-bottom: 24rpx;
}

.header__left {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  flex: 1;
  min-width: 0;
}

.header__total-expense {
  font-size: 80rpx;
  font-weight: 600;
  line-height: 1.07;
  letter-spacing: -2rpx;
  color: var(--color-role-amount-expense, #1c1b1a);
  font-variant-numeric: tabular-nums;
  font-feature-settings: "tnum";
  word-break: break-all;
}

.header__sub {
  font-size: 28rpx;
  line-height: 1.5;
  color: var(--color-role-text-secondary, rgba(28,27,26,0.48));
  font-variant-numeric: tabular-nums;
  font-feature-settings: "tnum";
}

/* ---- 时间导航 + 筛选行 ---- */
.filter-row {
  position: relative;
  z-index: 20;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 32rpx 16rpx;
  background: var(--color-role-bg-app, #f1f2ec);
}

.filter-row__left {
  display: flex;
  align-items: center;
}

.filter-row__arrow {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.filter-row__arrow-icon {
  font-size: 36rpx;
  color: var(--color-role-text-secondary, rgba(28,27,26,0.38));
  font-weight: 500;
}

.filter-row__month {
  display: flex;
  align-items: center;
  padding: 0 8rpx;
}

.filter-row__month-text {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-role-text-primary, #1c1b1a);
}

.filter-row__dropdown {
  font-size: 18rpx;
  margin-left: 6rpx;
  color: var(--color-role-text-tertiary, rgba(28,27,26,0.28));
}

.filter-row__right {
  display: flex;
  align-items: center;
  gap: 4rpx;
  padding: 8rpx 16rpx;
  border-radius: var(--radius-pill, 9999rpx);
  background: rgba(28, 27, 26, 0.04);
  transition: all 180ms ease;
}

.filter-row__right.is-active {
  background: #07C160;
}

.filter-row__member-text {
  font-size: 24rpx;
  color: var(--color-role-text-primary, #1c1b1a);
  font-weight: 500;
  transition: color 180ms ease;
}

.filter-row__right.is-active .filter-row__member-text {
  color: #ffffff;
}

.filter-row__member-arrow {
  font-size: 16rpx;
  color: var(--color-role-text-secondary, rgba(28,27,26,0.48));
  transition: transform 280ms ease, color 180ms ease;
}

.filter-row__member-arrow.is-rotated {
  transform: rotate(180deg);
}

.filter-row__right.is-active .filter-row__member-arrow {
  color: rgba(255, 255, 255, 0.7);
}

/* ─── 列表容器（筛选面板的定位参照） ─── */
.list-container {
  position: relative;
  z-index: 0;
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

/* ---- 流水列表 ---- */
.entry-list {
  flex: 1;
  /* flex item 默认 min-height:auto 会被内容撑高导致整页原生滚动，
     置 0 使 scroll-view 收缩到剩余空间内、改为列表内部滚动，
     从而固定住上方汇总区 + 月份/筛选行 */
  min-height: 0;
  padding-bottom: calc(env(safe-area-inset-bottom) + 120rpx);
}

/* ---- 日期分组头（sticky 吸顶） ---- */
.date-header {
  position: sticky;
  top: 0;
  z-index: 10;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 32rpx;
  background: #f1f2ec;
}

.date-header__label {
  font-size: 24rpx;
  font-weight: 500;
  color: var(--color-role-text-secondary, rgba(28,27,26,0.48));
}

.date-header__summary {
  font-size: 22rpx;
  color: var(--color-role-text-tertiary, rgba(28,27,26,0.28));
  font-variant-numeric: tabular-nums;
  font-feature-settings: "tnum";
}

/* ---- 条目行 ---- */
.entry-item-wrap {
  position: relative;
  overflow: hidden;
}

.entry-item {
  display: flex;
  align-items: center;
  padding: 18rpx 32rpx;
  transition: transform 150ms cubic-bezier(0.25, 0.1, 0.25, 1), background-color 160ms ease;
  background: var(--color-role-bg-app, #f1f2ec);
  position: relative;
  z-index: 2;
  gap: 12rpx;
}

/* 长按上下文菜单打开时，目标流水泛起暖光弱提醒（满宽，无卡片，贴合明细列表无卡片设计） */
.entry-item--ctx-active {
  background: #faf9f5;
}

.entry-icon {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: rgba(28, 27, 26, 0.06);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.entry-icon__text {
  font-family: "costra-icons";
  font-size: 34rpx;
  line-height: 1;
  color: var(--color-role-text-primary, #1c1b1a);
  line-height: 1;
}

/* ---- 成员头像（协作账本 · 金额左侧） ---- */
.entry-member {
  position: relative;
  width: 48rpx;
  height: 48rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.entry-member__avatar {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
}

.entry-member__fallback {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: rgba(28, 27, 26, 0.08);
  display: flex;
  align-items: center;
  justify-content: center;
}

.entry-member__initial {
  font-size: 20rpx;
  color: var(--color-role-text-secondary, rgba(28,27,26,0.48));
  font-weight: 500;
  line-height: 1;
}

/**
 * 公共支出角标 · 仅文字浮于头像右下，不带背景/底圆，避免遮挡头像。
 * 用 text-shadow 八向投影做外描边（仅向外扩展，不侵蚀字芯），
 * 保证小字号下绿色字芯依然饱满可读。
 */
.entry-member__badge {
  position: absolute;
  right: -6rpx;
  bottom: -6rpx;
  line-height: 1;
  pointer-events: none;
}

.entry-member__badge-text {
  font-size: 18rpx;
  line-height: 1;
  font-weight: 800;
  color: #6B9B8F;
  text-shadow:
    1rpx 0 0 var(--color-role-bg-app, #f1f2ec),
    -1rpx 0 0 var(--color-role-bg-app, #f1f2ec),
    0 1rpx 0 var(--color-role-bg-app, #f1f2ec),
    0 -1rpx 0 var(--color-role-bg-app, #f1f2ec),
    1rpx 1rpx 0 var(--color-role-bg-app, #f1f2ec),
    -1rpx -1rpx 0 var(--color-role-bg-app, #f1f2ec),
    1rpx -1rpx 0 var(--color-role-bg-app, #f1f2ec),
    -1rpx 1rpx 0 var(--color-role-bg-app, #f1f2ec);
}

.entry-label {
  height: 48rpx;
  overflow: hidden;
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
}

.entry-label__text {
  display: block;
  font-size: 28rpx;
  line-height: 28rpx;
  color: var(--color-role-text-primary, #1c1b1a);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.entry-amount {
  display: block;
  height: 48rpx;
  font-size: 32rpx;
  line-height: 48rpx;
  font-weight: 500;
  color: var(--color-role-amount-expense, #1c1b1a);
  font-variant-numeric: tabular-nums;
  font-feature-settings: "tnum";
  flex-shrink: 0;
}

.entry-amount--income {
  color: var(--color-role-amount-income, #07C160);
}

.entry-amount--transfer {
  color: var(--color-text-placeholder, #b0b0b0);
}

.entry-delete {
  position: absolute;
  right: 0;
  top: 0;
  bottom: 0;
  width: 160rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-semantic-danger, #FA5151);
  z-index: 1;
}

.entry-delete__text {
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 500;
}

.ledger-loading-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 96rpx 32rpx 32rpx;
  gap: 20rpx;
}

.ledger-loading-state__spinner {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(28, 27, 26, 0.08);
  border-top-color: rgba(28, 27, 26, 0.36);
  animation: ledger-spin 900ms linear infinite;
}

.ledger-loading-state__text {
  font-size: 26rpx;
  color: var(--color-role-text-secondary, rgba(28,27,26,0.48));
}

.ledger-skeleton {
  width: 100%;
  margin-top: 16rpx;
}

.ledger-skeleton__row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 0;
}

.ledger-skeleton__icon,
.ledger-skeleton__line,
.ledger-skeleton__amount {
  background: rgba(28, 27, 26, 0.06);
  overflow: hidden;
  position: relative;
}

.ledger-skeleton__icon::after,
.ledger-skeleton__line::after,
.ledger-skeleton__amount::after {
  content: '';
  position: absolute;
  inset: 0;
  transform: translateX(-100%);
  background: linear-gradient(90deg, transparent, rgba(255,255,255,0.45), transparent);
  animation: ledger-shimmer 1400ms ease-in-out infinite;
}

.ledger-skeleton__icon {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.ledger-skeleton__content {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.ledger-skeleton__line {
  height: 24rpx;
  border-radius: 999rpx;
}

.ledger-skeleton__line--main {
  width: 56%;
}

.ledger-skeleton__line--sub {
  width: 34%;
  opacity: 0.72;
}

.ledger-skeleton__amount {
  width: 116rpx;
  height: 28rpx;
  border-radius: 999rpx;
  flex-shrink: 0;
}

.ledger-partial-hint {
  margin: 12rpx 32rpx 8rpx;
  padding: 12rpx 20rpx;
  border-radius: var(--radius-card, 24rpx);
  background: rgba(28, 27, 26, 0.04);
  color: var(--color-role-text-secondary, rgba(28,27,26,0.48));
  font-size: 24rpx;
}

@keyframes ledger-spin {
  to { transform: rotate(360deg); }
}

@keyframes ledger-shimmer {
  100% { transform: translateX(100%); }
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 200rpx 48rpx 0;
  gap: 16rpx;
}

.empty-state__title {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--color-role-text-secondary, rgba(28,27,26,0.48));
}

.empty-state__hint {
  font-size: 26rpx;
  color: var(--color-role-text-tertiary, rgba(28,27,26,0.28));
  text-align: center;
}

.empty-state--failed .empty-state__title {
  color: var(--color-role-text-primary, #1c1b1a);
}

.empty-state__retry {
  margin-top: 16rpx;
  min-width: 160rpx;
  height: 64rpx;
  line-height: 64rpx;
  border-radius: var(--radius-pill, 9999rpx);
  background: #1c1b1a;
  color: #ffffff;
  font-size: 26rpx;
  padding: 0 32rpx;
}

.empty-state__retry::after {
  border: none;
}

/* ─── COSTRA-227: 金额包装层（用于点击区域扩大） ─── */
.entry-amount-wrap {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  padding: 8rpx 0 8rpx 16rpx;
}

/* ─── COSTRA-227: inline 备注输入 ─── */
.entry-label__input {
  font-size: 28rpx;
  color: #1c1b1a;
  width: 100%;
  height: 48rpx;
  line-height: 48rpx;
}

/* ─── COSTRA-227: 全屏分类选择面板 ─── */
.edit-category-overlay {
  position: fixed;
  inset: 0;
  z-index: 9999;
  background: var(--color-role-bg-app, #f1f2ec);
  transform: translateY(100%);
  transition: transform 350ms cubic-bezier(0.25, 0.1, 0.25, 1);
}
.edit-category-overlay.is-visible {
  transform: translateY(0);
}
.edit-category-shell {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: var(--color-role-bg-app, #f1f2ec);
}
.edit-category-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-shrink: 0;
  padding: 0 32rpx 16rpx;
}
.edit-category-header__close {
  color: rgba(28, 27, 26, 0.48);
  font-size: 28rpx;
  padding: 12rpx 8rpx;
}
.edit-category-header__tabs {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
}
/* COSTRA-228: tab 改为 column flex 承载文字 + 短线指示器（对齐 expense-overlay） */
.edit-category-header__tab {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 4rpx 0;
}
.edit-category-header__tab-text {
  font-size: 34rpx;
  color: rgba(28, 27, 26, 0.28);
  font-weight: 400;
  line-height: 1;
  transition: color 150ms cubic-bezier(0.25, 0.1, 0.25, 1),
              font-weight 150ms cubic-bezier(0.25, 0.1, 0.25, 1);
}
.edit-category-header__tab.is-active .edit-category-header__tab-text {
  color: #1c1b1a;
  font-weight: 600;
}
/* 黑色短线指示器：绝对定位悬挂在 tab 文字下方 */
.edit-category-header__tab-indicator {
  position: absolute;
  left: 50%;
  bottom: -12rpx;
  transform: translateX(-50%);
  width: 24rpx;
  height: 4rpx;
  border-radius: 2rpx;
  background: transparent;
  transition: background 200ms cubic-bezier(0.25, 0.1, 0.25, 1);
}
.edit-category-header__tab.is-active .edit-category-header__tab-indicator {
  background: #1c1b1a;
}
.edit-category-header__sep {
  font-size: 28rpx;
  color: rgba(28, 27, 26, 0.2);
}
.edit-category-header__placeholder {
  width: 80rpx;
}
/* COSTRA-228: 分类区 swiper（跟手横滑切换支出/收入） */
.edit-category-swiper {
  flex: 1;
  min-height: 0;
  width: 100%;
}
.edit-category-scroll {
  height: 100%;
  width: 100%;
  box-sizing: border-box;
  padding: 0 28rpx;
}

/* 分类网格（公共样式 · COSTRA-227 抽取） */
@import '../../styles/category-grid.wxss';

/* ─── COSTRA-227: 金额编辑半屏底部面板 ─── */

/* 键盘公共样式 */
@import '../../styles/keypad.wxss';

.edit-amount-panel {
  position: fixed;
  inset: 0;
  z-index: 9999;
  pointer-events: none;
  opacity: 0;
  transition: opacity 200ms;
}
.edit-amount-panel.is-visible {
  pointer-events: auto;
  opacity: 1;
}
.edit-amount-panel__mask {
  position: absolute;
  top: 0; left: 0; right: 0; bottom: 0;
  background: transparent;
}
.edit-amount-panel__sheet {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: #ffffff;
  border-top-left-radius: 24rpx;
  border-top-right-radius: 24rpx;
  transform: translateY(100%);
  transition: transform 250ms cubic-bezier(0.25, 0.1, 0.25, 1);
}
.edit-amount-panel.is-visible .edit-amount-panel__sheet {
  transform: translateY(0);
}

/* 费用性质开关样式已移至 styles/keypad.wxss，此处无需重复定义 */

/* ─── 长按上下文菜单（原地弹出于触点附近） ─── */
/* 全屏透明遮罩：捕获点击关闭菜单，拦截滚动防穿透 */
.ctx-menu-overlay {
  position: fixed;
  inset: 0;
  z-index: 10000;
}

/* 菜单卡片：暖调浮起白 + 毛玻璃（与导航/Tab 材质语言统一，与 bone white 同色温）。
   top/left 由 JS 按触点动态计算（px），position:fixed 锚定视口。 */
.ctx-menu {
  position: fixed;
  width: 300rpx;
  background: rgba(250, 249, 245, 0.82);
  -webkit-backdrop-filter: blur(26rpx) saturate(180%);
  backdrop-filter: blur(26rpx) saturate(180%);
  border-radius: 30rpx;
  box-shadow: 0 10rpx 50rpx rgba(0, 0, 0, 0.16), 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
  padding: 8rpx 0;
  overflow: hidden;
  transform-origin: center top;
  animation: ctx-menu-in 180ms cubic-bezier(0.22, 1, 0.36, 1);
}

/* 不支持毛玻璃时回退为不透明暖白 */
@supports not (backdrop-filter: blur(1px)) {
  .ctx-menu { background: #faf9f5; }
}

@keyframes ctx-menu-in {
  from { opacity: 0; transform: scale(0.9); }
  to { opacity: 1; transform: scale(1); }
}

.ctx-menu__item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  height: 96rpx;
  padding: 0 30rpx;
  color: var(--color-role-text-primary, #1c1b1a);
  transition: background 120ms ease;
}

.ctx-menu__item:active {
  background: rgba(28, 27, 26, 0.06);
}

.ctx-menu__text {
  font-size: 30rpx;
  color: inherit;
  line-height: 1;
}

/* 删除项：抛弃实线分割，靠「间距 + 极浅内投影 + 红色」区隔（对齐规范抛弃分割线） */
.ctx-menu__item--danger {
  margin-top: 6rpx;
  box-shadow: inset 0 1rpx 0 rgba(28, 27, 26, 0.05);
  color: var(--color-semantic-danger, #FA5151);
}

/* ── 菜单极简单色图标（纯 CSS 几何，随 item color 变色，对齐 tab-bar 图标语言） ── */
.ctx-ic {
  position: relative;
  width: 34rpx;
  height: 34rpx;
  flex-shrink: 0;
  color: inherit;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 复制：两枚叠放的描边圆角矩形 */
.ctx-ic--copy view {
  position: absolute;
  width: 20rpx;
  height: 24rpx;
  border: 2rpx solid currentColor;
  border-radius: 4rpx;
  box-sizing: border-box;
}
.ctx-ic--copy view:nth-child(1) { right: 3rpx; top: 2rpx; }
.ctx-ic--copy view:nth-child(2) { left: 3rpx; bottom: 2rpx; background: rgba(250, 249, 245, 0.98); }

/* 备注：便签外框 + 两条文本线 */
.ctx-ic--note {
  width: 28rpx;
  height: 26rpx;
  border: 2rpx solid currentColor;
  border-radius: 4rpx;
  box-sizing: border-box;
  flex-direction: column;
  justify-content: center;
  gap: 4rpx;
  padding: 0 5rpx;
}
.ctx-ic--note view {
  width: 100%;
  height: 2rpx;
  background: currentColor;
  border-radius: 2rpx;
}
.ctx-ic--note view:nth-child(2) { width: 60%; }

/* 金额：¥ 符号（沿用项目以 text 作符号图标的做法，如 tab [+]） */
.ctx-ic--amount text {
  font-size: 28rpx;
  font-weight: 600;
  color: currentColor;
  line-height: 1;
}

/* 分类：2×2 四宫格 */
.ctx-ic--grid {
  flex-wrap: wrap;
  width: 24rpx;
  height: 24rpx;
  gap: 4rpx;
}
.ctx-ic--grid view {
  width: 10rpx;
  height: 10rpx;
  background: currentColor;
  border-radius: 2rpx;
}

/* 删除：垃圾桶（盖 + 把手 + 桶身） */
.ctx-ic--trash { flex-direction: column; }
.ctx-ic--trash .lid {
  position: relative;
  width: 24rpx;
  height: 2rpx;
  background: currentColor;
  border-radius: 2rpx;
}
.ctx-ic--trash .lid::before {
  content: '';
  position: absolute;
  top: -5rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 12rpx;
  height: 5rpx;
  border: 2rpx solid currentColor;
  border-bottom: none;
  border-radius: 3rpx 3rpx 0 0;
  box-sizing: border-box;
}
.ctx-ic--trash .can {
  margin-top: 3rpx;
  width: 18rpx;
  height: 18rpx;
  border: 2rpx solid currentColor;
  border-top: none;
  border-radius: 0 0 5rpx 5rpx;
  box-sizing: border-box;
}

/* pages/mine/index.wxss · 我的页 */
/* 卡号: COSTRA-201 · COSTRA-216: 补齐 custom navigation 安全区导航栏 */

.mine { background: var(--color-bg); min-height: 100vh; }

/* 自定义导航栏 */
.page-nav {
  display: flex;
  align-items: center;
  padding-left: 32rpx;
  background: #f1f2ec;
  position: relative;
  z-index: 10;
}

.page-nav__title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-role-text-primary, #1c1b1a);
}

/* 页面内容区 */
.mine__content {
  padding: 32rpx;
}

/* 用户信息卡片 */
.profile {
  display: flex;
  align-items: center;
  background: var(--color-surface);
  border-radius: var(--radius-lg);
  padding: 32rpx;
  /* 表示可点击 */
  active-background-color: rgba(0,0,0,0.04);
}

/* 头像容器（相对定位，承载红点） */
.profile__avatar-wrap {
  position: relative;
  flex-shrink: 0;
}

.profile__avatar {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: var(--color-divider);
  display: block;
}

/* 头像右上角红点 */
.profile__badge-dot {
  position: absolute;
  top: 0;
  right: 0;
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  background: #FF3B30;
  border: 3rpx solid var(--color-surface, #fff);
}

/* 昵称 + 提示文字 */
.profile__info {
  flex: 1;
  margin-left: 24rpx;
}

.profile__name {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-text);
}

.profile__hint {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #FF3B30;
}

.profile__arrow {
  color: var(--color-text-muted);
  font-size: 36rpx;
  margin-left: 8rpx;
}

.menu { margin-top: 32rpx; background: var(--color-surface); border-radius: var(--radius-lg); overflow: hidden; }
.menu__item { display: flex; align-items: center; padding: 28rpx 32rpx; border-bottom: 1rpx solid var(--color-divider); }
.menu__item:last-child { border-bottom: none; }
.menu__label { flex: 1; font-size: 28rpx; color: var(--color-text); }
.menu__arrow { color: var(--color-text-muted); font-size: 36rpx; }
.menu__item--danger .menu__label { color: var(--color-danger); text-align: center; }

/* ICP 备案号 footer · 12px 灰色居中 · 最后一行下划线点击态 */
.footer { padding: 32rpx 0 64rpx; text-align: center; }
.footer__text { font-size: 24rpx; color: #9E9E9E; line-height: 1.8; }
.footer__icp { letter-spacing: 0.5rpx; }
.footer__hint { text-decoration: underline; }

<view class="mine">
  <!-- 内容区 · 顶部仅留状态栏安全区，无导航标题（"我的" Tab 已在 tabbar 体现）-->
  <view class="mine__content" style="padding-top: {{statusBarHeight}}px; padding-bottom: {{contentBottomPadding}}px;">
    <!-- 顶部用户信息区：头像居中放大 · 昵称 · 已记账 X 天 -->
    <view class="profile" bindtap="onTapProfile" hover-class="profile--hover" hover-stay-time="60">
      <view class="profile__avatar-wrap">
        <image class="profile__avatar" src="{{avatarUrl}}" mode="aspectFill"></image>
        <view wx:if="{{showProfileBadge}}" class="profile__badge-dot"></view>
        <!-- 支持者纪念章（头像右下角 · 与右上角资料红点错开 · supporter_badge && !badge_hidden） -->
        <image
          wx:if="{{badgeVisible}}"
          class="profile__tip-badge"
          src="/assets/tip/badge-lit.png"
          mode="aspectFit"
        />
      </view>
      <view class="profile__name">{{nickname}}</view>
      <view wx:if="{{showProfileBadge}}" class="profile__hint">点击完善头像和昵称</view>
      <view wx:elif="{{overviewLoaded}}" class="profile__sub">已记账 {{ledgerDays}} 天</view>
    </view>

    <!-- 宏观数据总览：横向 2 列网格 · 无卡片底色 -->
    <view class="overview">
      <view class="overview__cell">
        <text class="overview__num tnum">{{ledgerDays}}</text>
        <text class="overview__label">记账天数</text>
      </view>
      <view class="overview__divider"></view>
      <view class="overview__cell">
        <text class="overview__num tnum">{{entryCount}}</text>
        <text class="overview__label">记账笔数</text>
      </view>
    </view>

    <!-- 赞赏横幅（独立成组 · 非列表项 · 仅 tip_entry_visible=true 展示 · 产品 §5.1） -->
    <view
      wx:if="{{tipEntryVisible}}"
      class="support-banner"
      bindtap="onTapSupport"
      hover-class="support-banner--hover"
      hover-stay-time="60"
    >
      <image
        class="support-banner__badge"
        src="{{supporterBadge ? '/assets/tip/badge-lit.png' : '/assets/tip/badge-outline.png'}}"
        mode="aspectFit"
      />
      <view class="support-banner__body">
        <view class="support-banner__title">支持 Costra</view>
        <view wx:if="{{supporterBadge}}" class="support-banner__sub">支持度 {{supportScore}} · 感谢你</view>
        <view wx:else class="support-banner__sub">记账功能永久免费，赞赏完全自愿</view>
        <view class="support-banner__cta">{{supporterBadge ? '再次支持' : '去支持'}} ›</view>
      </view>
    </view>

    <!-- 功能列表：圆角分组卡片 -->
    <view class="menu">
      <view class="menu__item" bindtap="onTapCreateFamily" hover-class="menu__item--hover" hover-stay-time="60">
        <view class="menu__label">创建协作账本</view>
        <view class="menu__arrow">›</view>
      </view>
      <view class="menu__item" bindtap="onTapRecurring" hover-class="menu__item--hover" hover-stay-time="60">
        <view class="menu__label">定时记账</view>
        <view class="menu__arrow">›</view>
      </view>
      <view class="menu__item" bindtap="onTapBulletin" hover-class="menu__item--hover" hover-stay-time="60">
        <view class="menu__label">
          公告
          <view wx:if="{{showBulletinBadge}}" class="menu__badge-dot"></view>
        </view>
        <view class="menu__arrow">›</view>
      </view>
      <view class="menu__row-flex">
        <button class="menu__item menu__item--feedback" open-type="feedback" hover-class="menu__item--hover" hover-stay-time="60">
          <view class="menu__label">意见反馈</view>
          <view class="menu__arrow">›</view>
        </button>
      </view>
      <view class="menu__item" bindtap="onTapAbout" hover-class="menu__item--hover" hover-stay-time="60">
        <view class="menu__label">关于 Costra</view>
        <view class="menu__arrow">›</view>
      </view>
      <view class="menu__item" bindtap="onTapSettings" hover-class="menu__item--hover" hover-stay-time="60">
        <view class="menu__label">设置</view>
        <view class="menu__arrow">›</view>
      </view>
    </view>

    <view class="menu" style="margin-top: 32rpx;">
      <view class="menu__item menu__item--danger" bindtap="onTapLogout" hover-class="menu__item--hover" hover-stay-time="60">
        <view class="menu__label">退出登录</view>
      </view>
    </view>

    <view class="footer">
      <view wx:if="{{appVersion}}" class="footer__text footer__version">v{{appVersion}}</view>
      <view class="footer__text footer__icp">沪ICP备2026017253号-1X</view>
      <view class="footer__text">服务由 costra.cloud 提供 · 沪ICP备2026017253号-2</view>
    </view>
    <view class="footer__privacy" bindtap="onTapPrivacy">
      <text class="footer__privacy-link">用户隐私保护指引</text>
    </view>
  </view>
</view>

<!-- COSTRA-201: 记账覆盖层 · 由 custom-tab-bar [+] 按钮触发 -->
<expense-overlay />

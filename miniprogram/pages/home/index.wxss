.home { padding: 32rpx; padding-bottom: 160rpx; background: var(--color-bg); min-height: 100vh; }

/* 用户画像问候区（COSTRA-102 · P1-4） */
.greeting {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
  padding: 8rpx 0;
}
.greeting__avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: var(--color-surface);
  margin-right: 16rpx;
  text-align: center;
  line-height: 72rpx;
  font-size: 40rpx;
}
.greeting__avatar--fallback {
  color: var(--color-text-muted);
}
.greeting__text {
  font-size: 30rpx;
  color: var(--color-text);
}

.overview {
  background: var(--color-surface);
  border-radius: var(--radius-lg);
  padding: 32rpx;
  box-shadow: var(--shadow-sm);
}
.overview__title { font-size: 28rpx; color: var(--color-text-muted); }
.overview__row { display: flex; margin-top: 16rpx; }
.overview__col { flex: 1; }
.overview__label { font-size: 24rpx; color: var(--color-text-muted); }
.overview__num { font-size: 44rpx; font-weight: 600; margin-top: 8rpx; color: var(--color-text); }
.overview__num--expense { color: var(--color-danger); }
.overview__num--income { color: var(--color-success); }

.recent { margin-top: 32rpx; background: var(--color-surface); border-radius: var(--radius-lg); padding: 32rpx; }
.recent__title { font-size: 28rpx; color: var(--color-text-muted); margin-bottom: 16rpx; }
.recent__empty { padding: 48rpx 0; text-align: center; color: var(--color-text-muted); font-size: 26rpx; }
.recent__item { display: flex; align-items: center; padding: 16rpx 0; border-bottom: 1rpx solid var(--color-divider); }
.recent__main { flex: 1; font-size: 28rpx; color: var(--color-text); }
.recent__amount { font-size: 28rpx; color: var(--color-text); font-weight: 600; margin: 0 16rpx; }
.recent__time { font-size: 22rpx; color: var(--color-text-muted); }

.fab {
  position: fixed; right: 32rpx; bottom: 140rpx;
  width: 112rpx; height: 112rpx; border-radius: 50%;
  background: var(--color-primary); color: #fff;
  font-size: 64rpx; text-align: center; line-height: 112rpx;
  box-shadow: var(--shadow-lg);
}

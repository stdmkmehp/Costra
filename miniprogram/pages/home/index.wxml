<!-- 首页 · 本月概览 + 最近记录 -->
<!-- 卡号: COSTRA-102 · P1-4：新增用户画像区（来源 AuthTokenPair.user） -->
<view class="home">
  <view class="greeting">
    <image wx:if="{{userAvatar}}" class="greeting__avatar" src="{{userAvatar}}" mode="aspectFill" binderror="onAvatarError"/>
    <view wx:else class="greeting__avatar greeting__avatar--fallback">👤</view>
    <view class="greeting__text">你好，{{userName}}</view>
  </view>

  <view class="overview">
    <view class="overview__title">{{monthLabel}}</view>
    <view class="overview__row">
      <view class="overview__col">
        <view class="overview__label">支出</view>
        <view class="overview__num overview__num--expense">¥ {{expenseDisplay}}</view>
      </view>
      <view class="overview__col">
        <view class="overview__label">收入</view>
        <view class="overview__num overview__num--income">¥ {{incomeDisplay}}</view>
      </view>
      <view class="overview__col">
        <view class="overview__label">结余</view>
        <view class="overview__num">¥ {{netDisplay}}</view>
      </view>
    </view>
  </view>

  <view class="recent">
    <view class="recent__title">最近记录</view>
    <view wx:if="{{recent.length === 0}}" class="recent__empty">暂无记录，点击右下角快速记一笔</view>
    <block wx:else>
      <view wx:for="{{recent}}" wx:key="id" class="recent__item">
        <view class="recent__main">{{item.title}}</view>
        <view class="recent__amount">¥ {{item.amount}}</view>
        <view class="recent__time">{{item.time}}</view>
      </view>
    </block>
  </view>

  <view class="fab" bindtap="onTapAdd">+</view>
</view>

<!-- pages/invite-confirm/index.wxml · 邀请确认页 -->
<view class="invite-dialog-page invite-confirm">
  <view class="invite-dialog__card">
    <block wx:if="{{loading}}">
      <view class="invite-dialog__state">
        <view class="invite-dialog__spinner"></view>
        <text class="invite-dialog__title">正在获取邀请信息</text>
        <text class="invite-dialog__desc">请稍候，我们正在确认这条邀请是否仍然有效。</text>
      </view>
    </block>

    <block wx:elif="{{expired}}">
      <view class="invite-dialog__badge invite-dialog__badge--warn">!</view>
      <text class="invite-dialog__title">邀请链接已失效</text>
      <text class="invite-dialog__desc">该链接已被使用或已过期，请联系家庭创建者重新发起邀请。</text>
      <view class="invite-dialog__actions invite-dialog__actions--single">
        <button class="invite-dialog__btn invite-dialog__btn--secondary" bindtap="onTapClose">关闭</button>
      </view>
    </block>

    <block wx:elif="{{familyName}}">
      <view class="invite-dialog__badge">邀</view>
      <text class="invite-dialog__title">加入「{{familyName}}」</text>
      <text class="invite-dialog__desc">「{{inviterNickname}}」邀请你加入共同记账，确认后即可进入同一个协作账本。</text>
      <text class="invite-dialog__hint">确认后你将与家庭成员共享账本数据；若暂不加入，可直接拒绝。</text>
      <view class="invite-dialog__actions">
        <button class="invite-dialog__btn invite-dialog__btn--secondary" bindtap="onTapDecline">拒绝</button>
        <button class="invite-dialog__btn invite-dialog__btn--primary" loading="{{joining}}" disabled="{{joining}}" bindtap="onTapConfirm">同意加入</button>
      </view>
    </block>
  </view>
</view>

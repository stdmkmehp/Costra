/* pages/invite-confirm/index.wxss · 邀请确认页 */

.invite-confirm {
  min-height: 100vh;
  background: var(--color-bg, #f1f2ec);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 48rpx 40rpx;
  box-sizing: border-box;
}

/* ---- 状态页（加载中 / 已失效）---- */

.state-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
  padding: 64rpx 32rpx;
}

.state-spinner {
  width: 64rpx;
  height: 64rpx;
  border: 6rpx solid rgba(28,27,26,0.12);
  border-top-color: #1c1b1a;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.state-icon {
  font-size: 80rpx;
  line-height: 1;
}

.state-title {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--color-role-text-primary, #1c1b1a);
  text-align: center;
}

.state-text,
.state-desc {
  font-size: 28rpx;
  color: rgba(28, 27, 26, 0.5);
  text-align: center;
  line-height: 1.6;
}

/* ---- 邀请卡片 ---- */

.confirm-body {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: stretch;
  gap: 32rpx;
}

.card {
  background: var(--color-surface, #fff);
  border-radius: 24rpx;
  padding: 56rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
}

.card__icon {
  font-size: 96rpx;
  line-height: 1;
}

.card__family {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--color-role-text-primary, #1c1b1a);
  text-align: center;
}

.card__sub {
  font-size: 28rpx;
  color: rgba(28, 27, 26, 0.55);
  text-align: center;
  line-height: 1.5;
}

.desc-block {
  padding: 0 8rpx;
}

.desc-text {
  font-size: 26rpx;
  color: rgba(28, 27, 26, 0.45);
  line-height: 1.7;
  text-align: center;
}

/* ---- 操作按钮行 ---- */

.action-row {
  display: flex;
  gap: 24rpx;
  margin-top: 8rpx;
}

.btn {
  flex: 1;
  height: 88rpx;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: opacity 150ms;
}

.btn::after {
  border: none;
}

.btn--decline {
  background: var(--color-surface, #fff);
  color: rgba(28, 27, 26, 0.6);
  border: 2rpx solid rgba(28, 27, 26, 0.15);
}

.btn--confirm {
  background: #07C160;
  color: #fff;
}

.btn--loading {
  opacity: 0.6;
}

.btn--secondary {
  background: var(--color-surface, #fff);
  color: var(--color-role-text-primary, #1c1b1a);
  border: 2rpx solid rgba(28, 27, 26, 0.15);
  margin-top: 8rpx;
  width: 240rpx;
  flex: unset;
}

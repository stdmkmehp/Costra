<!-- 登录页 · COSTRA-202 极简重做：暖灰白背景 + Wordmark + 随机格言 -->
<!-- 方案 X（免登录墙）：默认自动静默登录，无一键登录按钮；仅在自动登录失败时显示「重试登录」 -->
<!-- 设计规范：design/ui/design_spec.md §6.1 · 交互流程：design/ui/interaction_flow.md §1 -->
<!-- 合规：不在登录主界面展示隐私协议勾选框 · 合规动作走微信原生授权流程 -->
<view class="login">
  <!-- 中心视觉区 -->
  <view class="login__center">
    <text class="login__wordmark">COSTRA</text>
    <text class="login__slogan">{{slogan}}</text>
  </view>

  <!-- 底部操作区 -->
  <view class="login__bottom">
    <!-- 方案 X：默认自动登录中 · 无需用户点按钮 -->
    <view wx:if="{{loading}}" class="login__status">登录中…</view>
    <!-- 自动登录失败 → 显示重试按钮 -->
    <block wx:if="{{failed}}">
      <button class="login__btn" bindtap="onTapRetry">{{loggedOut ? '登录' : '重试登录'}}</button>
      <view wx:if="{{errMsg}}" class="login__err">{{errMsg}}</view>
    </block>
  </view>
</view>

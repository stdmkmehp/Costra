<!-- 记一笔页 -->
<view class="entry">
  <view class="tabs">
    <view class="tabs__item {{type==='expense'?'tabs__item--active':''}}" data-type="expense" bindtap="onTapType">支出</view>
    <view class="tabs__item {{type==='income'?'tabs__item--active':''}}" data-type="income" bindtap="onTapType">收入</view>
  </view>

  <view class="amount">
    <view class="amount__display">¥ {{amountDisplay}}</view>
    <input
      class="amount__input"
      type="digit"
      value="{{amountInput}}"
      bindinput="onAmountInput"
      placeholder="0.00" />
  </view>

  <view class="row" bindtap="onTapCategory">
    <view class="row__label">分类</view>
    <view class="row__value">{{categoryName}}</view>
    <view class="row__arrow">›</view>
  </view>

  <view class="row">
    <view class="row__label">备注</view>
    <input
      class="row__input"
      value="{{note}}"
      bindinput="onNoteInput"
      placeholder="可选，最多 140 字"
      maxlength="140" />
  </view>

  <button class="btn btn--primary" loading="{{submitting}}" bindtap="onSubmit">保存</button>
</view>

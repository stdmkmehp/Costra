<!-- pages/statistics/tpl-yearly-pane.wxml · 年度数据 pane 模板 -->
<!-- 卡号: COSTRA-261 · 按成员维度渲染 · member 变量由外层 wx:for 提供 -->
<!-- 2026-08 收入分类排行迭代：排行区抽出 tpl-rank-section.wxml，本文件挂两次（支出/收入） -->

<import src="./tpl-rank-section.wxml" />

<!-- loading 态 -->
<view wx:if="{{yearlyByMember[member.key].loading && !yearlyByMember[member.key].loaded}}" class="pane-loading">
  <text>加载中...</text>
</view>

<!-- 空态 -->
<view wx:elif="{{yearlyByMember[member.key].isEmpty && yearlyByMember[member.key].loaded}}" class="empty-state">
  <text class="empty-state__title">{{yearlyByMember[member.key].emptyTitle}}</text>
  <text class="empty-state__hint">{{yearlyByMember[member.key].emptyHint}}</text>
</view>

<!-- 有数据 -->
<block wx:elif="{{yearlyByMember[member.key].loaded}}">
  <!-- 宏观区 -->
  <view class="macro">
    <view class="macro__primary tnum">{{yearlyByMember[member.key].totalExpense}}</view>
    <view class="macro__secondary">
      <text class="macro__sec-label">收入</text>
      <text class="macro__sec-value tnum">{{yearlyByMember[member.key].totalIncome}}</text>
      <text class="macro__sec-divider">·</text>
      <text class="macro__sec-label">结余</text>
      <text class="macro__sec-value tnum">{{yearlyByMember[member.key].totalBalance}}</text>
    </view>
    <view class="macro__chart">
      <trend-line-chart
        data="{{yearlyByMember[member.key].trend}}"
        height="{{160}}"
        color="#1c1b1a"
        fill-gradient="{{true}}"
        period-dividers="{{yearlyByMember[member.key].chartMeta.periodDividers}}"
        current-index="{{yearlyByMember[member.key].chartMeta.currentIndex}}"
        peak-index="{{yearlyByMember[member.key].chartMeta.peakIndex}}"
        peak-label="{{yearlyByMember[member.key].chartMeta.peakLabel}}"
      />
    </view>
  </view>

  <!-- 摘要 4 格 -->
  <view class="summary-grid" wx:if="{{yearlyByMember[member.key].summary.length > 0}}">
    <view class="summary-grid__item" wx:for="{{yearlyByMember[member.key].summary}}" wx:key="label">
      <view class="summary-grid__value tnum">{{item.value}}</view>
      <view class="summary-grid__label">{{item.label}}</view>
    </view>
  </view>

  <!-- 12 月简表 · 莫兰迪双色线条版 -->
  <!--
    左：月份标签（可点击进月度页）
    右：双行条形图
       · 上排 [支出]，下排 [收入]
       · 每条线宽度 = item.{expense|income}Ratio * 100%
       · 全年统一基线（globalMax = max(month.expense, month.income)），
         让 12 个月能直接对比长短
       · 结余 = income - expense，由数字行"余"列展示精确值
  -->
  <view class="month-list" wx:if="{{yearlyByMember[member.key].months.length > 0}}">
    <view class="month-list__title">月度流水</view>

    <!-- 颜色图例 · 让用户先建立"颜色-数据"映射 -->
    <view class="month-list__legend">
      <view class="month-list__legend-item">
        <view class="month-list__legend-dot month-list__legend-dot--expense"></view>
        <text>支出</text>
      </view>
      <view class="month-list__legend-item">
        <view class="month-list__legend-dot month-list__legend-dot--income"></view>
        <text>收入</text>
      </view>
    </view>

    <view
      wx:for="{{yearlyByMember[member.key].months}}"
      wx:key="month"
      class="month-list__row {{item.isEmpty ? 'month-list__row--empty' : ''}}"
      data-month="{{item.month}}"
      bind:tap="onTapYearlyMonth"
    >
      <text class="month-list__label">{{item.label}}</text>

      <view class="month-list__bars" wx:if="{{!item.isEmpty}}">
        <!--
          双行条形图：上排 [支出]，下排 [收入]
          · 每条线宽度 = item.{expense|income}Ratio * 100%
          · 全年统一基线（globalMax = max(month.expense, month.income)），
            让 12 个月能直接对比长短
          · 结余 = income - expense，由数字行"余"列展示精确值
        -->
        <view class="month-list__bar-row">
          <view class="month-list__bar-track month-list__bar-track--expense" style="width: {{item.expenseRatio * 100}}%;"></view>
        </view>
        <view class="month-list__bar-row">
          <view class="month-list__bar-track month-list__bar-track--income" style="width: {{item.incomeRatio * 100}}%;"></view>
        </view>

        <!-- 数字行：保留原 支/收/余 文本，避免完全去掉数字让用户失去精确信息 -->
        <view class="month-list__bar-numbers tnum">
          <text class="month-list__bar-num">支 {{item.expense}}</text>
          <text class="month-list__bar-num">收 {{item.income}}</text>
          <text class="month-list__bar-num">余 {{item.balance}}</text>
        </view>
      </view>

      <!-- 空态行：仅显示"无记录"占位 -->
      <view class="month-list__empty" wx:else>
        <text class="month-list__empty-text">无记录</text>
      </view>

      <text class="month-list__arrow">›</text>
    </view>
  </view>

  <!-- 支出分类排行（原有 · 年度） -->
  <template is="rank-section" data="{{
    title: '支出分类排行',
    list: yearlyByMember[member.key].l1,
    entryType: 'expense',
    memberKey: member.key,
    moreLabel: '支出'
  }}" />

  <!-- 收入分类排行（2026-08 新增 · 空列表整块隐藏由 template 内部 wx:if 保证） -->
  <template is="rank-section" data="{{
    title: '收入分类排行',
    list: yearlyByMember[member.key].incomeL1,
    entryType: 'income',
    memberKey: member.key,
    moreLabel: '收入'
  }}" />
</block>

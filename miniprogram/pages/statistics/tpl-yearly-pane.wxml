<!-- pages/statistics/tpl-yearly-pane.wxml · 年度数据 pane 模板 -->
<!-- 卡号: COSTRA-261 · 按成员维度渲染 · member 变量由外层 wx:for 提供 -->

<!-- loading 态 -->
<view wx:if="{{yearlyByMember[member.key].loading && !yearlyByMember[member.key].loaded}}" class="pane-loading">
  <text>加载中...</text>
</view>

<!-- 空态 -->
<view wx:elif="{{yearlyByMember[member.key].isEmpty && yearlyByMember[member.key].loaded}}" class="empty-state">
  <text class="empty-state__title">{{yearlyByMember[member.key].emptyTitle}}</text>
  <text class="empty-state__hint">{{yearlyByMember[member.key].emptyHint}}</text>
</view>

<!-- 有数据 -->
<block wx:elif="{{yearlyByMember[member.key].loaded}}">
  <!-- 宏观区 -->
  <view class="macro">
    <view class="macro__primary tnum">{{yearlyByMember[member.key].totalExpense}}</view>
    <view class="macro__secondary">
      <text class="macro__sec-label">收入</text>
      <text class="macro__sec-value tnum">{{yearlyByMember[member.key].totalIncome}}</text>
      <text class="macro__sec-divider">·</text>
      <text class="macro__sec-label">结余</text>
      <text class="macro__sec-value tnum">{{yearlyByMember[member.key].totalBalance}}</text>
    </view>
    <view class="macro__chart">
      <trend-line-chart
        data="{{yearlyByMember[member.key].trend}}"
        height="{{160}}"
        color="#1c1b1a"
        fill-gradient="{{true}}"
        period-dividers="{{yearlyByMember[member.key].chartMeta.periodDividers}}"
        current-index="{{yearlyByMember[member.key].chartMeta.currentIndex}}"
        peak-index="{{yearlyByMember[member.key].chartMeta.peakIndex}}"
        peak-label="{{yearlyByMember[member.key].chartMeta.peakLabel}}"
      />
    </view>
  </view>

  <!-- 摘要 4 格 -->
  <view class="summary-grid" wx:if="{{yearlyByMember[member.key].summary.length > 0}}">
    <view class="summary-grid__item" wx:for="{{yearlyByMember[member.key].summary}}" wx:key="label">
      <view class="summary-grid__value tnum">{{item.value}}</view>
      <view class="summary-grid__label">{{item.label}}</view>
    </view>
  </view>

  <!-- 12 月简表 · 莫兰迪三色线条版（2026-08-05 改版） -->
  <!--
    左：月份标签（可点击进月度页）
    右：双行条形图
       · barLayout='income-top'（balance>=0）：上排 [支出][结余] 拼接长度 = 下排 [收入]
       · barLayout='expense-top'（balance<0） ：上排 [收入][|结余|] 拼接长度 = 下排 [支出]
       · 每条线宽度 = item.{expense|income|balance}Ratio * 100%
       · 全年统一基线（globalMax = max(month.expense, month.income, |month.balance|)），
         让 12 个月能直接对比长短
  -->
  <view class="month-list" wx:if="{{yearlyByMember[member.key].months.length > 0}}">
    <view class="month-list__title">月度流水</view>

    <!-- 颜色图例 · 让用户先建立"颜色-数据"映射 -->
    <view class="month-list__legend">
      <view class="month-list__legend-item">
        <view class="month-list__legend-dot month-list__legend-dot--expense"></view>
        <text>支出</text>
      </view>
      <view class="month-list__legend-item">
        <view class="month-list__legend-dot month-list__legend-dot--income"></view>
        <text>收入</text>
      </view>
      <view class="month-list__legend-item">
        <view class="month-list__legend-dot month-list__legend-dot--balance"></view>
        <text>结余</text>
      </view>
    </view>

    <view
      wx:for="{{yearlyByMember[member.key].months}}"
      wx:key="month"
      class="month-list__row {{item.isEmpty ? 'month-list__row--empty' : ''}}"
      data-month="{{item.month}}"
      bind:tap="onTapYearlyMonth"
    >
      <text class="month-list__label">{{item.label}}</text>

      <view class="month-list__bars" wx:if="{{!item.isEmpty}}">
        <!--
          第一排：上排 = 较小者（按 barLayout 切到支/收 + 1段 |结余|）
          balance>=0 时：第一排 [支出+结余] = 第二排 [收入]
          balance<0  时：第一排 [收入+|结余|] = 第二排 [支出]
        -->
        <view class="month-list__bar-row">
          <block wx:if="{{item.barLayout === 'income-top'}}">
            <view class="month-list__bar-track month-list__bar-track--expense" style="width: {{item.expenseRatio * 100}}%;"></view>
            <view class="month-list__bar-track month-list__bar-track--balance" style="width: {{item.balanceRatio * 100}}%;"></view>
          </block>
          <block wx:else>
            <view class="month-list__bar-track month-list__bar-track--income" style="width: {{item.incomeRatio * 100}}%;"></view>
            <view class="month-list__bar-track month-list__bar-track--balance" style="width: {{item.balanceRatio * 100}}%;"></view>
          </block>
        </view>
        <!-- 第二排：上排的两条拼接长度 = 此排单线长度（视觉自洽） -->
        <view class="month-list__bar-row">
          <block wx:if="{{item.barLayout === 'income-top'}}">
            <view class="month-list__bar-track month-list__bar-track--income" style="width: {{item.incomeRatio * 100}}%;"></view>
          </block>
          <block wx:else>
            <view class="month-list__bar-track month-list__bar-track--expense" style="width: {{item.expenseRatio * 100}}%;"></view>
          </block>
        </view>

        <!-- 数字行：保留原 支/收/余 文本，避免完全去掉数字让用户失去精确信息 -->
        <view class="month-list__bar-numbers tnum">
          <text class="month-list__bar-num">支 {{item.expense}}</text>
          <text class="month-list__bar-num">收 {{item.income}}</text>
          <text class="month-list__bar-num">余 {{item.balance}}</text>
        </view>
      </view>

      <!-- 空态行：仅显示"无记录"占位 -->
      <view class="month-list__empty" wx:else>
        <text class="month-list__empty-text">无记录</text>
      </view>

      <text class="month-list__arrow">›</text>
    </view>
  </view>

  <!-- 年度排行 -->
  <view class="rank" wx:if="{{yearlyByMember[member.key].l1.length > 0}}">
    <view class="rank__title">分类排行</view>
    <view class="rank__list">
      <block wx:for="{{yearlyByMember[member.key].l1}}" wx:key="category_id" wx:for-item="l1">
        <view
          class="rank__row {{l1.expanded ? 'rank__row--open' : ''}}"
          data-id="{{l1.category_id}}"
          data-memberkey="{{member.key}}"
          bind:touchstart="onTouchStartL1"
          bind:tap="onTapL1"
        >
          <view class="rank__row-main">
            <view class="rank__icon">{{l1.icon}}</view>
            <view class="rank__name">{{l1.category_name}}</view>
            <view class="rank__amount tnum">{{l1.amount}}</view>
            <view class="rank__ratio">{{l1.ratioText}}</view>
          </view>
          <view class="rank__bar">
            <view class="rank__bar-fill" style="width: {{l1.ratio_bps / 100}}%;"></view>
          </view>
        </view>

        <!-- L2 展开 -->
        <view class="l2" wx:if="{{l1.expanded}}">
          <view class="l2__loading" wx:if="{{l1.loadingL2}}">加载中...</view>
          <block wx:elif="{{l1.l2Items.length > 0}}">
            <block wx:for="{{l1.l2Items}}" wx:key="category_id" wx:for-item="l2">
              <view
                class="l2__row {{l2.expanded ? 'l2__row--open' : ''}}"
                data-l1id="{{l1.category_id}}"
                data-id="{{l2.category_id}}"
                data-memberkey="{{member.key}}"
                bind:touchstart="onTouchStartL2"
                catch:tap="onTapL2"
              >
                <view class="l2__row-main">
                  <view class="l2__icon">{{l2.icon}}</view>
                  <view class="l2__name">{{l2.category_name}}</view>
                  <view class="l2__amount tnum">{{l2.amount}}</view>
                  <view class="l2__ratio">{{l2.ratioText}}</view>
                </view>
                <view class="l2__bar">
                  <view class="l2__bar-fill" style="width: {{l2.ratio_bps / 100}}%;"></view>
                </view>
              </view>

              <!-- L3 单笔明细 -->
              <view class="l3" wx:if="{{l2.expanded}}" catch:tap="noop">
                <view class="l3__loading" wx:if="{{l2.loadingL3}}">加载中...</view>
                <block wx:elif="{{l2.l3Items.length > 0}}">
                  <view class="l3__row" wx:for="{{l2.l3Items}}" wx:key="entry_id" wx:for-item="l3">
                    <view class="l3__avatar">
                      <image wx:if="{{l3.avatarUrl}}" class="l3__avatar-img" src="{{l3.avatarUrl}}" mode="aspectFill" lazy-load />
                      <view wx:else class="l3__avatar-placeholder">{{l3.initial}}</view>
                    </view>
                    <view class="l3__main">
                      <view class="l3__top">
                        <text class="l3__date">{{l3.dateLabel}}</text>
                        <text class="l3__note">{{l3.note}}</text>
                        <text class="l3__amount tnum">{{l3.amount}}</text>
                      </view>
                      <view class="l3__bottom">
                        <text class="l3__time">{{l3.timeLabel}}</text>
                        <text wx:if="{{l3.isRecurring}}" class="l3__tag l3__tag--recurring">定时</text>
                        <text wx:if="{{l3.isShared}}" class="l3__tag l3__tag--shared">公共</text>
                      </view>
                    </view>
                  </view>
                  <view class="l3__more" wx:if="{{l2.l3HasMore}}">
                    还有部分较小支出未显示...
                  </view>
                </block>
                <view class="l3__empty" wx:else>暂无明细</view>
              </view>
            </block>
            <view class="l2__more" wx:if="{{l1.l2HasMore}}">
              还有部分较小支出未显示...
            </view>
          </block>
          <view class="l2__empty" wx:else>暂无子分类</view>
        </view>
      </block>
    </view>
  </view>
</block>

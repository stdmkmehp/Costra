<!-- pages/statistics/index.wxml · 统计页（Tab2） -->
<!-- 卡号: COSTRA-263 · 成员横滑改为 native swiper + auto-height adapter -->
<!-- 设计源: design/ui/design_spec.md §6.4 + interaction_flow.md §5 -->
<!-- ready gate: bootstrap 完成且已登录前页面完全空白 -->

<view class="stat" wx:if="{{ready}}">
  <!-- 导航栏：账本切换器（锚定下拉气泡，替代原生 ActionSheet） -->
  <ledger-switcher name="{{ledgerName}}" />

  <view class="stat__content" style="padding-top: {{statusBarHeight + navBarHeight}}px;">

      <!-- ═══════ 时间维度 + 月/年切换 ═══════ -->
      <view class="time-bar">
        <view class="time-nav">
          <view class="time-nav__arrow month-switcher__arrow month-switcher__arrow--prev" hover-class="month-switcher__arrow--pressed" hover-stay-time="80" bind:tap="onPrevTime">
            <text class="time-nav__arrow-text month-switcher__arrow-icon">‹</text>
          </view>

          <picker
            wx:if="{{dimension === 'monthly'}}"
            class="time-nav__picker"
            mode="date"
            fields="month"
            value="{{currentMonth}}"
            bind:change="onMonthChange"
          >
            <view class="time-nav__picker-inner month-switcher__value" hover-class="month-switcher__value--pressed" hover-stay-time="80">
              <text class="time-nav__text">{{monthDisplay}}</text>
              <text class="time-nav__caret">▼</text>
            </view>
          </picker>

          <picker
            wx:else
            class="time-nav__picker"
            mode="date"
            fields="year"
            value="{{currentYear}}-01-01"
            bind:change="onYearChange"
          >
            <view class="time-nav__picker-inner month-switcher__value" hover-class="month-switcher__value--pressed" hover-stay-time="80">
              <text class="time-nav__text">{{yearDisplay}}</text>
              <text class="time-nav__caret">▼</text>
            </view>
          </picker>

          <view class="time-nav__arrow month-switcher__arrow month-switcher__arrow--next" hover-class="month-switcher__arrow--pressed" hover-stay-time="80" bind:tap="onNextTime">
            <text class="time-nav__arrow-text month-switcher__arrow-icon">›</text>
          </view>

          <!-- 返回当月/当年按钮：仅在非当前周期时显示 -->
          <view
            wx:if="{{dimension === 'monthly' && !isCurrentMonth || dimension === 'yearly' && !isCurrentYear}}"
            class="month-switcher__today"
            hover-class="month-switcher__today--pressed"
            hover-stay-time="80"
            bind:tap="onBackToCurrent"
          >
            <text class="month-switcher__today-icon">⤺</text>
            <text class="month-switcher__today-text">{{dimension === 'monthly' ? '返回本月' : '返回本年'}}</text>
          </view>
        </view>

        <view class="dim-switch">
          <view
            class="dim-switch__btn {{dimension === 'monthly' ? 'dim-switch__btn--active' : ''}}"
            data-dim="monthly"
            bind:tap="onSwitchDimension"
          >月度</view>
          <view
            class="dim-switch__btn {{dimension === 'yearly' ? 'dim-switch__btn--active' : ''}}"
            data-dim="yearly"
            bind:tap="onSwitchDimension"
          >年度</view>
        </view>
      </view>

      <!-- ═══════ 成员指示器条（多人账本 + 成员 > 1 时显示）═══════ -->
      <scroll-view
        wx:if="{{familyKind === 'shared' && memberTabs.length > 1}}"
        class="member-strip"
        scroll-x
        scroll-into-view="{{memberScrollIntoView}}"
        scroll-with-animation
        enhanced
        show-scrollbar="{{false}}"
      >
        <view class="member-strip__inner">
          <view
            wx:for="{{memberTabs}}"
            wx:key="key"
            id="mtab-{{index}}"
            class="member-strip__item {{memberTabIndex === index ? 'is-active' : ''}} {{item.status === 'left' ? 'is-left' : ''}}"
            data-index="{{index}}"
            bind:tap="onTapMemberTab"
          >
            <view wx:if="{{item.type === 'all'}}" class="member-strip__all">全部</view>
            <view wx:else class="member-strip__avatar" style="background-color: {{item.color}};">
              <image wx:if="{{item.avatarUrl}}" src="{{item.avatarUrl}}" class="member-strip__avatar-img" mode="aspectFill" lazy-load />
              <text wx:else class="member-strip__avatar-fallback">{{item.initial}}</text>
            </view>
            <view class="member-strip__indicator"></view>
          </view>
        </view>
      </scroll-view>

      <!-- ═══════ 数据区 ═══════ -->

      <!-- 多人账本：固定高度 swiper + 每成员独立纵向 scroll-view -->
      <swiper
        wx:if="{{familyKind === 'shared' && memberTabs.length > 1}}"
        class="member-pages-swiper"
        current="{{memberTabIndex}}"
        duration="{{memberSwiperDuration}}"
        style="height: {{memberSwiperHeightPx}}px;"
        bindchange="onMemberSwiperChange"
      >
        <swiper-item wx:for="{{memberTabs}}" wx:key="key" wx:for-item="member" wx:for-index="paneIdx">
          <scroll-view
            id="mpane-scroll-{{paneIdx}}"
            class="member-pane-scroll"
            scroll-y
            enhanced
            show-scrollbar="{{false}}"
            scroll-top="{{memberPaneScrollTops[member.key] || 0}}"
            data-memberkey="{{member.key}}"
            bindscroll="onMemberPaneScroll"
            style="height: {{memberSwiperHeightPx}}px;"
          >
            <view id="mpane-{{paneIdx}}" class="member-pane">
              <view class="member-pane-inner">
                <block wx:if="{{dimension === 'monthly'}}">
                  <include src="./tpl-monthly-pane.wxml" />
                </block>
                <block wx:else>
                  <include src="./tpl-yearly-pane.wxml" />
                </block>
                <view class="bottom-spacer" style="height: {{bottomSpacerHeight}}px;"></view>
              </view>
            </view>
          </scroll-view>
        </swiper-item>
      </swiper>

      <!-- 单人账本：同样使用独立纵向 scroll-view -->
      <block wx:elif="{{memberTabs.length > 0}}">
        <block wx:for="{{memberTabs}}" wx:key="key" wx:for-item="member" wx:for-index="paneIdx">
          <scroll-view
            wx:if="{{paneIdx === 0}}"
            class="member-pane-scroll"
            scroll-y
            enhanced
            show-scrollbar="{{false}}"
            scroll-top="{{memberPaneScrollTops[member.key] || 0}}"
            data-memberkey="{{member.key}}"
            bindscroll="onMemberPaneScroll"
            style="height: {{memberSwiperHeightPx}}px;"
          >
            <view class="member-pane">
              <view class="member-pane-inner">
                <block wx:if="{{dimension === 'monthly'}}">
                  <include src="./tpl-monthly-pane.wxml" />
                </block>
                <block wx:else>
                  <include src="./tpl-yearly-pane.wxml" />
                </block>
                <view class="bottom-spacer" style="height: {{bottomSpacerHeight}}px;"></view>
              </view>
            </view>
          </scroll-view>
        </block>
      </block>
  </view>
</view>

<!-- 记账覆盖层 · 由 custom-tab-bar [+] 按钮触发（必须挂载，否则 SHOW_EXPENSE_OVERLAY 事件无组件实例响应） -->
<expense-overlay />

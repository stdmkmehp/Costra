<!-- pages/statistics/index.wxml · 统计页（Tab2） -->
<!-- 卡号: COSTRA-201 / COSTRA-223 · 骨架 + 导航栏账本切换 -->

<view class="statistics">
  <!-- 导航栏：与明细页/家庭页一致（居中账本名 + ▼ 切换） -->
  <view class="nav-bar" style="padding-top: {{statusBarHeight}}px;">
    <view class="nav-bar__content" style="height: {{navBarHeight}}px;">
      <view class="nav-bar__center" bind:tap="onTapLedgerName">
        <text class="nav-bar__title">{{ledgerName}}</text>
        <text class="nav-bar__arrow">▼</text>
      </view>
    </view>
  </view>

  <!-- 页面内容区 -->
  <view class="statistics__content" style="padding-top: {{statusBarHeight + navBarHeight}}px;">
    <view class="statistics__empty">
      <text class="statistics__empty-text">统计功能即将上线</text>
    </view>
  </view>
</view>

<expense-overlay />

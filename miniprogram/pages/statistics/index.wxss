/* pages/statistics/index.wxss · 统计页（Tab2） */
/* 卡号: COSTRA-264 · review 修复 + 二指手势后统计页左边距异常修复 */
/* 设计源: design/ui/design_spec.md §6.4 */

/* ─── 二指手势水平偏移防护（COSTRA-264）───────────────────────────
 * Root cause: 页面内存在负 margin（.l2 margin: -32rpx / .l3 margin: -56rpx）
 * 导致实际内容宽度超过视口，二指手势触发 WebView 水平滚动。
 * 修复：从 page 到内容容器逐层加 overflow-x: hidden + box-sizing: border-box
 * 阻止全页水平位移，同时保留 .member-strip scroll-x 自身横向滚动。
 * ─────────────────────────────────────────────────────────────── */

page {
  height: 100%;
  background: #f1f2ec;
  overflow: hidden;
  max-width: 100vw;
}

.stat {
  height: 100vh;
  background: #f1f2ec;
  overflow: hidden;
  width: 100%;
  max-width: 100%;
  box-sizing: border-box;
}

/* ─── 导航栏 · 与明细页/家庭页严格一致 ─────────────────────────────── */
/* 导航栏样式已迁入 <ledger-switcher> 组件 */

/* ─── 内容区（固定控制区 + 内部 scroll-view）──────────────────────── */
.stat__content {
  height: 100vh;
  padding: 0;
  overflow: hidden;
  width: 100%;
  max-width: 100%;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

/* ─── 时间维度条 ─────────────────────────────────────────────────── */
.time-bar {
  flex: none;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 32rpx 24rpx;
}

.time-nav {
  display: flex;
  align-items: center;
}

.time-nav__picker {
  flex: none;
}

.time-nav__picker-inner {
  padding: 0 8rpx;
  display: flex;
  align-items: center;
}

.time-nav__text {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-role-text-primary, #1c1b1a);
}

.time-nav__caret {
  font-size: 18rpx;
  margin-left: 6rpx;
  color: var(--color-role-text-tertiary, rgba(28,27,26,0.28));
}

/* 月度/年度切换 */
.dim-switch {
  display: flex;
  align-items: center;
  gap: 4rpx;
  background: rgba(28,27,26,0.05);
  border-radius: 8rpx;
  padding: 4rpx;
}

.dim-switch__btn {
  font-size: 24rpx;
  padding: 8rpx 16rpx;
  border-radius: 6rpx;
  color: var(--color-role-text-secondary, rgba(28,27,26,0.48));
  transition: all 0.2s ease;
}

.dim-switch__btn--active {
  background: rgba(255,255,255,0.72);
  color: var(--color-role-text-primary, #1c1b1a);
  font-weight: 500;
}

/* ─── 成员指示器条（COSTRA-261） ─────────────────────────────────── */
.member-strip {
  flex: none;
  white-space: nowrap;
  padding: 0 16rpx 16rpx;
  max-width: 100%;
  box-sizing: border-box;
}

.member-strip__inner {
  display: inline-flex;
  align-items: flex-end;
  gap: 32rpx;
  padding: 0 16rpx;
}

.member-strip__item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  padding: 4rpx 0;
  opacity: 0.45;
  transition: opacity 0.2s;
}

.member-strip__item.is-active {
  opacity: 1;
}

.member-strip__item.is-left {
  filter: grayscale(1);
  opacity: 0.35;
}

.member-strip__item.is-left.is-active {
  opacity: 0.7;
}

.member-strip__all {
  font-size: 26rpx;
  font-weight: 600;
  color: #1c1b1a;
  line-height: 56rpx;
  padding: 0 8rpx;
}

.member-strip__avatar {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}

.member-strip__avatar-img {
  width: 100%;
  height: 100%;
}

.member-strip__avatar-fallback {
  color: #fff;
  font-size: 22rpx;
  font-weight: 600;
}

.member-strip__indicator {
  margin-top: 8rpx;
  width: 24rpx;
  height: 4rpx;
  background: transparent;
  border-radius: 2rpx;
  transition: background 0.2s;
}

.member-strip__item.is-active .member-strip__indicator {
  background: #1c1b1a;
}

/* ─── 横向数据区 swiper（COSTRA-263 · native swiper + auto-height） ─── */
.member-pages-swiper {
  flex: none;
  width: 100%;
  max-width: 100%;
  box-sizing: border-box;
  overflow: hidden;
}

.member-pane-scroll {
  width: 100%;
  max-width: 100%;
  height: 100%;
  min-height: 0;
  overflow: hidden;
  box-sizing: border-box;
}

.member-pane {
  width: 100%;
  max-width: 100%;
  min-height: 100%;
  overflow-x: hidden;
  box-sizing: border-box;
}

.member-pane-inner {
  width: 100%;
  max-width: 100%;
  min-height: 100%;
  overflow-x: hidden;
  box-sizing: border-box;
}

/* pane 内 loading */
.pane-loading {
  padding: 80rpx 0;
  text-align: center;
  font-size: 24rpx;
  color: rgba(28, 27, 26, 0.4);
}

/* ─── 宏观区 ────────────────────────────────────────────────────────── */
.macro {
  padding: 16rpx 32rpx 32rpx;
  box-sizing: border-box;
  overflow: hidden;
}

.macro__primary {
  font-size: 80rpx;
  font-weight: 700;
  color: #1c1b1a;
  letter-spacing: -2rpx;
  line-height: 1.05;
}

.macro__secondary {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: rgba(28, 27, 26, 0.5);
}

.macro__sec-label {
  font-size: 24rpx;
  color: rgba(28, 27, 26, 0.5);
}

.macro__sec-value {
  font-size: 24rpx;
  color: rgba(28, 27, 26, 0.7);
  font-weight: 500;
}

.macro__sec-divider {
  color: rgba(28, 27, 26, 0.2);
  margin: 0 4rpx;
}

.macro__chart {
  margin-top: 24rpx;
  width: 100%;
}

/* ─── 摘要 4 格 ──────────────────────────────────────────────────────── */
.summary-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12rpx 24rpx;
  padding: 24rpx 32rpx 16rpx;
  box-sizing: border-box;
}

.summary-grid__item {
  padding: 12rpx 0;
  min-width: 0;  /* 允许 grid 子项收缩，使内部 ellipsis 生效 */
}

.summary-grid__value {
  font-size: 36rpx;
  font-weight: 600;
  color: #1c1b1a;
  line-height: 1.2;
  letter-spacing: -0.5rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.summary-grid__label {
  font-size: 22rpx;
  color: rgba(28, 27, 26, 0.5);
  margin-top: 4rpx;
}

/* ─── 月度流水（年度专有）· 2026-08-05 改版：莫兰迪三色线条 ────────────── */
.month-list {
  padding: 24rpx 32rpx 8rpx;
}

.month-list__title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1c1b1a;
  margin-bottom: 16rpx;
}

/* 图例：支出 / 收入 · 颜色与下方线条一致 */
.month-list__legend {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 16rpx;
  font-size: 22rpx;
  color: rgba(28, 27, 26, 0.55);
}

.month-list__legend-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.month-list__legend-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 4rpx;
  flex: none;
}

.month-list__legend-dot--expense { background: #AC7B6C; } /* 莫兰迪赤陶粉 */
.month-list__legend-dot--income  { background: #8FAA83; } /* 莫兰迪鼠尾草绿 */

.month-list__row {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid rgba(28, 27, 26, 0.06);
}

.month-list__row--empty {
  opacity: 0.4;
}

.month-list__label {
  flex: none;
  width: 80rpx;
  font-size: 26rpx;
  font-weight: 500;
  color: #1c1b1a;
}

/* 双行条形图容器 */
.month-list__bars {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 1rpx;
}

.month-list__bar-row {
  display: flex;
  align-items: center;
  height: 4rpx;
}

.month-list__bar-track {
  height: 100%;
  border-radius: 4rpx;
  /* width 由模板通过 inline style 按比例设置 */
  transition: width 0.25s ease;
}

.month-list__bar-track--expense { background: #AC7B6C; } /* 莫兰迪赤陶粉 · 支出 */
.month-list__bar-track--income  { background: #8FAA83; } /* 莫兰迪鼠尾草绿 · 收入 */

/* 数字行：三列等宽对齐，保证纵向"支/收/余"字对齐 */
.month-list__bar-numbers {
  margin-top: 6rpx;
  display: flex;
  font-size: 20rpx;
  color: rgba(28, 27, 26, 0.55);
  overflow: hidden;
  white-space: nowrap;
}

.month-list__bar-num {
  flex: 1;
  min-width: 0;
  font-size: 20rpx;
}

/* 空态行：仅显示"无记录"占位 */
.month-list__empty {
  flex: 1;
  display: flex;
  align-items: center;
}

.month-list__empty-text {
  font-size: 22rpx;
  color: rgba(28, 27, 26, 0.28);
}

.month-list__arrow {
  flex: none;
  font-size: 28rpx;
  color: rgba(28, 27, 26, 0.3);
  margin-left: 8rpx;
}

/* ─── 排行区 ────────────────────────────────────────────────────────── */
.rank {
  padding: 24rpx 32rpx 8rpx;
  overflow: hidden;
  box-sizing: border-box;
}

.rank__title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1c1b1a;
  margin-bottom: 16rpx;
}

.rank__row {
  padding: 20rpx 0 12rpx;
  border-bottom: 1rpx solid rgba(28, 27, 26, 0.06);
}

.rank__row-main {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.rank__icon {
  flex: none;
  font-family: "costra-icons";
  font-size: 32rpx;
  line-height: 1;
}

.rank__name {
  flex: 1;
  font-size: 28rpx;
  color: #1c1b1a;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.rank__amount {
  flex: none;
  font-size: 28rpx;
  font-weight: 500;
  color: #1c1b1a;
}

.rank__ratio {
  flex: none;
  font-size: 22rpx;
  color: rgba(28, 27, 26, 0.4);
  margin-left: 8rpx;
  min-width: 64rpx;
  text-align: right;
}

.rank__bar {
  margin-top: 8rpx;
  height: 4rpx;
  background: rgba(28, 27, 26, 0.06);
  border-radius: 4rpx;
  overflow: hidden;
}

.rank__bar-fill {
  height: 100%;
  background: #1c1b1a;
  border-radius: 4rpx;
  transition: width 0.3s ease;
}

.rank__more {
  padding: 16rpx 0;
  font-size: 22rpx;
  color: rgba(28, 27, 26, 0.4);
  text-align: center;
}

/* ─── L2 二级分类（手风琴展开） ─────────────────────────────────────── */
.l2 {
  background: rgba(28, 27, 26, 0.025);
  margin: 4rpx -32rpx 0;
  padding: 8rpx 32rpx 8rpx 56rpx;
  border-radius: 0;
}

.l2__row {
  padding: 16rpx 0 8rpx;
}

.l2__row + .l2__row {
  border-top: 1rpx solid rgba(28, 27, 26, 0.04);
}

.l2__row-main {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.l2__icon {
  flex: none;
  font-family: "costra-icons";
  font-size: 24rpx;
  line-height: 1;
}

.l2__name {
  flex: 1;
  font-size: 26rpx;
  color: rgba(28, 27, 26, 0.85);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.l2__amount {
  flex: none;
  font-size: 26rpx;
  color: rgba(28, 27, 26, 0.85);
  font-weight: 500;
}

.l2__ratio {
  flex: none;
  font-size: 20rpx;
  color: rgba(28, 27, 26, 0.4);
  margin-left: 8rpx;
  min-width: 56rpx;
  text-align: right;
}

.l2__bar {
  margin-top: 6rpx;
  height: 3rpx;
  background: rgba(28, 27, 26, 0.04);
  border-radius: 3rpx;
  overflow: hidden;
}

.l2__bar-fill {
  height: 100%;
  background: rgba(28, 27, 26, 0.5);
  border-radius: 3rpx;
}

.l2__more {
  padding: 12rpx 0;
  font-size: 20rpx;
  color: rgba(28, 27, 26, 0.4);
  text-align: center;
}

.l2__loading,
.l2__empty {
  padding: 16rpx 0;
  font-size: 22rpx;
  color: rgba(28, 27, 26, 0.4);
  text-align: center;
}

/* ─── L3 单笔明细 ──────────────────────────────────────────────────── */
.l3 {
  background: rgba(28, 27, 26, 0.04);
  margin: 4rpx -32rpx 4rpx -56rpx;
  padding: 4rpx 32rpx 4rpx 80rpx;
}

.l3__row {
  display: flex;
  align-items: center;
  padding: 14rpx 0;
  gap: 16rpx;
}

.l3__row + .l3__row {
  border-top: 1rpx solid rgba(28, 27, 26, 0.03);
}

.l3__avatar {
  position: relative;
  flex: none;
  width: 36rpx;
  height: 36rpx;
}

.l3__avatar-img {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: rgba(28, 27, 26, 0.06);
}

.l3__avatar-placeholder {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: rgba(28, 27, 26, 0.1);
  color: #1c1b1a;
  font-size: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.l3__main {
  flex: 1;
  min-width: 0;
}

.l3__top {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}

.l3__date {
  flex: none;
  font-size: 22rpx;
  color: rgba(28, 27, 26, 0.5);
  white-space: nowrap;
}

.l3__note {
  flex: 1;
  font-size: 24rpx;
  color: rgba(28, 27, 26, 0.85);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.l3__amount {
  flex: none;
  font-size: 24rpx;
  color: #1c1b1a;
  font-weight: 500;
}

.l3__bottom {
  margin-top: 4rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 20rpx;
  color: rgba(28, 27, 26, 0.4);
}

.l3__time {
  font-size: 20rpx;
  color: rgba(28, 27, 26, 0.4);
}

/* 「定时 / 公共」内联 tag（仅统计页 / 协作页排行区下钻列表使用）
 * 视觉参考历史版 .l3__shared：莫兰迪色字 + 12% 透明同色背景，圆角 4rpx，紧贴时间后。 */
.l3__tag {
  font-size: 20rpx;
  line-height: 1;
  padding: 4rpx 8rpx;
  border-radius: 4rpx;
  white-space: nowrap;
  font-weight: 500;
}

.l3__tag--recurring {
  color: #AD9168;
  background: rgba(173, 145, 104, 0.12);
}

.l3__tag--shared {
  color: #6B9B8F;
  background: rgba(107, 155, 143, 0.12);
}

.l3__more {
  padding: 12rpx 0;
  font-size: 20rpx;
  color: rgba(28, 27, 26, 0.4);
  text-align: center;
}

.l3__loading,
.l3__empty {
  padding: 16rpx 0;
  font-size: 20rpx;
  color: rgba(28, 27, 26, 0.4);
  text-align: center;
}

/* ─── 空态（与明细页统一）──────────────────────────────────────────── */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 200rpx;
  gap: 16rpx;
}

.empty-state__title {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--color-role-text-secondary, rgba(28,27,26,0.48));
}

.empty-state__hint {
  font-size: 26rpx;
  color: var(--color-role-text-tertiary, rgba(28,27,26,0.28));
}

/* ─── 等宽数字（金额显示用） ─────────────────────────────────────── */
.tnum {
  font-variant-numeric: tabular-nums;
  font-feature-settings: 'tnum';
}

/* ─── 底部留白（避开自定义 TabBar，属于 pane 内可横滑区域）──────────────
 * 高度由 JS 统一注入：固定 TabBar 空间 + 底部视觉安全区。 */

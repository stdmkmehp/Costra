/* pages/family/index.wxss · 家庭页样式 */
/* 卡号: COSTRA-302 · 协作页 multi 模式重构 */
/* 设计源: docs/design/family-page-tech-spec.md §4.8 */

@import '../../styles/invite-dialog.wxss';

.family {
  height: 100vh;
  background: #f1f2ec;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}

/* 导航栏（与明细页一致） */
/* 导航栏样式已迁入 <ledger-switcher> 组件 */

/* 固定头部：成员区 + 时间导航 + 进度占比（不随流水滚动） */
.family__fixed-header {
  flex: none;
  padding-left: 32rpx;
  padding-right: 32rpx;
  background: #f1f2ec;
}

/* 可滚动内容区 */
.family__scroll {
  flex: 1;
  min-height: 0; /* flex 子项允许收缩 · 兼容真机 scroll-view 高度计算 */
}

/* COSTRA-305: 底部内边距覆盖 fixed tabbar + 底部视觉安全区，防止最后一行被遮挡。
   padding-bottom 由 JS 统一注入，避免 CSS env 在不同机型/开发者工具下不一致。 */
.family__content {
  padding: 0 32rpx;
}

/* ═══════ Solo 态 ═══════ */

.solo-summary {
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 12rpx;
  padding: 28rpx 24rpx;
  margin-top: 48rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid var(--color-role-border-subtle, rgba(28,27,26,0.05));
}

.solo-summary__item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.solo-summary__label {
  font-size: 24rpx;
  color: var(--color-role-text-secondary, rgba(28,27,26,0.48));
  margin-bottom: 8rpx;
}

.solo-summary__value {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-role-text-primary, #1c1b1a);
}

.solo-summary__divider {
  width: 1rpx;
  height: 48rpx;
  background: var(--color-role-border-default, rgba(28,27,26,0.08));
}

.solo-cta-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 80rpx;
}

.solo-cta-area__hint {
  font-size: 28rpx;
  color: rgba(28,27,26,0.48);
  text-align: center;
  line-height: 1.6;
  padding: 0 32rpx;
  margin-bottom: 40rpx;
}

.solo-cta-area__btn {
  width: 60%;
  height: 80rpx;
  line-height: 80rpx;
  background: #07C160;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 600;
  border-radius: 8px;
  text-align: center;
  border: none;
  padding: 0;
}

.solo-cta-area__btn::after {
  border: none;
}

/* ═══════ Multi 态 ═══════ */

/* 成员与邀请区 (Avatar Row) */
.avatar-row {
  white-space: nowrap;
  width: 100%;
  /* 左右外扩 12rpx 抵消下方 inner 的左右内边距，保持头像视觉起点不变；
     目的是给高亮态（scale + box-shadow 描边环）留出溢出空间，避免首个头像左侧被 scroll-view 裁剪 */
  margin: 0 -12rpx 24rpx;
}

.avatar-row__inner {
  display: inline-flex;
  align-items: center;
  padding: 8rpx 12rpx;
}

.avatar-item {
  position: relative;
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.avatar-item__img {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: var(--color-role-bg-surface, #ffffff);
}

.avatar-item__placeholder {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: rgba(28,27,26,0.08);
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-item__placeholder-text {
  font-size: 28rpx;
  color: var(--color-role-text-secondary, rgba(28,27,26,0.48));
  font-weight: 500;
}

.avatar-item--left .avatar-item__img {
  filter: grayscale(1);
  opacity: 0.4;
}

.avatar-item--left {
  pointer-events: none;
}

.avatar-item__name {
  font-size: 20rpx;
  color: var(--color-role-text-tertiary, rgba(28,27,26,0.28));
  margin-top: 4rpx;
  white-space: nowrap;
}

/* 创建者标记（小绿点） */
.avatar-item__owner {
  position: absolute;
  top: 0;
  right: 0;
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #07C160;
  border: 2rpx solid #f1f2ec;
}

/* 邀请按钮（强制覆盖 button 默认样式，与头像同等 80rpx 正圆） */
.avatar-item--invite {
  width: 80rpx !important;
  height: 80rpx !important;
  min-height: 0 !important;
  min-width: 0 !important;
  max-width: 80rpx !important;
  max-height: 80rpx !important;
  border-radius: 50% !important;
  background: rgba(7,193,96,0.12);
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 0 !important;
  margin: 0;
  margin-right: 0;
  line-height: 1;
  border: none;
  box-sizing: border-box;
  overflow: hidden;
  font-size: 0;
}

.avatar-item--invite::after {
  border: none;
}

/* ─── 邀请按钮呼吸光环引导（方案 B · 仅在只有自己一人时叠加） ─────────────
 * 使用 box-shadow 双层脉冲：
 *   · 内层近距柔化环：始终存在，突出按钮为"可点击的活体"
 *   · 外层脉冲：ring 半径 + 透明度双通道循环，产生可见但不刺眼的心跳感
 * 关闭 overflow：base 类为了防 button 默认样式溢出用了 overflow: hidden，
 * 会裁掉外扩阴影；引导态改为 visible 让光环可见。
 * 相邻头像 margin-right: 24rpx 已提供足够外扩空间，不会与相邻头像重叠。
 */
.avatar-item--invite-hint {
  overflow: visible !important;
  animation: avatar-invite-pulse 1800ms ease-in-out infinite;
}

@keyframes avatar-invite-pulse {
  0% {
    box-shadow:
      0 0 0 0 rgba(7, 193, 96, 0.45),
      0 0 0 2rpx rgba(7, 193, 96, 0.22);
  }
  70% {
    box-shadow:
      0 0 0 16rpx rgba(7, 193, 96, 0),
      0 0 0 2rpx rgba(7, 193, 96, 0.22);
  }
  100% {
    box-shadow:
      0 0 0 0 rgba(7, 193, 96, 0),
      0 0 0 2rpx rgba(7, 193, 96, 0.22);
  }
}

/* 尊重系统"减少动效"偏好：仅保留静态柔化环，去掉脉冲 */
@media (prefers-reduced-motion: reduce) {
  .avatar-item--invite-hint {
    animation: none;
    box-shadow: 0 0 0 2rpx rgba(7, 193, 96, 0.28);
  }
}

.avatar-item__plus {
  font-size: 36rpx;
  color: #07C160;
  font-weight: 300;
  line-height: 1;
}

/* 时间导航区 */
.time-nav {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0 24rpx;
}

.time-nav__left {
  display: flex;
  align-items: center;
}

.time-nav__month {
  display: flex;
  align-items: center;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-role-text-primary, #1c1b1a);
  padding: 0 8rpx;
}

.time-nav__dropdown {
  font-size: 18rpx;
  margin-left: 6rpx;
  color: var(--color-role-text-tertiary, rgba(28,27,26,0.28));
}

/* 月度/年度切换 */
.time-nav__dimension {
  display: flex;
  align-items: center;
  gap: 4rpx;
  background: rgba(28,27,26,0.05);
  border-radius: 8rpx;
  padding: 4rpx;
}

.time-nav__dim-btn {
  font-size: 24rpx;
  padding: 8rpx 16rpx;
  border-radius: 6rpx;
  color: var(--color-role-text-secondary, rgba(28,27,26,0.48));
}

.time-nav__dim-btn--active {
  background: rgba(255,255,255,0.72);
  color: var(--color-role-text-primary, #1c1b1a);
  font-weight: 500;
}

.time-nav__dim-btn--disabled {
  color: var(--color-role-text-tertiary, rgba(28,27,26,0.2));
}

/* Segmented Bar */
.segment-bar {
  margin-bottom: 24rpx;
}

.segment-bar__track {
  display: flex;
  height: 16rpx;
  border-radius: 8rpx;
  overflow: hidden;
  background: rgba(28,27,26,0.05);
}

.segment-bar__segment {
  min-width: 4rpx;
  height: 100%;
  transition: flex 0.3s ease;
}

.segment-bar__legend {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 16rpx;
}

.segment-bar__legend-item {
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.segment-bar__legend-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.segment-bar__legend-label {
  font-size: 22rpx;
  color: var(--color-role-text-secondary, rgba(28,27,26,0.48));
}

.segment-bar__legend-amount {
  font-size: 22rpx;
  color: var(--color-role-text-primary, #1c1b1a);
  font-weight: 500;
}

/* 空态（与明细页统一） */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding-top: 200rpx;
  gap: 16rpx;
}

.empty-state__title {
  font-size: 30rpx;
  font-weight: 500;
  color: var(--color-role-text-secondary, rgba(28,27,26,0.48));
}

.empty-state__hint {
  font-size: 26rpx;
  color: var(--color-role-text-tertiary, rgba(28,27,26,0.28));
}

/* ─── 重构后下钻列表（COSTRA-302 · spec §4.8 · 统计页同款手风琴）─── */
.family-rank { padding: 24rpx 0 8rpx; box-sizing: border-box; }
.family-rank__row {
  padding: 28rpx 0 24rpx;
  border-bottom: 1rpx solid rgba(28,27,26,0.06);
}
.family-rank__row + .family-rank__row { margin-top: 8rpx; }
.family-rank__row--open { padding-bottom: 16rpx; }
.family-rank__head { display: flex; flex-direction: column; }
.family-rank__head-main { display: flex; align-items: center; gap: 16rpx; }
.family-rank__shared-icon {
  flex: none; width: 40rpx; height: 40rpx; border-radius: 50%;
  background: rgba(107,155,143,0.12); display: flex; align-items: center; justify-content: center;
}
.family-rank__shared-icon text { font-size: 20rpx; color: #6B9B8F; font-weight: 600; }
.family-rank__avatar { flex: none; width: 40rpx; height: 40rpx; border-radius: 50%; background: rgba(28,27,26,0.06); }
.family-rank__avatar--placeholder { display: flex; align-items: center; justify-content: center; color: rgba(28,27,26,0.48); font-size: 20rpx; }
.family-rank__name { flex: 1; font-size: 28rpx; color: #1c1b1a; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.family-rank__amount { flex: none; font-size: 28rpx; font-weight: 500; color: #1c1b1a; }
.family-rank__ratio { flex: none; font-size: 22rpx; color: rgba(28,27,26,0.4); margin-left: 8rpx; min-width: 64rpx; text-align: right; }
.family-rank__bar { margin-top: 8rpx; height: 4rpx; background: rgba(28,27,26,0.06); border-radius: 4rpx; overflow: hidden; }
.family-rank__bar-fill { height: 100%; border-radius: 4rpx; transition: width 0.3s ease; }

/* 等宽数字 */
.tnum { font-variant-numeric: tabular-nums; }

/* 公共行垫付贡献小字（行下常驻 · q4 决策 A） */
.shared-contributions {
  padding: 12rpx 0 0; font-size: 22rpx; color: rgba(28,27,26,0.5);
  overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
}

/* L1 子列表（视觉与统计页 .rank 行一致，作为子层） */
.family-l1 {
  background: rgba(28,27,26,0.025);
  margin: 12rpx 0 0;
  padding: 8rpx 0 8rpx 56rpx;
}
.family-l1__row { padding: 16rpx 0 8rpx; }
.family-l1__row + .family-l1__row { border-top: 1rpx solid rgba(28,27,26,0.04); }
.family-l1__row-main { display: flex; align-items: center; gap: 16rpx; }
.family-l1__icon { flex: none; font-family: "costra-icons"; font-size: 32rpx; line-height: 1; }
.family-l1__name { flex: 1; font-size: 28rpx; color: #1c1b1a; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.family-l1__amount { flex: none; font-size: 28rpx; font-weight: 500; color: #1c1b1a; }
.family-l1__ratio { flex: none; font-size: 20rpx; color: rgba(28,27,26,0.4); margin-left: 8rpx; min-width: 56rpx; text-align: right; }
.family-l1__bar { margin-top: 8rpx; height: 4rpx; background: rgba(28,27,26,0.06); border-radius: 4rpx; overflow: hidden; }
.family-l1__bar-fill { height: 100%; background: #1c1b1a; border-radius: 4rpx; }
.family-l1__more {
  padding: 16rpx 0 4rpx; font-size: 22rpx; color: rgba(28,27,26,0.4); text-align: center;
}

/* L1 展开态视觉反馈（COSTRA-305） */
.family-l1__row--open {
  background: rgba(28,27,26,0.015);
}

/* ─── L3 三级流水明细（COSTRA-305 · 移植统计页 .l3* 适配协作页缩进体系）─── */
.family-l3 {
  background: rgba(28,27,26,0.04);
  /* 协作页 .family-l1 已有 padding-left:56rpx 缩进 · L3 在 L1 内再缩进 24rpx */
  margin: 4rpx 0;
  padding: 4rpx 16rpx 4rpx 24rpx;
  border-radius: 4rpx;
}

.family-l3__row {
  display: flex;
  align-items: center;
  padding: 14rpx 0;
  gap: 16rpx;
}

.family-l3__row + .family-l3__row {
  border-top: 1rpx solid rgba(28,27,26,0.03);
}

.family-l3__avatar {
  position: relative;
  flex: none;
  width: 36rpx;
  height: 36rpx;
}

.family-l3__avatar-img {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: rgba(28,27,26,0.06);
}

.family-l3__avatar-placeholder {
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: rgba(28,27,26,0.1);
  color: #1c1b1a;
  font-size: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.family-l3__main {
  flex: 1;
  min-width: 0;
}

.family-l3__top {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}

.family-l3__date {
  flex: none;
  font-size: 22rpx;
  color: rgba(28,27,26,0.5);
  white-space: nowrap;
}

.family-l3__note {
  flex: 1;
  font-size: 24rpx;
  color: rgba(28,27,26,0.85);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.family-l3__amount {
  flex: none;
  font-size: 24rpx;
  color: #1c1b1a;
  font-weight: 500;
}

.family-l3__bottom {
  margin-top: 4rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 20rpx;
  color: rgba(28,27,26,0.4);
}

.family-l3__time {
  font-size: 20rpx;
  color: rgba(28,27,26,0.4);
}

.family-l3__badge {
  position: absolute;
  right: -6rpx;
  bottom: -6rpx;
  display: flex;
  align-items: center;
  gap: 1rpx;
  white-space: nowrap;
  pointer-events: none;
}

.family-l3__badge-text {
  font-size: 18rpx;
  line-height: 1;
  font-weight: 800;
  text-shadow:
    1rpx 0 0 var(--color-role-bg-app, #f1f2ec),
    -1rpx 0 0 var(--color-role-bg-app, #f1f2ec),
    0 1rpx 0 var(--color-role-bg-app, #f1f2ec),
    0 -1rpx 0 var(--color-role-bg-app, #f1f2ec),
    1rpx 1rpx 0 var(--color-role-bg-app, #f1f2ec),
    -1rpx -1rpx 0 var(--color-role-bg-app, #f1f2ec),
    1rpx -1rpx 0 var(--color-role-bg-app, #f1f2ec),
    -1rpx 1rpx 0 var(--color-role-bg-app, #f1f2ec);
}

.family-l3__badge-text--recurring {
  color: #A88A5E;
}

.family-l3__badge-text--shared {
  color: #6B9B8F;
}

.family-l3__more {
  padding: 12rpx 0;
  font-size: 20rpx;
  color: rgba(28,27,26,0.4);
  text-align: center;
}

.family-l3__loading,
.family-l3__empty {
  padding: 16rpx 0;
  font-size: 20rpx;
  color: rgba(28,27,26,0.4);
  text-align: center;
}

/* 加载态 */
.loading-state {
  display: flex;
  justify-content: center;
  padding: 80rpx 0;
}

.loading-state__text {
  font-size: 28rpx;
  color: var(--color-role-text-tertiary, rgba(28,27,26,0.28));
}

/* ═══════ 成员头像锚定气泡菜单（替代 showActionSheet · 对齐明细页 ctx-menu 视觉语言）═══════ */

/* 头像暖光环高亮（点头像时泛起 · 复用明细页「目标行暖光弱提醒」语义） */
.avatar-item__img,
.avatar-item__placeholder {
  transition: transform 200ms cubic-bezier(0.22, 1, 0.36, 1), box-shadow 200ms ease;
}
.avatar-item--active .avatar-item__img,
.avatar-item--active .avatar-item__placeholder {
  transform: scale(1.06);
  box-shadow: 0 0 0 4rpx #faf9f5, 0 0 0 7rpx rgba(28, 27, 26, 0.10);
}

/* 全屏透明遮罩：捕获点击关闭菜单，拦截滚动防穿透 */
.member-menu-overlay {
  position: fixed;
  inset: 0;
  z-index: 10000;
}

/* 气泡卡片：暖调浮起白 + 毛玻璃（与导航/明细页 ctx-menu 材质统一）。
   left/top 由 JS 按头像 boundingClientRect 计算（px），position:fixed 锚定视口。 */
.member-menu {
  position: fixed;
  z-index: 10001;
  width: 320rpx;
  background: rgba(250, 249, 245, 0.82);
  -webkit-backdrop-filter: blur(26rpx) saturate(180%);
  backdrop-filter: blur(26rpx) saturate(180%);
  border-radius: 20rpx;
  box-shadow: 0 10rpx 50rpx rgba(0, 0, 0, 0.16), 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
  padding: 8rpx 0;
  transform-origin: center top;
  animation: member-menu-in 180ms cubic-bezier(0.22, 1, 0.36, 1);
}

@supports not ((backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px))) {
  .member-menu { background: #faf9f5; }
}

@keyframes member-menu-in {
  from { opacity: 0; transform: scale(0.92) translateY(-6rpx); }
  to { opacity: 1; transform: scale(1) translateY(0); }
}

/* 顶部小三角：指向被点头像中心，left 由 JS 单独偏移 */
.member-menu__arrow {
  position: absolute;
  top: -12rpx;
  width: 0;
  height: 0;
  transform: translateX(-50%);
  border-left: 12rpx solid transparent;
  border-right: 12rpx solid transparent;
  border-bottom: 12rpx solid rgba(250, 249, 245, 0.92);
}

.member-menu__item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  height: 88rpx;
  padding: 0 24rpx;
  color: var(--color-role-text-primary, #1c1b1a);
  transition: background 120ms ease;
}

.member-menu__item:active {
  background: rgba(28, 27, 26, 0.06);
}

.member-menu__text {
  font-size: 30rpx;
  color: inherit;
  line-height: 1;
}

/* 破坏性项红色；仅在「中性项 → 破坏性项」过渡处加极浅内投影隔断（抛弃分割线） */
.member-menu__item--danger {
  color: var(--color-semantic-danger, #FA5151);
}
.member-menu__item:not(.member-menu__item--danger) + .member-menu__item--danger {
  margin-top: 6rpx;
  box-shadow: inset 0 1rpx 0 rgba(28, 27, 26, 0.05);
}

/* ── 图标容器（几何随 item color 变色，与明细页 ctx-ic 对齐方式统一）── */
.member-menu__ic {
  position: relative;
  width: 34rpx;
  min-width: 34rpx;
  height: 34rpx;
  flex-shrink: 0;
  color: inherit;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 重命名：文本框被 I-beam 光标从右侧贯穿断开（左右两段分离 · 光标偏右） */
.mm-rename {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 34rpx;
  height: 34rpx;
}
/* 文本框：被光标断开为左右两段（缺口留给光标穿过） */
.mm-rename__box {
  position: absolute;
  top: 8rpx;
  height: 18rpx;
  border: 2rpx solid currentColor;
  box-sizing: border-box;
}
/* 左段：较宽，右侧断开（无右边框） */
.mm-rename__box--l {
  left: 2rpx;
  width: 14rpx;
  border-right: none;
  border-radius: 3rpx 0 0 3rpx;
}
/* 右段：较窄，左侧断开（无左边框） */
.mm-rename__box--r {
  left: 26rpx;
  width: 6rpx;
  border-left: none;
  border-radius: 0 3rpx 3rpx 0;
}
/* I-beam 竖线：偏右、居中于 10rpx 缺口（中心 21rpx）、贯穿断口且高于文本框 */
.mm-rename__caret {
  position: absolute;
  left: 20rpx;
  top: 5rpx;
  width: 2rpx;
  height: 24rpx;
  background: currentColor;
}
/* 上下 serif 短横：宽 6rpx，相对竖线左偏 2rpx 即精确居中（(2-6)/2=-2rpx，均为整像素，杜绝取整偏移） */
.mm-rename__caret::before,
.mm-rename__caret::after {
  content: '';
  position: absolute;
  left: -2rpx;
  width: 6rpx;
  height: 2rpx;
  background: currentColor;
  border-radius: 1rpx;
}
.mm-rename__caret::before { top: 0; }
.mm-rename__caret::after { bottom: 0; }

/* 退出：门框（左·右开口）+ 向右穿出的线性箭头（横杆与 chevron 垂直居中对齐，修错位） */
.mm-leave__frame {
  position: absolute;
  left: 2rpx;
  top: 4rpx;
  width: 14rpx;
  height: 26rpx;
  border: 2rpx solid currentColor;
  border-right: none;
  border-radius: 3rpx 0 0 3rpx;
  box-sizing: border-box;
}
.mm-leave__arrow {
  position: absolute;
  left: 11rpx;
  top: 50%;
  margin-top: -1rpx;
  width: 17rpx;
  height: 2rpx;
  background: currentColor;
  border-radius: 2rpx;
}
/* chevron 箭头头（>）：用 margin-top 精确垂直居中于横杆，避免 translate+rotate 顺序导致错位 */
.mm-leave__arrow::after {
  content: '';
  position: absolute;
  right: -1rpx;
  top: 50%;
  margin-top: -5rpx;
  width: 9rpx;
  height: 9rpx;
  border-top: 2rpx solid currentColor;
  border-right: 2rpx solid currentColor;
  transform: rotate(45deg);
}

/* 解散：垃圾桶（flex 容器完全复刻明细页 ctx-ic--trash：盖 + 把手 + 桶身） */
.mm-trash {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 34rpx;
  height: 34rpx;
}
.mm-trash .lid {
  position: relative;
  width: 24rpx;
  height: 2rpx;
  background: currentColor;
  border-radius: 2rpx;
}
.mm-trash .lid::before {
  content: '';
  position: absolute;
  top: -5rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 12rpx;
  height: 5rpx;
  border: 2rpx solid currentColor;
  border-bottom: none;
  border-radius: 3rpx 3rpx 0 0;
  box-sizing: border-box;
}
.mm-trash .can {
  margin-top: 3rpx;
  width: 18rpx;
  height: 18rpx;
  border: 2rpx solid currentColor;
  border-top: none;
  border-radius: 0 0 5rpx 5rpx;
  box-sizing: border-box;
}

/* 移出：人形（头 + 肩）+ 右上减号（把成员移出，语义强于纯减号圆） */
.mm-person__head {
  position: absolute;
  top: 5rpx;
  left: 6rpx;
  width: 11rpx;
  height: 11rpx;
  border: 2rpx solid currentColor;
  border-radius: 50%;
  box-sizing: border-box;
}
.mm-person__body {
  position: absolute;
  top: 18rpx;
  left: 2rpx;
  width: 19rpx;
  height: 11rpx;
  border: 2rpx solid currentColor;
  border-bottom: none;
  border-radius: 10rpx 10rpx 0 0;
  box-sizing: border-box;
}
.mm-person__minus {
  position: absolute;
  top: 8rpx;
  right: 1rpx;
  width: 11rpx;
  height: 2rpx;
  background: currentColor;
  border-radius: 2rpx;
}

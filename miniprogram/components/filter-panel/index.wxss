/* components/filter-panel/index.wxss · 明细页筛选面板 */

.filter-panel {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 50;
  pointer-events: none;
  opacity: 0;
  transition: opacity 200ms ease-out;
}

.filter-panel.is-visible {
  pointer-events: auto;
  opacity: 1;
}

/* 透明蒙层 */
.filter-panel__mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(28, 27, 26, 0.06);
}

/* 面板主体：从顶部浮出 */
.filter-panel__body {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  background: var(--color-role-bg-app, #f1f2ec);
  border-bottom-left-radius: 24rpx;
  border-bottom-right-radius: 24rpx;
  box-shadow: 0 4rpx 24rpx rgba(28, 27, 26, 0.08);
  padding: 28rpx 32rpx 32rpx;
  transform: translateY(-100%);
  transition: transform 280ms cubic-bezier(0.25, 0.1, 0.25, 1);
  max-height: 70vh;
  overflow-y: auto;
}

.filter-panel.is-visible .filter-panel__body {
  transform: translateY(0);
}

/* 区块 */
.filter-section {
  margin-bottom: 24rpx;
}

.filter-section:last-child {
  margin-bottom: 0;
}

.filter-section__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.filter-section__title {
  font-size: 24rpx;
  color: rgba(28, 27, 26, 0.48);
  font-weight: 500;
  margin-bottom: 16rpx;
}

.filter-section__header .filter-section__title {
  margin-bottom: 0;
}

.filter-section__action {
  font-size: 24rpx;
  color: #576B95;
  font-weight: 500;
  padding: 8rpx 0;
}

/* ─── 搜索输入框 ─────────────────────────────────────────────────────────── */

.filter-search {
  display: flex;
  align-items: center;
  height: 64rpx;
  border-radius: 32rpx;
  background: rgba(28, 27, 26, 0.06);
  padding: 0 24rpx;
  margin-bottom: 24rpx;
}

.filter-search__icon {
  font-size: 28rpx;
  color: rgba(28, 27, 26, 0.36);
  margin-right: 12rpx;
  line-height: 1;
}

.filter-search__input {
  flex: 1;
  font-size: 26rpx;
  color: #1c1b1a;
  height: 100%;
}

.filter-search__placeholder {
  color: rgba(28, 27, 26, 0.36);
  font-size: 26rpx;
}

.filter-search__clear {
  padding: 8rpx;
  margin-left: 8rpx;
}

.filter-search__clear-icon {
  font-size: 24rpx;
  color: rgba(28, 27, 26, 0.36);
  line-height: 1;
}

/* ─── 胶囊标签 ────────────────────────────────────────────────────────────── */

.filter-chips {
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
}

.filter-chip {
  position: relative;
  padding: 12rpx 24rpx;
  border-radius: 9999rpx;
  background: rgba(28, 27, 26, 0.06);
  border: 2rpx solid transparent;
  transition: all 180ms ease;
  display: inline-flex;
  align-items: center;
  flex: 0 0 auto;
  max-width: 100%;
  box-sizing: border-box;
}

/* 选中态：与成员头像同款「绿色描边」+ 黑字 + 加重
   （不沿用 #1c1b1a 黑底高对比，与成员 #07C160 边框风格统一） */
.filter-chip.is-active {
  background: rgba(7, 193, 96, 0.08);
  border-color: #07C160;
}

.filter-chip__text {
  font-size: 24rpx;
  color: #1c1b1a;
  font-weight: 500;
}

.filter-chip.is-active .filter-chip__text {
  color: #1c1b1a;
  font-weight: 600;
}

/* 分类 Chip 内图标 */
.filter-chip__icon {
  font-size: 22rpx;
  margin-right: 6rpx;
  color: rgba(28, 27, 26, 0.6);
}

.filter-chip.is-active .filter-chip__icon {
  color: #1c1b1a;
}

/* 半选态：右上角小绿点（与成员选中色一致） */
.filter-chip.is-partial {
  position: relative;
}

.filter-chip__dot {
  position: absolute;
  top: 2rpx;
  right: 2rpx;
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #07C160;
  border: 2rpx solid #f1f2ec;
  box-sizing: border-box;
}

/* 展开态：底部加一条绿色下划线（与选中同色） */
.filter-chip.is-expanded {
  box-shadow: inset 0 -3rpx 0 0 #07C160;
}

/* 小号 Chip（二级分类用） */
.filter-chip--small {
  padding: 8rpx 18rpx;
}

.filter-chip--small .filter-chip__text {
  font-size: 22rpx;
}

/* ─── 二级展开区 ──────────────────────────────────────────────────────────── */

.filter-subcategories {
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid rgba(28, 27, 26, 0.08);
  animation: slideDown 200ms ease-out;
}

@keyframes slideDown {
  from { opacity: 0; transform: translateY(-8rpx); }
  to   { opacity: 1; transform: translateY(0); }
}

.filter-subcategories__divider {
  margin-bottom: 12rpx;
}

.filter-subcategories__label {
  font-size: 22rpx;
  color: rgba(28, 27, 26, 0.36);
}

/* ─── 成员头像网格 ────────────────────────────────────────────────────────── */

.filter-members {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 24rpx 32rpx;
  margin-top: 16rpx;
  justify-items: center;
}

.filter-member {
  position: relative;
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 180ms ease;
  opacity: 0.35;
}

.filter-member.is-selected {
  opacity: 1;
}

.filter-member__avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  border: 3rpx solid transparent;
  transition: border-color 180ms ease;
}

.filter-member.is-selected .filter-member__avatar {
  border-color: #07C160;
}

.filter-member__fallback {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: rgba(28, 27, 26, 0.08);
  display: flex;
  align-items: center;
  justify-content: center;
  border: 3rpx solid transparent;
  transition: border-color 180ms ease;
}

.filter-member.is-selected .filter-member__fallback {
  border-color: #07C160;
}

.filter-member__initial {
  font-size: 28rpx;
  color: rgba(28, 27, 26, 0.48);
  font-weight: 500;
}

/* 选中对勾 */
.filter-member__check {
  position: absolute;
  right: -2rpx;
  bottom: -2rpx;
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  background: #07C160;
  display: flex;
  align-items: center;
  justify-content: center;
}

.filter-member__check-icon {
  font-size: 18rpx;
  color: #ffffff;
  font-weight: 700;
  line-height: 1;
}

<!-- components/filter-panel/index.wxml · 明细页筛选面板 -->
<!-- 浮出式面板：搜索 + 类型 + 成员 + 分类（手风琴展开 + 长按 solo） -->

<view class="filter-panel {{visible ? 'is-visible' : ''}}">
  <!-- 透明蒙层：点击关闭面板 -->
  <view class="filter-panel__mask" bindtap="onTapMask" catchtouchmove="noop"></view>

  <!-- 面板主体 -->
  <view class="filter-panel__body" catchtap="noop">

    <!-- 搜索关键词 -->
    <view class="filter-search">
      <view class="filter-search__icon">
        <view class="filter-search__icon-search"></view>
      </view>
      <input
        class="filter-search__input"
        type="text"
        placeholder="搜索备注/分类名"
        placeholder-class="filter-search__placeholder"
        value="{{searchKeyword}}"
        bindinput="onSearchInput"
        confirm-type="search"
      />
      <view wx:if="{{searchKeyword}}" class="filter-search__clear" catchtap="onSearchClear">
        <text class="filter-search__clear-icon">✕</text>
      </view>
    </view>

    <!-- 流水类型 -->
    <view class="filter-section">
      <text class="filter-section__title">类型</text>
      <view class="filter-chips">
        <view
          class="filter-chip {{entryType === 'all' ? 'is-active' : ''}}"
          data-type="all"
          bindtap="onTapEntryType"
        >
          <text class="filter-chip__text">全部</text>
        </view>
        <view
          class="filter-chip {{entryType === 'personal' ? 'is-active' : ''}}"
          data-type="personal"
          bindtap="onTapEntryType"
        >
          <text class="filter-chip__text">个人支出</text>
        </view>
        <view
          class="filter-chip {{entryType === 'shared' ? 'is-active' : ''}}"
          data-type="shared"
          bindtap="onTapEntryType"
        >
          <text class="filter-chip__text">公共支出</text>
        </view>
        <view
          class="filter-chip {{entryType === 'income' ? 'is-active' : ''}}"
          data-type="income"
          bindtap="onTapEntryType"
        >
          <text class="filter-chip__text">收入</text>
        </view>
        <view
          class="filter-chip {{entryType === 'transfer' ? 'is-active' : ''}}"
          data-type="transfer"
          bindtap="onTapEntryType"
        >
          <text class="filter-chip__text">转移</text>
        </view>
      </view>
    </view>

    <!-- 成员筛选 -->
    <view class="filter-section" wx:if="{{members.length > 0}}">
      <view class="filter-section__header">
        <text class="filter-section__title">成员</text>
        <text class="filter-section__action" bindtap="onTapSelectAll">{{isAllSelected ? '取消全选' : '全选'}}</text>
      </view>
      <view class="filter-members">
        <view
          wx:for="{{members}}"
          wx:key="user_id"
          class="filter-member {{item.selected ? 'is-selected' : ''}}"
          data-userid="{{item.user_id}}"
          bindtap="onTapMember"
        >
          <image
            wx:if="{{item.avatar_url}}"
            class="filter-member__avatar"
            src="{{item.avatar_url}}"
            mode="aspectFill"
            lazy-load
          />
          <view wx:else class="filter-member__fallback">
            <text class="filter-member__initial">{{item.initial}}</text>
          </view>
          <!-- 选中对勾 -->
          <view wx:if="{{item.selected}}" class="filter-member__check">
            <text class="filter-member__check-icon">✓</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 分类筛选 -->
    <view class="filter-section" wx:if="{{categories.length > 0}}">
      <view class="filter-section__header">
        <text class="filter-section__title">分类</text>
        <text class="filter-section__action" bindtap="onTapCategoryToggle">{{categoryExpanded ? '收起' : '展开'}}</text>
      </view>

      <!-- 分类栏内容：收起时隐藏，仅保留标题行 -->
      <block wx:if="{{categoryExpanded}}">
      <!-- 一级 Chip 行 -->
      <view class="filter-chips">
        <!-- 全部 -->
        <view
          class="filter-chip {{categoryAllSelected ? 'is-active' : ''}}"
          bindtap="onTapCategoryAll"
        >
          <text class="filter-chip__text">全部</text>
        </view>
        <!-- 各一级分类 -->
        <view
          wx:for="{{categories}}"
          wx:key="id"
          class="filter-chip filter-chip--category {{item.status === 'all' ? 'is-active' : item.status === 'partial' ? 'is-active is-partial' : ''}} {{expandedCategoryId === item.id ? 'is-expanded' : ''}}"
          data-id="{{item.id}}"
          bindtap="onTapCategoryTier1"
          bindlongpress="onLongPressCategoryTier1"
        >
          <text class="filter-chip__text">{{item.name}}</text>
          <!-- 半选后缀：显示已选 N / 总 M -->
          <text wx:if="{{item.status === 'partial'}}" class="filter-chip__count">{{item.selectedCount}}/{{item.totalCount}}</text>
        </view>
      </view>

      <!-- 二级展开区（手风琴，最多展开1个） -->
      <view wx:if="{{expandedCategoryId}}" class="filter-subcategories">
        <view class="filter-subcategories__divider">
          <text class="filter-subcategories__label">{{expandedCategoryName}}</text>
        </view>
        <view class="filter-chips">
          <view
            class="filter-chip filter-chip--small {{expandedAllSelected ? 'is-active' : ''}}"
            data-parent="{{expandedCategoryId}}"
            bindtap="onTapSubcategoryAll"
          >
            <text class="filter-chip__text">全选</text>
          </view>
          <view
            wx:for="{{expandedSubcategories}}"
            wx:key="id"
            class="filter-chip filter-chip--small {{item.selected ? 'is-active' : ''}}"
            data-id="{{item.id}}"
            bindtap="onTapCategoryTier2"
          >
            <text class="filter-chip__text">{{item.name}}</text>
          </view>
        </view>
      </view>
      </block>
    </view>

  </view>
</view>

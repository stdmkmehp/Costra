<!-- components/filter-panel/index.wxml · 明细页筛选面板 -->
<!-- 浮出式面板：覆盖在流水列表上方，不推挤列表 -->

<view class="filter-panel {{visible ? 'is-visible' : ''}}">
  <!-- 透明蒙层：点击关闭面板 -->
  <view class="filter-panel__mask" bindtap="onTapMask" catchtouchmove="noop"></view>

  <!-- 面板主体 -->
  <view class="filter-panel__body" catchtap="noop">
    <!-- 费用性质 -->
    <view class="filter-section">
      <text class="filter-section__title">费用性质</text>
      <view class="filter-chips">
        <view
          class="filter-chip {{expenseType === 'all' ? 'is-active' : ''}}"
          data-type="all"
          bindtap="onTapExpenseType"
        >
          <text class="filter-chip__text">全部</text>
        </view>
        <view
          class="filter-chip {{expenseType === 'personal' ? 'is-active' : ''}}"
          data-type="personal"
          bindtap="onTapExpenseType"
        >
          <text class="filter-chip__text">个人支出</text>
        </view>
        <view
          class="filter-chip {{expenseType === 'shared' ? 'is-active' : ''}}"
          data-type="shared"
          bindtap="onTapExpenseType"
        >
          <text class="filter-chip__text">公共支出</text>
        </view>
      </view>
    </view>

    <!-- 成员筛选 -->
    <view class="filter-section">
      <view class="filter-section__header">
        <text class="filter-section__title">成员</text>
        <text class="filter-section__action" bindtap="onTapSelectAll">{{isAllSelected ? '取消全选' : '全选'}}</text>
      </view>
      <view class="filter-members">
        <view
          wx:for="{{members}}"
          wx:key="user_id"
          class="filter-member {{item.selected ? 'is-selected' : ''}}"
          data-userid="{{item.user_id}}"
          bindtap="onTapMember"
        >
          <image
            wx:if="{{item.avatar_url}}"
            class="filter-member__avatar"
            src="{{item.avatar_url}}"
            mode="aspectFill"
          />
          <view wx:else class="filter-member__fallback">
            <text class="filter-member__initial">{{item.initial}}</text>
          </view>
          <!-- 选中对勾 -->
          <view wx:if="{{item.selected}}" class="filter-member__check">
            <text class="filter-member__check-icon">✓</text>
          </view>
        </view>
      </view>
    </view>
  </view>
</view>

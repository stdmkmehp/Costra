/* components/recurring-yearly-picker/index.wxss */
.ryear { padding: 16rpx 0 24rpx; }
.ryear__months-row {
  position: relative;
  margin-bottom: 16rpx;
}
.ryear__months { white-space: nowrap; }
/* 左右渐隐蒙版：暗示可滑动，但不暗示可点击 */
.ryear__months-fade {
  position: absolute; top: 0; bottom: 0; width: 40rpx;
  pointer-events: none; z-index: 2;
}
.ryear__months-fade--left {
  left: 0;
  background: linear-gradient(to right, #ffffff 0%, rgba(255,255,255,0) 100%);
}
.ryear__months-fade--right {
  right: 0;
  background: linear-gradient(to left, #ffffff 0%, rgba(255,255,255,0) 100%);
}
.ryear__month-tab {
  display: inline-flex; position: relative; align-items: center; justify-content: center;
  min-width: 80rpx; height: 72rpx; font-size: 26rpx; font-weight: 500; color: #1c1b1a;
  border-radius: 36rpx; margin-right: 8rpx; padding: 0 12rpx;
}
.ryear__month-tab--active { background: #ffffff; border: 1rpx solid #1c1b1a; }
.ryear__month-badge {
  position: absolute; top: 0; right: 0; transform: translate(60%, -30%);
  width: 28rpx; height: 28rpx; border-radius: 50%; background: #8AA98F;
  font-size: 22rpx; color: #ffffff; display: flex; align-items: center; justify-content: center;
}
.ryear__day-grid { display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); gap: 12rpx; }
.ryear__day-tag {
  min-width: 0; height: 80rpx; border-radius: 20rpx; display: flex; align-items: center; justify-content: center;
  background: #ffffff; border: 1rpx solid rgba(28,27,26,0.12);
  font-size: 30rpx; font-weight: 500; color: #1c1b1a;
  transition: transform 120ms ease-out, border-color 120ms ease-out;
}
.ryear__day-tag--selected { background: #8AA98F; color: #ffffff; border-color: transparent; }
.ryear__day-tag--rejected {
  animation: ryear-shake 180ms ease-out, ryear-flash 120ms ease-out;
  border-color: #C08A7B;
}
@keyframes ryear-shake {
  0%, 100% { transform: translateX(0); }
  33% { transform: translateX(-8rpx); }
  66% { transform: translateX(8rpx); }
}
@keyframes ryear-flash {
  0%, 100% { background: #ffffff; }
  50% { background: #C08A7B; }
}
.ryear__summary-bar {
  display: flex; align-items: baseline; flex-wrap: wrap;
  background: rgba(28,27,26,0.03); border-radius: 16rpx; padding: 16rpx 24rpx; margin-top: 16rpx;
}
.ryear__summary-count { font-size: 26rpx; color: rgba(28,27,26,0.48); flex-shrink: 0; }
.ryear__summary-sep { font-size: 22rpx; color: rgba(28,27,26,0.20); margin: 0 12rpx; flex-shrink: 0; }
.ryear__count-bold { font-weight: 700; color: #8AA98F; }
.ryear__summary-list { font-size: 26rpx; color: rgba(28,27,26,0.48); flex: 1; }
.ryear__clear { font-size: 26rpx; color: rgba(28,27,26,0.48); margin-left: 16rpx; flex-shrink: 0; }
.ryear__clear--disabled { color: rgba(28,27,26,0.28); }
.ryear__hint { font-size: 22rpx; color: #A0A69C; margin-top: 16rpx; padding: 0 4rpx; }

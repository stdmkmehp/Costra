<!-- components/recurring-period-selector/index.wxml -->
<view wx:if="{{show}}" class="rps__mask" bindtap="onClose">
  <view class="rps__sheet" catchtap="onNoop">
    <view class="rps__title">选择周期</view>

    <!-- 每n周 -->
    <view class="rps__item {{periodType === 'weekly' ? 'rps__item--active' : ''}}"
          data-type="weekly" bindtap="onSelectType">
      <view class="rps__item-main">
        <text>每</text>
        <input wx:if="{{periodType === 'weekly'}}"
               class="rps__interval-input tnum" type="number"
               value="{{weekInterval}}" bindinput="onWeekIntervalInput"
               bindblur="onWeekIntervalBlur"
               catchtap="onNoop" />
        <text wx:else class="rps__interval-display">{{weekInterval}}</text>
        <text>周</text>
      </view>
      <text wx:if="{{periodType === 'weekly'}}" class="rps__check">✓</text>
    </view>

    <!-- 每n月 -->
    <view class="rps__item {{periodType === 'monthly' ? 'rps__item--active' : ''}}"
          data-type="monthly" bindtap="onSelectType">
      <view class="rps__item-main">
        <text>每</text>
        <input wx:if="{{periodType === 'monthly'}}"
               class="rps__interval-input tnum" type="number"
               value="{{monthInterval}}" bindinput="onMonthIntervalInput"
               bindblur="onMonthIntervalBlur"
               catchtap="onNoop" />
        <text wx:else class="rps__interval-display">{{monthInterval}}</text>
        <text>月</text>
      </view>
      <text wx:if="{{periodType === 'monthly'}}" class="rps__check">✓</text>
    </view>

    <!-- 每年 -->
    <view class="rps__item {{periodType === 'yearly' ? 'rps__item--active' : ''}}"
          data-type="yearly" bindtap="onSelectType">
      <view class="rps__item-main">
        <text>每年</text>
      </view>
      <text wx:if="{{periodType === 'yearly'}}" class="rps__check">✓</text>
    </view>

    <view class="rps__cancel" bindtap="onClose">取消</view>
  </view>
</view>

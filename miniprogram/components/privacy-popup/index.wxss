.privacy-popup__mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
}

.privacy-popup__card {
  background: #fff;
  border-radius: 24rpx;
  margin: 0 48rpx;
  padding: 48rpx 40rpx 40rpx;
}

.privacy-popup__title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1c1b1a;
  text-align: center;
  margin-bottom: 24rpx;
}

.privacy-popup__brand {
  font-weight: 600;
  color: #1c1b1a;
}

.privacy-popup__body {
  font-size: 28rpx;
  color: #666;
  line-height: 1.7;
  margin-bottom: 20rpx;
}

.privacy-popup__link {
  font-size: 26rpx;
  color: #07c160;
  text-align: center;
  margin-bottom: 40rpx;
  text-decoration: underline;
}

.privacy-popup__actions {
  display: flex;
  gap: 24rpx;
}

.privacy-popup__btn {
  flex: 1;
  height: 88rpx;
  border-radius: 44rpx;
  font-size: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  padding: 0;
  margin: 0;
}

.privacy-popup__btn--reject {
  background: #f5f5f5;
  color: #666;
}

.privacy-popup__btn--agree {
  background: #1c1b1a;
  color: #fff;
}

.privacy-popup__btn--agree::after {
  border: none;
}

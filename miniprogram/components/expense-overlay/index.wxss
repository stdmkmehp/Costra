/* components/expense-overlay/index.wxss · 全屏记账覆盖层（COSTRA-208 完全重写） */
/* 卡号: COSTRA-208 · 从需求出发重新实现 · flex scroll 布局 */
/* 设计源: design/ui/design_spec.md §6.3 + design/ui/interaction_flow.md §2/§3 */

/* ═══════════════════════════════════════════════════════════════
   覆盖层容器
   ═══════════════════════════════════════════════════════════════ */

.expense-overlay {
  position: fixed;
  inset: 0;
  z-index: 9999;
  background: #f1f2ec;
  transform: translateY(100%);
  transition: transform 350ms cubic-bezier(0.25, 0.1, 0.25, 1);
}

.expense-overlay.is-visible {
  transform: translateY(0);
}

/* ═══════════════════════════════════════════════════════════════
   Shell：flex column 主容器（100vh 高度锚定）
   ═══════════════════════════════════════════════════════════════ */

.expense-shell {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #f1f2ec;
}

/* ═══════════════════════════════════════════════════════════════
   顶部 Header：取消按钮 | 支出·收入指示器 | 占位
   ═══════════════════════════════════════════════════════════════ */

.expense-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-shrink: 0;
  padding: 16rpx 32rpx;
  padding-top: calc(env(safe-area-inset-top) + 8rpx);
}

.expense-header__close {
  color: rgba(28, 27, 26, 0.48);
  font-size: 28rpx;
  line-height: 1;
  padding: 12rpx 8rpx;
  margin-left: -8rpx;
}

.expense-header__tabs {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
}

.expense-header__tab {
  font-size: 28rpx;
  color: rgba(28, 27, 26, 0.28);
  font-weight: 400;
  transition: color 150ms cubic-bezier(0.25, 0.1, 0.25, 1),
              font-weight 150ms cubic-bezier(0.25, 0.1, 0.25, 1);
  padding: 4rpx 0;
}

.expense-header__tab.is-active {
  color: #1c1b1a;
  font-weight: 600;
}

.expense-header__sep {
  font-size: 28rpx;
  color: rgba(28, 27, 26, 0.18);
  line-height: 1;
  margin-top: 2rpx;
}

.expense-header__placeholder {
  width: 80rpx;
}

/* ═══════════════════════════════════════════════════════════════
   分类滚动区（flex:1 自动填满剩余空间 · 禁止 JS 计算高度）
   ═══════════════════════════════════════════════════════════════ */

.category-scroll {
  flex: 1;
  min-height: 0;
  width: 100%;
  box-sizing: border-box;
  padding: 0 28rpx;
}

/* ═══════════════════════════════════════════════════════════════
   分类 Section 容器
   ═══════════════════════════════════════════════════════════════ */

.category-section {
  padding: 8rpx 0;
}

.category-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx 0;
}

/* ═══════════════════════════════════════════════════════════════
   一级分类项
   ═══════════════════════════════════════════════════════════════ */

.category-tier1 {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 16rpx 8rpx;
  transition: opacity 250ms cubic-bezier(0.25, 0.1, 0.25, 1);
}

.category-tier1.is-dimmed {
  opacity: 0.2;
}

.category-tier1.is-selected .category-tier1__icon {
  background: #1c1b1a;
  color: #ffffff;
}

.category-tier1.is-selected .category-tier1__name {
  color: #1c1b1a;
  font-weight: 600;
}

.category-tier1__icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: rgba(28, 27, 26, 0.06);
  color: rgba(28, 27, 26, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 500;
  transition: background 150ms cubic-bezier(0.25, 0.1, 0.25, 1),
              color 150ms cubic-bezier(0.25, 0.1, 0.25, 1);
}

.category-tier1__name {
  font-size: 22rpx;
  color: rgba(28, 27, 26, 0.6);
  text-align: center;
  line-height: 1.2;
  transition: color 150ms cubic-bezier(0.25, 0.1, 0.25, 1);
}

/* ═══════════════════════════════════════════════════════════════
   分隔线
   ═══════════════════════════════════════════════════════════════ */

.category-divider {
  height: 1rpx;
  background: rgba(28, 27, 26, 0.05);
  margin: 16rpx 0;
}

/* ═══════════════════════════════════════════════════════════════
   二级分类项（去重全局列表 / 展开的子分类 共用）
   ═══════════════════════════════════════════════════════════════ */

.category-section--tier2 {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12rpx 0;
  padding: 8rpx 0 32rpx;
}

.category-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  padding: 12rpx 8rpx;
}

.category-item.is-selected .category-item__icon {
  background: #07C160;
  color: #ffffff;
}

.category-item.is-selected .category-item__name {
  color: #07C160;
  font-weight: 600;
}

.category-item__icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: rgba(28, 27, 26, 0.04);
  color: rgba(28, 27, 26, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 500;
  transition: background 150ms cubic-bezier(0.25, 0.1, 0.25, 1),
              color 150ms cubic-bezier(0.25, 0.1, 0.25, 1);
}

.category-item__name {
  font-size: 20rpx;
  color: rgba(28, 27, 26, 0.5);
  text-align: center;
  line-height: 1.2;
  transition: color 150ms cubic-bezier(0.25, 0.1, 0.25, 1);
}

/* ═══════════════════════════════════════════════════════════════
   底部安全区占位（无键盘时让分类内容可以滚动到屏幕最底端）
   ═══════════════════════════════════════════════════════════════ */

.category-bottom-spacer {
  height: env(safe-area-inset-bottom);
  min-height: 40rpx;
}

/* ═══════════════════════════════════════════════════════════════
   键盘面板（作为 shell 最后一个 flex 子项，出现时 scroll-view 自动变矮）
   ═══════════════════════════════════════════════════════════════ */

.keypad-sheet {
  flex-shrink: 0;
  background: #ffffff;
  border-top-left-radius: 24rpx;
  border-top-right-radius: 24rpx;
  padding-bottom: env(safe-area-inset-bottom);
  max-height: 70vh;
  overflow: hidden;
}

/* ═══════════════════════════════════════════════════════════════
   金额显示区
   ═══════════════════════════════════════════════════════════════ */

.keypad-sheet__amount {
  display: flex;
  align-items: baseline;
  padding: 24rpx 32rpx 16rpx;
  min-height: 80rpx;
}

.keypad-sheet__prefix {
  font-size: 32rpx;
  color: rgba(28, 27, 26, 0.48);
  margin-right: 8rpx;
  font-weight: 500;
}

.keypad-sheet__value {
  font-size: 56rpx;
  font-weight: 600;
  color: #1c1b1a;
  line-height: 1.2;
  letter-spacing: -1rpx;
  word-break: break-all;
}

.keypad-sheet__value.is-result {
  color: #07C160;
}

/* ═══════════════════════════════════════════════════════════════
   操作行
   ═══════════════════════════════════════════════════════════════ */

.keypad-sheet__actions {
  display: flex;
  align-items: center;
  padding: 0 32rpx 16rpx;
  gap: 16rpx;
  min-height: 56rpx;
}

/* 账本切换 */
.keypad-ledger {
  flex-shrink: 0;
}

.keypad-ledger__text {
  font-size: 22rpx;
  color: rgba(28, 27, 26, 0.36);
}

/* 费用性质开关 */
.keypad-shared {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-shrink: 0;
  opacity: 0;
  height: 0;
  overflow: hidden;
  transition: opacity 250ms cubic-bezier(0.25, 0.1, 0.25, 1),
              height 250ms cubic-bezier(0.25, 0.1, 0.25, 1);
}

.keypad-shared.is-visible {
  opacity: 1;
  height: 40rpx;
}

.keypad-shared__text {
  font-size: 22rpx;
  color: rgba(28, 27, 26, 0.36);
  transition: color 150ms cubic-bezier(0.25, 0.1, 0.25, 1);
}

.keypad-shared__text.is-active {
  color: #1c1b1a;
  font-weight: 600;
}

.keypad-shared__sep {
  font-size: 22rpx;
  color: rgba(28, 27, 26, 0.12);
}

/* 备注 */
.keypad-note {
  flex: 1;
  min-width: 0;
}

.keypad-note__placeholder {
  font-size: 22rpx;
  color: rgba(28, 27, 26, 0.28);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.keypad-note__input {
  flex: 1;
  font-size: 22rpx;
  color: #1c1b1a;
  min-height: 40rpx;
}

/* ═══════════════════════════════════════════════════════════════
   数字键盘
   ═══════════════════════════════════════════════════════════════ */

.keypad {
  padding: 0 8rpx 8rpx;
}

.keypad__row {
  display: flex;
  width: 100%;
}

.keypad__key {
  flex: 1;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 4rpx;
  border-radius: 12rpx;
  background: rgba(28, 27, 26, 0.04);
  font-size: 36rpx;
  color: #1c1b1a;
  font-weight: 500;
  transition: background 150ms cubic-bezier(0.25, 0.1, 0.25, 1);
}

.keypad__key:active {
  background: rgba(28, 27, 26, 0.1);
}

.keypad__key--fn {
  background: rgba(28, 27, 26, 0.08);
  font-size: 32rpx;
}

.keypad__key--action {
  font-size: 28rpx;
  font-weight: 600;
}

.keypad__key--done {
  background: #07C160;
  color: #ffffff;
}

.keypad__key--done:active {
  background: #06ad56;
}

.keypad__key--equals {
  background: rgba(28, 27, 26, 0.12);
  color: #1c1b1a;
  font-size: 40rpx;
  font-weight: 700;
}

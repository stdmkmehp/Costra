/* components/expense-overlay/index.wxss · 全屏记账覆盖层（COSTRA-208 完全重写 · COSTRA-214 安全区标准化） */
/* 卡号: COSTRA-208 / COSTRA-214 · 从需求出发重新实现 · flex scroll 布局 · 统一安全区 */
/* 设计源: design/ui/design_spec.md §6.3 + design/ui/interaction_flow.md §2/§3 */

/* ═══════════════════════════════════════════════════════════════
   覆盖层容器
   ═══════════════════════════════════════════════════════════════ */

.expense-overlay {
  position: fixed;
  inset: 0;
  z-index: 9999;
  background: #f1f2ec;
  transform: translateY(100%);
  /* 反首帧闪烁（2026-07-02）：transition 不再常驻基类。
   * 每个 Tab 页各挂一份 overlay 实例，首次挂载时存在「先按默认位置(translateY 0)绘制、
   * 再应用 WXSS transform(100%)」的时序窗口，若 transition 常驻，此窗口会把 overlay
   * 动画成从可见位置向下滑走 → 底部露出「支出·收入·转移」header 的闪烁。
   * 改由 .expense-overlay--animatable 承载 transition：挂载帧无此类 → 静止态直接就位无动画；
   * 用户真正打开面板时（_show/openEditMode）才置 animatable=true 开启过渡。 */
}

/* 反首帧位置闪现（2026-07-02 再修）：即便无 transition，微信新页面首帧仍可能先按
 * 默认位置(translateY 0)绘制一帧再套上 transform → 覆盖层闪现。
 * 「从未打开过」的实例(尚无 --animatable)一律 visibility:hidden，彻底不可见，
 * 无论 transform 何时落地都不闪；一旦用户打开(animatable=true)则解除，开合滑动照常。
 * 因 is-visible 只可能在 _show/openEditMode 置 animatable=true 之后出现，两者不会冲突。 */
.expense-overlay:not(.expense-overlay--animatable) {
  visibility: hidden;
}

/* 过渡开关：用户真正打开面板时开启，避免首帧被动画化（2026-07-02） */
.expense-overlay--animatable {
  transition: transform 350ms cubic-bezier(0.25, 0.1, 0.25, 1);
}

.expense-overlay.is-visible {
  transform: translateY(0);
}

/* ═══════════════════════════════════════════════════════════════
   Shell：flex column 主容器（100vh 高度锚定）
   ═══════════════════════════════════════════════════════════════ */

.expense-shell {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #f1f2ec;
}

/* ═══════════════════════════════════════════════════════════════
   顶部 Header：取消按钮 | 支出·收入指示器 | 占位
   COSTRA-214: padding-top 由 JS inline style 驱动（safeAreaTop + 4px），
   不再使用 CSS env(safe-area-inset-top)（开发者工具与真机不一致）
   ═══════════════════════════════════════════════════════════════ */

.expense-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-shrink: 0;
  padding: 0 32rpx 16rpx;
  /* padding-top 完全由 inline style 控制（对齐胶囊按钮顶部） */
}

.expense-header__close {
  color: rgba(28, 27, 26, 0.48);
  font-size: 28rpx;
  line-height: 1;
  padding: 12rpx 8rpx;
  margin-left: -8rpx;
}

.expense-header__tabs {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
}

/* COSTRA-227: 编辑模式下收支切换禁用态 */
.expense-header__tabs.is-disabled {
  opacity: 0.4;
  pointer-events: none;
}

/* COSTRA-229: tab 改为 column flex 承载文字 + 短线指示器（仿 statistics member-strip）。
 * 指示器用绝对定位脱离文档流，不参与 header 高度计算 → 避免顶部"取消"按钮被
 * align-items:center 的 expense-header 父容器带偏（保持与改造前完全一致的纵向位置）。 */
.expense-header__tab {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 4rpx 0;
}

.expense-header__tab-text {
  font-size: 34rpx;
  color: rgba(28, 27, 26, 0.28);
  font-weight: 400;
  line-height: 1;
  transition: color 150ms cubic-bezier(0.25, 0.1, 0.25, 1),
              font-weight 150ms cubic-bezier(0.25, 0.1, 0.25, 1);
}

.expense-header__tab.is-active .expense-header__tab-text {
  color: #1c1b1a;
  font-weight: 600;
}

/* 黑色短线指示器：绝对定位悬挂在 tab 文字下方 8rpx，未激活透明 */
.expense-header__tab-indicator {
  position: absolute;
  left: 50%;
  bottom: -12rpx;
  transform: translateX(-50%);
  width: 24rpx;
  height: 4rpx;
  border-radius: 2rpx;
  background: transparent;
  transition: background 200ms cubic-bezier(0.25, 0.1, 0.25, 1);
}

.expense-header__tab.is-active .expense-header__tab-indicator {
  background: #1c1b1a;
}

.expense-header__sep {
  font-size: 34rpx;
  color: rgba(28, 27, 26, 0.18);
  line-height: 1;
  margin-top: 2rpx;
}

.expense-header__placeholder {
  width: 80rpx;
}

/* ═══════════════════════════════════════════════════════════════
   分类区 swiper（COSTRA-228）
   收支跟手切换：swiper 占满 header 与 keypad 之间的弹性空间，
   每个 swiper-item 内套独立 scroll-view 承载分类网格。
   ═══════════════════════════════════════════════════════════════ */

.category-swiper {
  flex: 1;
  min-height: 0;
  width: 100%;
}

/* ═══════════════════════════════════════════════════════════════
   分类滚动区（每个 swiper-item 内一个 · 高度 100% 撑满 swiper）
   ═══════════════════════════════════════════════════════════════ */

.category-scroll {
  height: 100%;
  width: 100%;
  box-sizing: border-box;
  padding: 0 28rpx;
}

/* ═══════════════════════════════════════════════════════════════
   分类网格（公共样式 · COSTRA-227 抽取）
   ═══════════════════════════════════════════════════════════════ */

@import '../../styles/category-grid.wxss';

/* ═══════════════════════════════════════════════════════════════
   底部安全区占位（无键盘时让分类内容可以滚动到屏幕最底端）
   COSTRA-214: 高度由 JS inline style 驱动（safeAreaBottom px），
   不再使用 CSS env(safe-area-inset-bottom)
   ═══════════════════════════════════════════════════════════════ */

.category-bottom-spacer {
  /* 高度由 inline style 覆盖，此处保留 min-height fallback */
  min-height: 20rpx;
}

/* ═══════════════════════════════════════════════════════════════
   键盘面板（作为 shell 最后一个 flex 子项，出现时 scroll-view 自动变矮）
   COSTRA-214: padding-bottom 由 JS inline style 驱动（safeAreaBottom px），
   不再使用 CSS env(safe-area-inset-bottom)
   ═══════════════════════════════════════════════════════════════ */

/* COSTRA-227: keypadOnly 模式占位（将键盘推到底部） */
.keypad-spacer {
  flex: 1;
}

.keypad-sheet {
  flex-shrink: 0;
  background: #ffffff;
  border-top-left-radius: 24rpx;
  border-top-right-radius: 24rpx;
  /* padding-bottom 由 inline style 覆盖，此处保留 fallback 值 */
  /* 2026-07-16: 键盘由 4 行扩至 5 行，max-height 从 70vh 放宽到 78vh，避免小屏被挤压 */
  max-height: 78vh;
  overflow: hidden;
  /* 备注输入时由 JS keypadOffsetY 驱动 inline transform 移动，使系统键盘从操作行下沿开始
   * 遮盖数字键盘区。transform 不参与 flex 布局流 + 数字键盘常驻使 keypad-sheet
   * 高度恒定 → 上方 header / 分类滚动容器高度不变，分类区绝对静止无抖动。
   * transition-duration 由 inline style（keypadTransitionMs）动态驱动：取系统键盘动画时长，
   * 使面板与键盘同时长同步升降；拿不到时长则为 0ms 瞬间到位。 */
  transition-property: transform;
  transition-timing-function: cubic-bezier(0.25, 0.1, 0.25, 1);
}

/* ═══════════════════════════════════════════════════════════════
   键盘面板（公共样式 · COSTRA-227 抽取）
   ═══════════════════════════════════════════════════════════════ */

@import '../../styles/keypad.wxss';

/* ═══════════════════════════════════════════════════════════════
   操作行业务样式已全部移至 styles/keypad.wxss
   expense-overlay 与 ledger 编辑金额面板共享同一套样式
   ═══════════════════════════════════════════════════════════════ */

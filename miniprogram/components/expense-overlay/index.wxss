/* components/expense-overlay/index.wxss · 全屏记账覆盖层 */
/* 卡号: COSTRA-204/206 · 设计源: design/ui/design_spec.md §6.3 */
/* COSTRA-206: 修复底部绿色残留+全屏分类初始态+文字指示器+关闭按钮避让胶囊 */

/* ─── 覆盖层容器 ────────────────────────────────────────────────────────────── */

.overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  /* 暖灰白背景 · 对齐 tokens role.bg.app */
  background: #f1f2ec;
  /* COSTRA-205/206: z-index 必须高于 TabBar(999) + 确保完全遮盖底部绿色 [+] 按钮 */
  z-index: 9999;
  transform: translateY(100%);
  transition: transform var(--animation-slow, 350ms) var(--easing-default, cubic-bezier(0.25, 0.1, 0.25, 1));
  /* 问题1修复：确保背景完全不透明，彻底遮盖底层 tab-bar 的任何残留 */
  opacity: 1;
}

.overlay--visible {
  transform: translateY(0);
}

.overlay__content {
  display: flex;
  flex-direction: column;
  height: 100%;
  /* 关键：确保内容区域延伸到安全区最底部（修复问题1：底部绿色残留） */
  padding-bottom: 0;
  box-sizing: border-box;
}

/* ─── 顶部 header：三栏布局（取消按钮 | 支出·收入指示器 | 占位） ──────── */

.overlay__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  /* 使用 getMenuButtonBoundingClientRect 动态设置 padding-top */
  padding: 16rpx 32rpx;
  padding-top: calc(env(safe-area-inset-top) + 8rpx);
  flex-shrink: 0;
  /* 问题4修复：不再右对齐关闭按钮，改为左对齐"取消"，避开右侧胶囊 */
}

.overlay__close {
  /* 问题4修复："取消" 文字替代 ✕ 符号，左上角显示 */
  color: rgba(28, 27, 26, 0.48);
  font-size: 28rpx;
  line-height: 1;
  padding: 12rpx 8rpx;
  margin-left: -8rpx; /* 抵消 padding 使文字位置精确 */
}

/* ─── 收支文字指示器（替换原来的两个圆点）──────────────────────────────── */

.overlay__tab-indicator {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
}

.tab-indicator__text {
  font-size: 28rpx;
  color: rgba(28, 27, 26, 0.28);
  font-weight: 400;
  transition: color var(--animation-fast, 150ms) var(--easing-default, cubic-bezier(0.25, 0.1, 0.25, 1)),
              font-weight var(--animation-fast, 150ms) var(--easing-default, cubic-bezier(0.25, 0.1, 0.25, 1));
  padding: 4rpx 0;
}

.tab-indicator__text--active {
  color: #1c1b1a;
  font-weight: 600;
}

.tab-indicator__sep {
  font-size: 28rpx;
  color: rgba(28, 27, 26, 0.18);
  line-height: 1;
  margin-top: 2rpx;
}

/* 右侧占位：保持 header 三栏布局平衡 */
.overlay__header-placeholder {
  width: 80rpx; /* 与左侧 "取消" 按钮大致等宽 */
}

/* ─── Swiper 分类区域（COSTRA-206: swiper 不响应 flex:1，高度由 JS 动态计算） ─── */

.overlay__swiper {
  /* 高度通过 style="height: {{swiperHeight}}px;" 动态设置 */
  overflow: hidden;
}

.category-scroll {
  height: 100%;
  padding: 0 24rpx;
  /* 问题2修复：scroll-view 必须占满 swiper-item 全高 */
  box-sizing: border-box;
}

/* 底部安全区占位（无键盘时让分类内容可以滚动到屏幕最底端） */
.category-scroll__padding-bottom {
  height: env(safe-area-inset-bottom);
  min-height: 40rpx; /* 即使无 safe-area 也保留一点呼吸空间 */
}

/* ─── 一级分类网格 ──────────────────────────────────────────────────────────── */

.tier1-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx 0;
  padding: 8rpx 0;
}

.tier1-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 16rpx 8rpx;
  transition: opacity var(--animation-normal, 250ms) var(--easing-default, cubic-bezier(0.25, 0.1, 0.25, 1));
}

.tier1-item--dimmed {
  opacity: 0.2;
}

.tier1-item--selected .tier1-icon {
  background: #1c1b1a;
  color: #ffffff;
}

.tier1-item--selected .tier1-name {
  color: #1c1b1a;
  font-weight: 600;
}

.tier1-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: rgba(28, 27, 26, 0.06);
  color: rgba(28, 27, 26, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 500;
  transition: background var(--animation-fast, 150ms) var(--easing-default, cubic-bezier(0.25, 0.1, 0.25, 1)),
              color var(--animation-fast, 150ms) var(--easing-default, cubic-bezier(0.25, 0.1, 0.25, 1));
}

.tier1-name {
  font-size: 22rpx;
  color: rgba(28, 27, 26, 0.6);
  text-align: center;
  line-height: 1.2;
  transition: color var(--animation-fast, 150ms) var(--easing-default, cubic-bezier(0.25, 0.1, 0.25, 1));
}

/* ─── 分隔线 ────────────────────────────────────────────────────────────────── */

.tier-divider {
  height: 1rpx;
  background: rgba(28, 27, 26, 0.05);
  margin: 16rpx 0;
}

/* ─── 二级分类网格（去重全局列表）────────────────────────────────────────────── */

.sub-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12rpx 0;
  padding: 8rpx 0 32rpx;
}

/* ─── 展开的子分类 ──────────────────────────────────────────────────────────── */

.expanded-children {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12rpx 0;
  padding: 8rpx 0 32rpx;
}

/* ─── 二级分类项 ────────────────────────────────────────────────────────────── */

.sub-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  padding: 12rpx 8rpx;
}

.sub-item--selected .sub-icon {
  background: #07C160;
  color: #ffffff;
}

.sub-item--selected .sub-name {
  color: #07C160;
  font-weight: 600;
}

.sub-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: rgba(28, 27, 26, 0.04);
  color: rgba(28, 27, 26, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 500;
  transition: background var(--animation-fast, 150ms) var(--easing-default, cubic-bezier(0.25, 0.1, 0.25, 1)),
              color var(--animation-fast, 150ms) var(--easing-default, cubic-bezier(0.25, 0.1, 0.25, 1));
}

.sub-name {
  font-size: 20rpx;
  color: rgba(28, 27, 26, 0.5);
  text-align: center;
  line-height: 1.2;
  transition: color var(--animation-fast, 150ms) var(--easing-default, cubic-bezier(0.25, 0.1, 0.25, 1));
}

/* ─── 计算器面板 ────────────────────────────────────────────────────────────── */

.keypad-panel {
  flex-shrink: 0;
  background: #ffffff;
  border-top-left-radius: 24rpx;
  border-top-right-radius: 24rpx;
  transform: translateY(100%);
  transition: transform var(--animation-slow, 350ms) var(--easing-default, cubic-bezier(0.25, 0.1, 0.25, 1));
  /* 问题1修复：keypad-panel 自身包含 safe-area padding-bottom */
  padding-bottom: env(safe-area-inset-bottom);
  max-height: 70vh;
  overflow: hidden;
}

.keypad-panel--visible {
  transform: translateY(0);
}

/* ─── 金额显示区 ────────────────────────────────────────────────────────────── */

.amount-display {
  display: flex;
  align-items: baseline;
  padding: 24rpx 32rpx 16rpx;
  min-height: 80rpx;
}

.amount-prefix {
  font-size: 32rpx;
  color: rgba(28, 27, 26, 0.48);
  margin-right: 8rpx;
  font-weight: 500;
}

.amount-value {
  font-size: 56rpx;
  font-weight: 600;
  color: #1c1b1a;
  line-height: 1.2;
  letter-spacing: -1rpx;
  word-break: break-all;
}

.amount-value--result {
  color: #07C160;
}

/* ─── 操作行 ────────────────────────────────────────────────────────────────── */

.action-row {
  display: flex;
  align-items: center;
  padding: 0 32rpx 16rpx;
  gap: 16rpx;
  min-height: 56rpx;
}

/* 账本切换 */
.action-ledger {
  flex-shrink: 0;
}

.action-ledger__text {
  font-size: 22rpx;
  color: rgba(28, 27, 26, 0.36);
}

/* 费用性质开关 */
.action-shared {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-shrink: 0;
  opacity: 0;
  height: 0;
  overflow: hidden;
  transition: opacity var(--animation-normal, 250ms) var(--easing-default, cubic-bezier(0.25, 0.1, 0.25, 1)),
              height var(--animation-normal, 250ms) var(--easing-default, cubic-bezier(0.25, 0.1, 0.25, 1));
}

.action-shared--visible {
  opacity: 1;
  height: 40rpx;
}

.action-shared__text {
  font-size: 22rpx;
  color: rgba(28, 27, 26, 0.36);
  transition: color var(--animation-fast, 150ms) var(--easing-default, cubic-bezier(0.25, 0.1, 0.25, 1));
}

.action-shared__text--active {
  color: #1c1b1a;
  font-weight: 600;
}

.action-shared__divider {
  font-size: 22rpx;
  color: rgba(28, 27, 26, 0.12);
}

/* 备注 */
.action-note {
  flex: 1;
  min-width: 0;
}

.action-note__placeholder {
  font-size: 22rpx;
  color: rgba(28, 27, 26, 0.28);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.action-note__input {
  flex: 1;
  font-size: 22rpx;
  color: #1c1b1a;
  min-height: 40rpx;
}

/* ─── 数字键盘 ──────────────────────────────────────────────────────────────── */

.keypad {
  padding: 0 8rpx 8rpx;
}

.keypad__row {
  display: flex;
  width: 100%;
}

.keypad__key {
  flex: 1;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 4rpx;
  border-radius: 12rpx;
  background: rgba(28, 27, 26, 0.04);
  font-size: 36rpx;
  color: #1c1b1a;
  font-weight: 500;
  transition: background var(--animation-fast, 150ms) var(--easing-default, cubic-bezier(0.25, 0.1, 0.25, 1));
}

.keypad__key:active {
  background: rgba(28, 27, 26, 0.1);
}

.keypad__key--fn {
  background: rgba(28, 27, 26, 0.08);
  font-size: 32rpx;
}

.keypad__key--action {
  font-size: 28rpx;
  font-weight: 600;
}

.keypad__key--done {
  background: #07C160;
  color: #ffffff;
}

.keypad__key--done:active {
  background: #06ad56;
}

.keypad__key--equals {
  background: rgba(28, 27, 26, 0.12);
  color: #1c1b1a;
  font-size: 40rpx;
  font-weight: 700;
}

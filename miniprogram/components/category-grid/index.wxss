/* components/category-grid/index.wxss · 全屏分类选择组件样式 */

/* ═══════════════════════════════════════════════════════════════
   覆盖层容器
   ═══════════════════════════════════════════════════════════════ */

.catgrid {
  position: fixed;
  inset: 0;
  z-index: 9999;
  background: #f1f2ec;
  transform: translateY(100%);
}

/* 反首帧闪现：从未打开过(尚无 --animatable)一律 visibility:hidden */
.catgrid:not(.catgrid--animatable) {
  visibility: hidden;
}

/* 过渡开关：用户真正打开面板时开启 */
.catgrid--animatable {
  transition: transform 350ms cubic-bezier(0.25, 0.1, 0.25, 1);
}

.catgrid.is-visible {
  transform: translateY(0);
}

/* ═══════════════════════════════════════════════════════════════
   Shell：flex column 主容器
   ═══════════════════════════════════════════════════════════════ */

.catgrid__shell {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #f1f2ec;
}

/* ═══════════════════════════════════════════════════════════════
   顶部 Header：取消 | 支出·收入·转移 | 占位
   ═══════════════════════════════════════════════════════════════ */

.catgrid__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-shrink: 0;
  padding: 0 32rpx 16rpx;
}

.catgrid__close {
  color: rgba(28, 27, 26, 0.48);
  font-size: 28rpx;
  line-height: 1;
  padding: 12rpx 8rpx;
  margin-left: -8rpx;
}

.catgrid__tabs {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
}

.catgrid__tabs.is-disabled {
  opacity: 0.4;
  pointer-events: none;
}

.catgrid__tab {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 4rpx 0;
}

.catgrid__tab-text {
  font-size: 34rpx;
  color: rgba(28, 27, 26, 0.28);
  font-weight: 400;
  line-height: 1;
  transition: color 150ms cubic-bezier(0.25, 0.1, 0.25, 1),
              font-weight 150ms cubic-bezier(0.25, 0.1, 0.25, 1);
}

.catgrid__tab.is-active .catgrid__tab-text {
  color: #1c1b1a;
font-weight: 600;
}

.catgrid__tab-indicator {
  position: absolute;
  left: 50%;
  bottom: -12rpx;
  transform: translateX(-50%);
  width: 24rpx;
  height: 4rpx;
  border-radius: 2rpx;
  background: transparent;
  transition: background 200ms cubic-bezier(0.25, 0.1, 0.25, 1);
}

.catgrid__tab.is-active .catgrid__tab-indicator {
  background: #1c1b1a;
}

.catgrid__sep {
  font-size: 34rpx;
  color: rgba(28, 27, 26, 0.18);
  line-height: 1;
  margin-top: 2rpx;
}

.catgrid__placeholder {
  width: 80rpx;
}

/* ═══════════════════════════════════════════════════════════════
   分类 Swiper
   ═══════════════════════════════════════════════════════════════ */

.catgrid__swiper {
  flex: 1;
  min-height: 0;
  width: 100%;
}

/* ═══════════════════════════════════════════════════════════════
   分类滚动区
   ═══════════════════════════════════════════════════════════════ */

.catgrid__scroll {
  height: 100%;
  width: 100%;
  box-sizing: border-box;
  padding: 0 28rpx;
}

/* ═══════════════════════════════════════════════════════════════
   分类网格（公共样式 · COSTRA-227）
   ═══════════════════════════════════════════════════════════════ */

@import '../../styles/category-grid.wxss';

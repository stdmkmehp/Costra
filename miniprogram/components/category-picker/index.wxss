/* components/category-picker/index.wxss · 通用分类选择面板 */
.cpicker { position: fixed; top: 0; left: 0; right: 0; bottom: 0; z-index: 1000; }
.cpicker__mask { position: absolute; top: 0; left: 0; right: 0; bottom: 0; background: rgba(28,27,26,0.4); }
.cpicker__panel {
  position: absolute; bottom: 0; left: 0; right: 0;
  background: #ffffff; border-radius: 24rpx 24rpx 0 0;
  max-height: 70vh; display: flex; flex-direction: column;
  animation: cpicker-slide-up 280ms ease-out;
}
@keyframes cpicker-slide-up { from { transform: translateY(100%); } to { transform: translateY(0); } }

.cpicker__tabs {
  display: flex; padding: 24rpx 32rpx 0; gap: 32rpx;
}
.cpicker__tab {
  font-size: 28rpx; color: rgba(28,27,26,0.48); padding-bottom: 16rpx;
  border-bottom: 4rpx solid transparent;
}
.cpicker__tab--active { color: #1c1b1a; font-weight: 600; border-bottom-color: #8AA98F; }

.cpicker__scroll { flex: 1; overflow-y: auto; padding: 24rpx 32rpx; }
.cpicker__group { margin-bottom: 24rpx; }
.cpicker__group-title { font-size: 24rpx; color: rgba(28,27,26,0.48); margin-bottom: 16rpx; }
.cpicker__grid { display: flex; flex-wrap: wrap; gap: 16rpx; }
.cpicker__item {
  display: flex; flex-direction: column; align-items: center;
  width: calc((100% - 64rpx) / 5); padding: 16rpx 0;
  border-radius: 16rpx; transition: transform 120ms ease-out;
}
.cpicker__item--hover { transform: scale(0.94); }
.cpicker__item--selected { background: rgba(138,169,143,0.12); }
.cpicker__icon { font-size: 44rpx; margin-bottom: 8rpx; }
.cpicker__name { font-size: 22rpx; color: #1c1b1a; text-align: center; }

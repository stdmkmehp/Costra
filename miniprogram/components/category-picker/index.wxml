<!-- components/category-picker/index.wxml · 通用分类选择面板 -->
<view class="cpicker" wx:if="{{show}}" catchtouchmove="onNoop">
  <view class="cpicker__mask" bindtap="onClose"></view>
  <view class="cpicker__panel">
    <!-- Tab 栏 -->
    <view class="cpicker__tabs" wx:if="{{allowCrossType}}">
      <view class="cpicker__tab {{activeTab === 'expense' ? 'cpicker__tab--active' : ''}}"
            data-tab="expense" bindtap="onTabChange">支出</view>
      <view class="cpicker__tab {{activeTab === 'income' ? 'cpicker__tab--active' : ''}}"
            data-tab="income" bindtap="onTabChange">收入</view>
      <view class="cpicker__tab {{activeTab === 'transfer' ? 'cpicker__tab--active' : ''}}"
            data-tab="transfer" bindtap="onTabChange">转账</view>
    </view>
    <!-- 分类网格 -->
    <scroll-view class="cpicker__scroll" scroll-y enhanced show-scrollbar="{{false}}">
      <view wx:for="{{categories}}" wx:key="id" class="cpicker__group">
        <view class="cpicker__group-title">{{item.name}}</view>
        <view class="cpicker__grid">
          <view wx:for="{{item.children}}" wx:for-item="sub" wx:key="id"
                class="cpicker__item {{sub.id === value ? 'cpicker__item--selected' : ''}}"
                data-id="{{sub.id}}" data-name="{{sub.name}}" data-icon="{{sub.icon}}"
                data-parent-type="{{activeTab}}"
                bindtap="onSelectSub" hover-class="cpicker__item--hover" hover-stay-time="60">
            <text class="cpicker__icon">{{sub.icon}}</text>
            <text class="cpicker__name">{{sub.name}}</text>
          </view>
        </view>
      </view>
    </scroll-view>
  </view>
</view>

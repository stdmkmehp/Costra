/* components/recurring-bucket-picker/index.wxss */
.rbucket__row {
  display: flex; border: 1rpx solid rgba(28,27,26,0.12); border-radius: 44rpx;
  margin: 16rpx 0; overflow: hidden;
}
.rbucket__item {
  flex: 1; text-align: center; height: 72rpx; line-height: 72rpx;
  font-size: 28rpx; color: #1c1b1a; position: relative;
}
.rbucket__item--active { background: #ffffff; }
.rbucket__item--active::after {
  content: ''; position: absolute; bottom: 0; left: 50%; transform: translateX(-50%);
  width: 40rpx; height: 4rpx; background: #8AA98F; border-radius: 2rpx;
}

<!-- pages-family/settings/index.wxml · 设置页 · 布局对齐 bulletin 公告页 -->
<view class="settings">
  <!-- GM 工具 · 仅 is_gm 用户可见 -->
  <block wx:if="{{isGm}}">
    <view class="settings__section-title">GM 工具</view>
    <view class="settings__item" bindtap="onTapGmImpersonate" hover-class="settings__item--hover" hover-stay-time="60">
      <view class="settings__label">切换登录身份</view>
      <view class="settings__arrow">›</view>
    </view>
  </block>

  <!-- 空态：当前无任何可用设置项（普通用户） -->
  <view wx:elif="{{gmLoaded}}" class="settings__empty">暂无可用设置项</view>
</view>

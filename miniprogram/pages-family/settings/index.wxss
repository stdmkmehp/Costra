/* pages-family/settings/index.wxss · 设置页 · 布局对齐 bulletin 公告页 */

.settings {
  padding: 24rpx 32rpx 64rpx;
  background: var(--color-bg);
  min-height: 100vh;
}

.settings__section-title {
  font-size: 26rpx;
  color: var(--color-text-muted);
  margin: 32rpx 8rpx 16rpx;
  line-height: 1.3;
}

.settings__item {
  background: var(--color-surface);
  border-radius: var(--radius-lg);
  margin-bottom: 16rpx;
  padding: 28rpx 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.settings__item--hover {
  background: rgba(0, 0, 0, 0.04);
}

.settings__label {
  flex: 1;
  font-size: 30rpx;
  color: var(--color-text);
  line-height: 1.3;
}

.settings__arrow {
  color: var(--color-text-muted);
  font-size: 36rpx;
  flex-shrink: 0;
  margin-left: 16rpx;
}

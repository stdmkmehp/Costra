/* pages-family/settings/index.wxss · 设置页 · 布局对齐 bulletin 公告页 */

.settings {
  padding: 24rpx 32rpx 64rpx;
  background: var(--color-bg);
  min-height: 100vh;
}

.settings__section-title {
  font-size: 26rpx;
  color: var(--color-text-muted);
  margin: 32rpx 8rpx 16rpx;
  line-height: 1.3;
}

.settings__item {
  background: var(--color-surface);
  border-radius: var(--radius-lg);
  margin-bottom: 16rpx;
  padding: 28rpx 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.settings__item--hover {
  background: rgba(0, 0, 0, 0.04);
}

.settings__label {
  flex: 1;
  font-size: 30rpx;
  color: var(--color-text);
  line-height: 1.3;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.settings__label-main {
  display: flex;
  align-items: center;
}

/* 入口副文案（进行中 > 有完成未看 > 默认 · §8.1） */
.settings__sub {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--color-text-muted);
}

/* 未读完成任务小绿点（账本导入/导出入口 · §8.1 8rpx） */
.settings__dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: var(--color-success);
  margin-left: 12rpx;
  flex-shrink: 0;
}

.settings__arrow {
  color: var(--color-text-muted);
  font-size: 36rpx;
  flex-shrink: 0;
  margin-left: 16rpx;
}

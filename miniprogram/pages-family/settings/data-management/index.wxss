/* pages-family/settings/data-management · 账本导入 / 导出
 * 视觉与 mine 页其他子页面（公告/设置/关于）对齐：
 *   - 页面 padding：24rpx 32rpx 64rpx
 *   - 卡片标题：30rpx / 600
 *   - 正文：28rpx / 1.7
 *   - 辅助说明：24rpx
 */

.page {
  padding: 24rpx 32rpx 64rpx;
  background: var(--color-bg);
  min-height: 100vh;
  box-sizing: border-box;
}

/* ─── 卡片 ──────────────────────────────────────────── */
.card {
  background: var(--color-surface);
  border-radius: var(--radius-lg);
  padding: 28rpx 32rpx;
  margin-bottom: 16rpx;
}

.card__title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text);
  line-height: 1.3;
}

.card__desc {
  margin-top: 12rpx;
  font-size: 28rpx;
  line-height: 1.7;
  color: var(--color-text-muted);
}

.card__note {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: var(--color-text-muted);
}

/* ─── 表单行 ──────────────────────────────────────────── */
.form-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0 8rpx;
  margin-top: 8rpx;
  border-top: 1rpx solid var(--color-divider);
}

.form-row--hover {
  opacity: 0.6;
}

.form-row__label {
  font-size: 28rpx;
  color: var(--color-text);
}

.form-row__right {
  display: flex;
  align-items: center;
}

.form-row__value {
  font-size: 28rpx;
  color: var(--color-text-muted);
}

.form-row__chevron {
  margin-left: 8rpx;
  font-size: 28rpx;
  color: var(--color-text-muted);
}

/* ─── 按钮 ──────────────────────────────────────────── */
.primary-btn {
  margin-top: 32rpx;
  background: var(--color-primary);
  color: var(--color-role-text-on-green);
  font-size: 30rpx;
  font-weight: 600;
  border-radius: var(--radius-md);
}

.primary-btn::after {
  border: none;
}

.primary-btn--disabled {
  opacity: 0.5;
}

.secondary-btn {
  margin-top: 24rpx;
  background: var(--color-surface);
  color: var(--color-primary);
  font-size: 28rpx;
  border-radius: var(--radius-md);
  border: 1rpx solid var(--color-primary);
}

.secondary-btn::after {
  border: none;
}

/* ─── 任务中心 ──────────────────────────────────────────── */
.section-title {
  margin: 32rpx 8rpx 16rpx;
  font-size: 26rpx;
  color: var(--color-text-muted);
}

.task-card__head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.task-card__status {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text);
  line-height: 1.3;
}

.task-card__status--succeeded {
  color: var(--color-success);
}

.task-card__status--failed,
.task-card__status--expired {
  color: var(--color-text-muted);
}

.task-card__time {
  font-size: 24rpx;
  color: var(--color-text-muted);
}

.task-card__meta {
  margin-top: 8rpx;
  font-size: 28rpx;
  line-height: 1.7;
  color: var(--color-text-muted);
}

.task-card__stage {
  margin-top: 16rpx;
  font-size: 28rpx;
  color: var(--color-text);
}

.task-card__countdown {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: var(--color-semantic-warning, #FA9D3B);
}

.task-card__hint {
  margin-top: 16rpx;
  font-size: 28rpx;
  line-height: 1.7;
  color: var(--color-text-muted);
}

/* ─── 进度条 ──────────────────────────────────────────── */
.progress {
  margin-top: 16rpx;
  height: 8rpx;
  border-radius: var(--radius-pill);
  background: var(--color-divider);
  overflow: hidden;
}

.progress__bar {
  height: 100%;
  border-radius: var(--radius-pill);
  background: var(--color-primary);
  transition: width 0.6s linear;
}

/* ─── 文件行 ──────────────────────────────────────────── */
.file-row {
  padding: 20rpx 0;
  margin-top: 8rpx;
  border-top: 1rpx solid var(--color-divider);
}

/* 文件名 + 大小同一行：一行放不下时文件名头段省略（头…尾 · 中间省略效果） */
.file-row__meta {
  display: flex;
  align-items: baseline;
}

.file-row__name {
  flex: 1;
  min-width: 0;
  display: flex;
  margin-right: 16rpx;
}

.file-row__name-head {
  flex: 0 1 auto;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  font-size: 28rpx;
  color: var(--color-text);
}

.file-row__name-tail {
  flex-shrink: 0;
  white-space: nowrap;
  font-size: 28rpx;
  color: var(--color-text);
}

.file-row__size {
  flex-shrink: 0;
  font-size: 24rpx;
  color: var(--color-text-muted);
}

.file-row__actions {
  display: flex;
  justify-content: flex-end;
  margin-top: 16rpx;
}

.file-row__btn {
  margin: 0;
  padding: 0 28rpx;
  height: 60rpx;
  line-height: 60rpx;
  font-size: 26rpx;
  background: var(--color-primary);
  color: var(--color-role-text-on-green);
  border-radius: var(--radius-pill);
}

.file-row__btn::after {
  border: none;
}

.file-row__btn--disabled {
  opacity: 0.5;
}

/* ─── 任务卡入场（新出现任务：下滑淡入 + 浅绿高亮渐隐 · 与终态轻震互补） ─── */
.task-card--enter {
  animation:
    task-card-enter 480ms cubic-bezier(0.22, 1, 0.36, 1),
    task-card-flash 1400ms ease-out;
}

@keyframes task-card-enter {
  from {
    opacity: 0;
    transform: translateY(-16rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes task-card-flash {
  from {
    background: rgba(7, 193, 96, 0.1);
  }
  to {
    background: var(--color-surface);
  }
}

/* ─── 空态 ──────────────────────────────────────────── */
.empty {
  padding: 120rpx 0;
  text-align: center;
  font-size: 28rpx;
  color: var(--color-text-muted);
}

/* ─── 导入卡：文件与统计 ──────────────────────────────────────────── */
.import-file {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-top: 20rpx;
  padding: 20rpx 0;
  border-top: 1rpx solid var(--color-divider);
}

.import-file__name {
  font-size: 28rpx;
  color: var(--color-text);
  word-break: break-all;
  flex: 1;
  min-width: 0;
  margin-right: 16rpx;
}

.import-file__size {
  font-size: 24rpx;
  color: var(--color-text-muted);
  flex-shrink: 0;
}

.import-summary {
  margin-top: 8rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text);
  line-height: 1.5;
}

/* ─── 导入卡：问题预览 ──────────────────────────────────────────── */
.issue-row {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: var(--color-text-muted);
}

.issue-row--error {
  color: var(--color-semantic-danger, #C08A7B);
}

.issue-row--warning {
  color: var(--color-semantic-warning, #FA9D3B);
}

.issue-overflow {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--color-text-muted);
}

/* ─── 导入卡：成员映射 ──────────────────────────────────────────── */
.mapping-title {
  margin-top: 24rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text);
  line-height: 1.3;
}

.mapping-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-top: 1rpx solid var(--color-divider);
  margin-top: 8rpx;
}

.mapping-row__left {
  flex: 1;
  min-width: 0;
  margin-right: 16rpx;
}

.mapping-row__nick {
  font-size: 28rpx;
  color: var(--color-text);
}

.mapping-row__count {
  margin-left: 12rpx;
  font-size: 24rpx;
  color: var(--color-text-muted);
}

.mapping-row__right {
  display: flex;
  align-items: center;
  flex-shrink: 0;
}

.mapping-row__target {
  font-size: 28rpx;
  color: var(--color-primary);
}

.mapping-row__target--empty {
  color: var(--color-text-muted);
}

/* 本地校验失败就地展示（§8.3 · 不使用一闪而过的 Toast） */
.form-error {
  margin-top: 16rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: var(--color-semantic-danger, #C08A7B);
}

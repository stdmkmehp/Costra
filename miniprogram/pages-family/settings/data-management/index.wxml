<!-- pages-family/settings/data-management/index · 数据管理（账本导入 + 导出 · 二期） -->
<view class="page">

  <!-- ─── 导入卡（§8.3 状态机：选择账本 → 选择文件 → 确认卡 → 检测中 → 就地结果区） ─── -->
  <view class="card">
    <view class="card__title">导入账本 CSV</view>
    <view class="card__desc">从微信聊天中选择 CSV 文件（≤1MB · 约 5,000 条），检测后可确认导入到目标账本（{{importLedgerName || ledgerName}}）。支持 Costra 导出格式与常见第三方账单。</view>

    <!-- 目标账本（>1 个账本时 · §8.3 步骤 2 · 确认前可改） -->
    <view
      class="form-row"
      wx:if="{{showLedgerPicker && (importState === 'idle' || importState === 'confirm')}}"
      bindtap="onPickImportLedger"
      hover-class="form-row--hover"
    >
      <text class="form-row__label">目标账本</text>
      <view class="form-row__right">
        <text class="form-row__value">{{importLedgerName}}</text>
        <text class="form-row__chevron">›</text>
      </view>
    </view>

    <!-- 选择前 -->
    <block wx:if="{{importState === 'idle'}}">
      <view class="card__note">检测结果 15 分钟内有效；确认前不会写入任何数据。</view>
      <button
        class="primary-btn {{hasActiveImport ? 'primary-btn--disabled' : ''}}"
        bindtap="onPickImportFile"
        disabled="{{hasActiveImport}}"
      >{{hasActiveImport ? '导入任务进行中…' : '选择 CSV 文件'}}</button>
      <view class="form-error" wx:if="{{fileError}}">{{fileError}}</view>
    </block>

    <!-- 确认卡（§8.3 步骤 7 · 账本/文件名/大小） -->
    <block wx:if="{{importState === 'confirm'}}">
      <view class="import-file">
        <text class="import-file__name">{{importFileName}}</text>
        <text class="import-file__size">{{importFileSizeText}}</text>
      </view>
      <view class="card__note">将对「{{importLedgerName}}」进行检测；确认前不会写入任何数据。</view>
      <button class="primary-btn" bindtap="onStartDetectTap">开始检测</button>
      <view class="import-actions">
        <button class="secondary-btn import-actions__btn" bindtap="onResetImportTap">重新选择文件</button>
      </view>
    </block>

    <!-- 检测中（上传期间已开启离开前确认 · R4） -->
    <block wx:if="{{importState === 'detecting'}}">
      <button class="primary-btn primary-btn--disabled" disabled>正在检测…</button>
      <view class="card__note" wx:if="{{importFileName}}">{{importFileName}}<text wx:if="{{importFileSizeText}}"> · {{importFileSizeText}}</text></view>
    </block>

    <!-- 检测完成：就地结果区 -->
    <block wx:if="{{importState === 'report'}}">
      <view class="import-file">
        <text class="import-file__name">{{importFileName}}</text>
        <text class="import-file__size">{{importFileSizeText}}</text>
      </view>

      <view class="import-summary">{{reportSummaryText}}</view>

      <!-- 问题预览（错误优先 · 最多 5 条 · 超出走报告下载） -->
      <block wx:if="{{issuesPreview.length > 0}}">
        <view
          wx:for="{{issuesPreview}}"
          wx:key="key"
          class="issue-row {{item.level === 'error' ? 'issue-row--error' : 'issue-row--warning'}}"
        >{{item.text}}</view>
        <view class="issue-overflow" wx:if="{{issuesOverflowText}}">{{issuesOverflowText}}</view>
      </block>

      <!-- 成员映射区（仅自产导出文件存在未匹配昵称时渲染） -->
      <block wx:if="{{mappingRows.length > 0 && !mappingTooMany}}">
        <view class="mapping-title">以下记账人不是本家庭当前成员，请指定归属：</view>
        <view
          class="mapping-row"
          wx:for="{{mappingRows}}"
          wx:key="nickname"
          data-nickname="{{item.nickname}}"
          bindtap="onMappingRowTap"
          hover-class="form-row--hover"
        >
          <view class="mapping-row__left">
            <text class="mapping-row__nick">「{{item.nickname}}」</text>
            <text class="mapping-row__count">{{item.rowCount}} 条</text>
          </view>
          <view class="mapping-row__right">
            <text class="mapping-row__target {{item.target === '' ? 'mapping-row__target--empty' : ''}}">{{item.targetLabel}}</text>
            <text class="form-row__chevron">›</text>
          </view>
        </view>
        <view class="card__note">未指定的昵称，其记录将不导入。</view>
      </block>

      <!-- 未匹配昵称超过 20 个（§4.3）：不渲染映射区，引导确认是否选错账本 -->
      <block wx:if="{{mappingTooMany}}">
        <view class="mapping-title">未匹配的记账人超过 20 个，无法逐一指定归属。</view>
        <view class="card__note">该文件的记账人与「{{importLedgerName}}」的成员普遍对不上，很可能选错了目标账本。请核对后重新选择账本或文件。</view>
      </block>

      <!-- 按钮组 -->
      <button
        wx:if="{{!mappingTooMany}}"
        class="primary-btn {{(!commitEnabled || committing) ? 'primary-btn--disabled' : ''}}"
        bindtap="onCommitImportTap"
        disabled="{{!commitEnabled || committing}}"
      >{{committing ? '正在提交…' : commitLabel}}</button>
      <view class="import-actions">
        <button class="secondary-btn import-actions__btn" wx:if="{{showReportDownload}}" bindtap="onDownloadReportTap">下载问题报告</button>
        <button class="secondary-btn import-actions__btn" bindtap="onResetImportTap">重新选择文件</button>
      </view>
      <view class="card__note">确认后将在后台导入，结果见下方任务卡。</view>
    </block>
  </view>

  <!-- ─── 导出卡 ─── -->
  <view class="card">
    <view class="card__title">导出账本 CSV</view>
    <view class="card__desc">导出目标账本（{{exportLedgerName || ledgerName}}）的流水为 Excel 兼容的 CSV 文件，可发送到微信聊天保存或分享。</view>

    <!-- 目标账本（>1 个账本时 · §8.4 步骤 2） -->
    <view class="form-row" wx:if="{{showLedgerPicker}}" bindtap="onPickExportLedger" hover-class="form-row--hover">
      <text class="form-row__label">目标账本</text>
      <view class="form-row__right">
        <text class="form-row__value">{{exportLedgerName}}</text>
        <text class="form-row__chevron">›</text>
      </view>
    </view>
    <view class="card__note" wx:if="{{exportSharedHint}}">将导出该账本范围内所有成员的流水。</view>

    <view class="form-row" bindtap="onRangeTap" hover-class="form-row--hover">
      <text class="form-row__label">时间范围</text>
      <view class="form-row__right">
        <text class="form-row__value">{{rangeLabel}}</text>
        <text class="form-row__chevron">›</text>
      </view>
    </view>

    <block wx:if="{{rangeMode === 'custom'}}">
      <picker mode="date" value="{{customFrom}}" end="{{today}}" bindchange="onCustomFromChange">
        <view class="form-row" hover-class="form-row--hover">
          <text class="form-row__label">开始日期</text>
          <view class="form-row__right">
            <text class="form-row__value">{{customFrom || '请选择'}}</text>
            <text class="form-row__chevron">›</text>
          </view>
        </view>
      </picker>
      <picker mode="date" value="{{customTo}}" end="{{today}}" bindchange="onCustomToChange">
        <view class="form-row form-row--last" hover-class="form-row--hover">
          <text class="form-row__label">结束日期</text>
          <view class="form-row__right">
            <text class="form-row__value">{{customTo || '请选择'}}</text>
            <text class="form-row__chevron">›</text>
          </view>
        </view>
      </picker>
    </block>

    <view class="card__note">文件自导出完成起保留 24 小时，过期需重新导出。</view>

    <button
      class="primary-btn {{creating ? 'primary-btn--disabled' : ''}}"
      bindtap="onCreateTap"
      disabled="{{creating}}"
    >{{creating ? '正在创建…' : '开始导出'}}</button>
  </view>

  <!-- ─── 任务中心（导入/导出统一 · §8.3 步骤 7） ─── -->
  <view class="section-title" wx:if="{{jobs.length > 0}}">数据任务</view>

  <view class="card task-card" wx:for="{{jobs}}" wx:key="id">
    <view class="task-card__head">
      <text class="task-card__status task-card__status--{{item.status}}{{item.isExpired ? ' task-card__status--expired' : ''}}">{{item.statusText}}</text>
      <text class="task-card__time">{{item.createdLabel}}</text>
    </view>
    <view class="task-card__meta">
      <text wx:if="{{showLedgerPicker && item.ledgerName}}">{{item.ledgerName}} · </text>{{item.rangeLabel}}<text wx:if="{{item.entryCount !== null}}"> · {{item.type === 'import' ? '导入' : ''}}{{item.entryCount}} 条{{item.type === 'import' ? '' : '流水'}}</text><text wx:if="{{item.skippedCount > 0}}"> · 跳过 {{item.skippedCount}} 条</text>
    </view>

    <!-- 进行中：阶段 + 模拟进度 -->
    <block wx:if="{{item.status === 'queued' || item.status === 'processing'}}">
      <view class="task-card__stage">{{item.stageName}}</view>
      <view class="progress">
        <view class="progress__bar" style="width: {{item.progress}}%;"></view>
      </view>
    </block>

    <!-- 导出完成（未过期）：文件列表 + 倒计时 -->
    <block wx:if="{{item.type === 'export' && item.status === 'succeeded' && !item.isExpired}}">
      <view class="task-card__countdown" wx:if="{{item.countdownText}}">有效期剩余 {{item.countdownText}}</view>
      <view class="file-row" wx:for="{{item.files}}" wx:key="part" wx:for-item="file">
        <view class="file-row__info">
          <view class="file-row__name">{{file.filename}}</view>
          <view class="file-row__size">{{file.sizeText}}<text wx:if="{{item.files.length > 1}}"> · 分片 {{file.part}}/{{item.files.length}}</text></view>
        </view>
        <button
          class="file-row__btn {{file.downloading ? 'file-row__btn--disabled' : ''}}"
          data-job-id="{{item.id}}"
          data-part="{{file.part}}"
          bindtap="onDownloadTap"
          disabled="{{file.downloading}}"
        >{{file.downloading ? (file.downloadPercent > 0 ? file.downloadPercent + '%' : '下载中') : '发送到微信'}}</button>
      </view>
    </block>

    <!-- 导入完成：无需下载动作（数据已入库，首见时已触发同步刷新） -->
    <block wx:if="{{item.type === 'import' && item.status === 'succeeded'}}">
      <view class="task-card__hint">流水已写入当前账本。</view>
    </block>

    <!-- 导出过期：重新生成（按原账本原区间 · source_date_*） -->
    <block wx:if="{{item.type === 'export' && item.status === 'succeeded' && item.isExpired}}">
      <view class="task-card__hint">文件已超过 24 小时有效期，已被清理。</view>
      <button
        class="secondary-btn"
        data-ledger-id="{{item.ledgerId}}"
        data-from="{{item.sourceFrom}}"
        data-to="{{item.sourceTo}}"
        bindtap="onRecreateTap"
      >重新生成</button>
    </block>

    <!-- 失败：按 error_code 渲染原因（§9.5 · 禁渲染 error_message）；
         导出可重试（按原账本原区间）；导入引导重新上传（§4.4：重试需重新上传） -->
    <block wx:if="{{item.status === 'failed'}}">
      <view class="task-card__hint">{{item.errorText}}</view>
      <button
        wx:if="{{item.type === 'export'}}"
        class="secondary-btn"
        data-ledger-id="{{item.ledgerId}}"
        data-from="{{item.sourceFrom}}"
        data-to="{{item.sourceTo}}"
        bindtap="onRecreateTap"
      >重试</button>
    </block>
  </view>

  <view class="empty" wx:if="{{!loading && jobs.length === 0}}">暂无数据任务</view>
</view>

/* pages-family/bulletin/index.wxss · 公告列表页 */

.bulletin {
  padding: 24rpx 32rpx 64rpx;
  background: var(--color-bg);
  min-height: 100vh;
}

.bulletin__loading,
.bulletin__empty {
  padding: 120rpx 0;
  text-align: center;
  font-size: 28rpx;
  color: var(--color-text-muted);
}

.bulletin__item {
  background: var(--color-surface);
  border-radius: var(--radius-lg);
  margin-bottom: 16rpx;
  overflow: hidden;
}

.bulletin__item--unread {
  /* 未读项左侧留微弱色条，吸引注意 */
  border-left: 6rpx solid var(--color-primary, #1c1b1a);
}

.bulletin__header {
  padding: 28rpx 32rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.bulletin__title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.bulletin__dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #FF3B30;
  flex-shrink: 0;
}

.bulletin__title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text);
  line-height: 1.3;
}

.bulletin__date {
  font-size: 22rpx;
  color: var(--color-text-muted);
  flex-shrink: 0;
  margin-left: 16rpx;
}

.bulletin__body {
  padding: 0 32rpx 28rpx;
}

.bulletin__content {
  font-size: 28rpx;
  line-height: 1.8;
  color: var(--color-text-muted);
}

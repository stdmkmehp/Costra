.privacy {
  padding: 32rpx 32rpx 64rpx;
  background: var(--color-bg);
  min-height: 100vh;
}

.privacy__title {
  font-size: 40rpx;
  font-weight: 700;
  color: var(--color-text);
  margin-bottom: 8rpx;
}

.privacy__updated {
  font-size: 24rpx;
  color: var(--color-text-muted);
  margin-bottom: 40rpx;
}

.privacy__section {
  margin-bottom: 36rpx;
}

.privacy__section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text);
  margin-bottom: 12rpx;
}

.privacy__body {
  font-size: 28rpx;
  line-height: 1.7;
  color: var(--color-text-muted);
  margin-bottom: 8rpx;
}

.privacy__body--indent {
  padding-left: 16rpx;
}

.privacy__bold {
  font-weight: 600;
  color: var(--color-text);
}

.privacy__icp {
  margin-top: 64rpx;
  font-size: 24rpx;
  color: #9E9E9E;
  text-align: center;
}

/* pages-family/support/index · 赞赏页 */
/* 视觉遵循 design_spec：暖灰白底 + 白卡 + 油墨黑；纪念章/陶土色为本页唯一"情感色" */

.support {
  padding: 48rpx 32rpx 64rpx;
  background: var(--color-bg);
  min-height: 100vh;
}

/* ─── 徽章区 ──────────────────────────────────────────── */
.badge-hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 16rpx 0 40rpx;
}

.badge-hero__img {
  width: 160rpx;
  height: 160rpx;
}

.badge-hero__status {
  margin-top: 20rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text);
}

.badge-hero__status--dim {
  color: var(--color-text-muted);
  font-weight: 400;
}

.badge-hero__thanks {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #C08A7B;
}

/* ─── 说明区 ──────────────────────────────────────────── */
.section {
  margin-bottom: 36rpx;
}

.section__body {
  font-size: 28rpx;
  line-height: 1.7;
  color: var(--color-text-muted);
  margin-bottom: 8rpx;
}

.section__body--bold {
  font-weight: 600;
  color: var(--color-text);
}

/* ─── 档位区 ──────────────────────────────────────────── */
.tiers {
  margin-bottom: 32rpx;
}

.tier {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: var(--color-surface);
  border-radius: var(--radius-lg);
  padding: 28rpx 32rpx;
  margin-bottom: 20rpx;
  border: 2rpx solid transparent;
}

.tier--hover {
  background: rgba(0, 0, 0, 0.04);
}

.tier--disabled {
  opacity: 0.35;
}

.tier__main {
  flex: 1;
  min-width: 0;
}

.tier__title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text);
}

.tier__sub {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--color-text-muted);
}

.tier__delta {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #C08A7B;
}

.tier__price {
  margin-left: 24rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-text);
}

.tier__loading {
  color: var(--color-text-muted);
}

.tiers__notice {
  font-size: 24rpx;
  color: var(--color-text-muted);
  text-align: center;
  padding: 8rpx 0;
}

.tiers__error {
  font-size: 24rpx;
  color: #FA5151;
  padding: 8rpx 4rpx;
}

/* ─── settling 态 ─────────────────────────────────────── */
.settling {
  font-size: 26rpx;
  color: var(--color-text-muted);
  text-align: center;
  padding: 16rpx 0;
}

.settling--dim {
  color: var(--color-text-muted);
}

.settling__refresh {
  margin-left: 16rpx;
  color: var(--color-text);
  text-decoration: underline;
}

/* ─── 记录区 ──────────────────────────────────────────── */
.history {
  margin-bottom: 32rpx;
}

.history__title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text);
  margin-bottom: 12rpx;
}

.history__empty {
  font-size: 24rpx;
  color: var(--color-text-muted);
}

.history__row {
  display: flex;
  align-items: center;
  padding: 16rpx 4rpx;
}

/* 三栏统一字号，靠颜色（muted / 主色 / 陶土色）+ 位置区分主次，避免 title 单峰 */
.history__cell--time,
.history__cell--title,
.history__cell--delta {
  font-size: 24rpx;
}

.history__cell--time {
  width: 170rpx;
  color: var(--color-text-muted);
}

.history__cell--title {
  flex: 1;
  min-width: 0;
  color: var(--color-text);
}

.history__cell--delta {
  margin-left: 16rpx;
  color: #C08A7B;
  font-variant-numeric: tabular-nums;
  font-feature-settings: "tnum";
}

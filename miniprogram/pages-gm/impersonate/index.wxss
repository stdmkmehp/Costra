/* pages-gm/impersonate/index.wxss · GM 切换登录身份 · 布局对齐设置页 */

.gm {
  padding: 24rpx 32rpx 64rpx;
  background: var(--color-bg);
  min-height: 100vh;
  box-sizing: border-box;
}

.gm__section-title {
  font-size: 26rpx;
  color: var(--color-text-muted);
  margin: 32rpx 8rpx 16rpx;
  line-height: 1.3;
}

.gm__section-title:first-child {
  margin-top: 0;
}

.gm__fake {
  background: var(--color-surface);
  border-radius: var(--radius-lg);
  padding: 24rpx 32rpx;
}

.gm__fake-btn {
  padding: 16rpx 32rpx;
  border-radius: var(--radius-lg);
  background: var(--color-text);
  color: var(--color-surface);
  font-size: 28rpx;
  line-height: 1.3;
  text-align: center;
}

.gm__hint {
  font-size: 24rpx;
  color: var(--color-text-muted);
  margin: 16rpx 8rpx 0;
  line-height: 1.4;
}

.gm__list {
  background: var(--color-surface);
  border-radius: var(--radius-lg);
  overflow: hidden;
}

.gm__user {
  display: flex;
  align-items: center;
  padding: 24rpx 32rpx;
}

.gm__user--hover {
  background: rgba(0, 0, 0, 0.04);
}

.gm__avatar {
  display: block;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.gm__avatar--placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-bg);
  color: var(--color-text-muted);
  font-size: 30rpx;
}

.gm__user-main {
  flex: 1;
  margin-left: 24rpx;
  min-width: 0;
}

.gm__user-name {
  font-size: 30rpx;
  color: var(--color-text);
  line-height: 1.3;
}

.gm__user-meta {
  font-size: 24rpx;
  color: var(--color-text-muted);
  margin-top: 6rpx;
  line-height: 1.3;
}

.gm__arrow {
  color: var(--color-text-muted);
  font-size: 36rpx;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.gm__empty {
  padding: 48rpx 32rpx;
  text-align: center;
  font-size: 26rpx;
  color: var(--color-text-muted);
}

.gm__pager {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 24rpx;
  padding: 0 8rpx;
}

.gm__pager-btn {
  font-size: 28rpx;
  color: var(--color-text);
  padding: 12rpx 24rpx;
}

.gm__pager-btn--disabled {
  color: var(--color-text-muted);
  opacity: 0.5;
}

.gm__pager-info {
  font-size: 26rpx;
  color: var(--color-text-muted);
}

.gm__mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.35);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}

.gm__mask-text {
  background: var(--color-surface);
  border-radius: var(--radius-lg);
  padding: 32rpx 48rpx;
  font-size: 28rpx;
  color: var(--color-text);
}

/* pages-gm/impersonate/index.wxss · GM 切换登录身份 · 布局对齐设置页 */

.gm {
  padding: 24rpx 32rpx 64rpx;
  background: var(--color-bg);
  min-height: 100vh;
  box-sizing: border-box;
}

.gm__section-title {
  font-size: 26rpx;
  color: var(--color-text-muted);
  margin: 32rpx 8rpx 16rpx;
  line-height: 1.3;
}

.gm__section-title:first-child {
  margin-top: 0;
}

.gm__fake {
  background: var(--color-surface);
  border-radius: var(--radius-lg);
  padding: 24rpx 32rpx;
}

.gm__fake-btn {
  padding: 16rpx 32rpx;
  border-radius: var(--radius-lg);
  background: var(--color-text);
  color: var(--color-surface);
  font-size: 28rpx;
  line-height: 1.3;
  text-align: center;
}

.gm__hint {
  font-size: 24rpx;
  color: var(--color-text-muted);
  margin: 16rpx 8rpx 0;
  line-height: 1.4;
}

.gm__list {
  background: var(--color-surface);
  border-radius: var(--radius-lg);
  overflow: hidden;
  /* 恒占 10 行高度：10 × 124.2rpx（行高 = padding 48 + max(头像 72, 双行文字 76.2)）。
     末页不足 10 行、setData 换页的异步渲染中间帧均不缩水，
     防止页底 scrollTop 被钳位导致翻页时页面跳动（注册区位于页面最底部） */
  min-height: 1242rpx;
  /* flex 列向排列与块级纵向等价，只为让空态（.gm__empty）可 flex:1 垂直居中 */
  display: flex;
  flex-direction: column;
}

.gm__user {
  display: flex;
  align-items: center;
  padding: 24rpx 32rpx;
}

.gm__user--hover {
  background: rgba(0, 0, 0, 0.04);
}

.gm__avatar {
  display: block;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.gm__avatar--placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--color-bg);
  color: var(--color-text-muted);
  font-size: 30rpx;
}

.gm__user-main {
  flex: 1;
  margin-left: 24rpx;
  min-width: 0;
}

.gm__user-name {
  font-size: 30rpx;
  color: var(--color-text);
  line-height: 1.3;
  /* 单行省略：长昵称不换行，保证各行高度恒定（min-height 按单行高度核算的前提） */
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.gm__user-meta {
  font-size: 24rpx;
  color: var(--color-text-muted);
  margin-top: 6rpx;
  line-height: 1.3;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.gm__arrow {
  color: var(--color-text-muted);
  font-size: 36rpx;
  flex-shrink: 0;
  margin-left: 16rpx;
}

.gm__empty {
  padding: 48rpx 32rpx;
  text-align: center;
  font-size: 26rpx;
  color: var(--color-text-muted);
  /* 列表容器恒 10 行高时，空态在容器内垂直居中 */
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.gm__pager {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 24rpx;
  padding: 0 8rpx;
}

.gm__pager-btn {
  font-size: 28rpx;
  color: var(--color-text);
  padding: 12rpx 24rpx;
}

.gm__pager-btn--disabled {
  color: var(--color-text-muted);
  opacity: 0.5;
}

.gm__pager-info {
  font-size: 26rpx;
  color: var(--color-text-muted);
}

.gm__mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.35);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}

.gm__mask-text {
  background: var(--color-surface);
  border-radius: var(--radius-lg);
  padding: 32rpx 48rpx;
  font-size: 28rpx;
  color: var(--color-text);
}

{
  "pages": [
    "pages/login/index",
    "pages/home/index",
    "pages/entry/index",
    "pages/mine/index"
  ],
  "subpackages": [
    {
      "root": "pages-stat/",
      "name": "stat",
      "pages": [
        "month/index",
        "overview/index"
      ]
    },
    {
      "root": "pages-family/",
      "name": "family",
      "pages": [
        "home/index",
        "dashboard/index",
        "settings/index",
        "privacy/index"
      ]
    }
  ],
  "preloadRule": {
    "pages/home/index": {
      "network": "all",
      "packages": ["stat", "family"]
    }
  },
  "window": {
    "navigationBarTitleText": "Costra",
    "navigationBarBackgroundColor": "#2F7A78",
    "navigationBarTextStyle": "white",
    "backgroundColor": "#FAFAFA",
    "enablePullDownRefresh": false
  },
  "tabBar": {
    "color": "#9E9E9E",
    "selectedColor": "#2F7A78",
    "backgroundColor": "#FFFFFF",
    "borderStyle": "black",
    "list": [
      { "pagePath": "pages/home/index",            "text": "记账" },
      { "pagePath": "pages-family/dashboard/index", "text": "家庭" },
      { "pagePath": "pages-stat/overview/index",    "text": "统计" },
      { "pagePath": "pages/mine/index",            "text": "我的" }
    ]
  },
  "style": "v2",
  "sitemapLocation": "sitemap.json",
  "requiredBackgroundModes": [],
  "requiredPrivateInfos": [],
  "permission": {},
  "lazyCodeLoading": "requiredComponents"
}

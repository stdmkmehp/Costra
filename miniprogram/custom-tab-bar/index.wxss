/* custom-tab-bar/index.wxss · 5 Tab 中置式毛玻璃 TabBar */
/* 卡号: COSTRA-201 · 设计源: design/ui/design_spec.md §3 */
/* 色值对齐 tokens/index.ts v2.0.0 */

/* ---- 容器 ---- */
.tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: flex-end;
  justify-content: space-around;
  /* 毛玻璃效果 · 对齐 design_spec §2 + tokens blur.tabBar */
  background: rgba(255, 255, 255, 0.85);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  /* 底部视觉安全区由 JS 统一注入，避免 CSS env 在不同机型/开发者工具下不一致 */
  z-index: 999;
  border-top: 1rpx solid rgba(28, 27, 26, 0.05);
  /* COSTRA-205: 覆盖层显示时平滑隐藏 · 通过 .tab-bar--hidden 切换 transform。
   * 反抖动（2026-06-08）：translate3d 替代 translateY，强制独立 GPU 合成层，
   * 避免页面滚动时 backdrop-filter 合成与主滚动层不同步导致的 1~2px 视觉漂移。
   * translate3d(0,0,0) 在 z 维度无视觉位移，等价 translateY(0)。 */
  transform: translate3d(0, 0, 0);
  /* 反首帧闪烁（2026-07-02）：transition 不再常驻基类。
   * 每个 Tab 页各持一份 tabbar 实例，首次进入时 hidden 由 true→false 揭示，
   * 若基类常驻 transition，这个揭示会被动画成"从底部滑上来"。
   * 改由 .tab-bar--animatable 承载 transition：首次揭示无此类 → 瞬时到位（无动画）；
   * 揭示绘制完成后（markActive 回调）再开启，供后续面板开合的滑动动画使用。 */
}

/* 过渡开关：仅在首次揭示完成后开启，避免首帧揭示被动画化（2026-07-02） */
.tab-bar--animatable {
  transition: transform var(--animation-fast, 150ms) var(--easing-default, cubic-bezier(0.25, 0.1, 0.25, 1));
}

/* 覆盖层显示时隐藏 TabBar（COSTRA-205） */
.tab-bar--hidden {
  /* translate3d 与 base 对齐 · 保证 transition 在同一变换函数内插值，避免合成层切换闪烁 */
  transform: translate3d(0, 100%, 0);
  pointer-events: none;
  /* COSTRA-206: 额外确保隐藏期间不可见、不参与布局 */
  visibility: hidden;
}

/* 降级：不支持 backdrop-filter 的设备 */
@supports not (backdrop-filter: blur(1px)) {
  .tab-bar {
    background: rgba(255, 255, 255, 0.95);
  }
}

/* ---- 通用 tab 项 ---- */
.tab-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex: 1;
  padding: 8rpx 0 12rpx;
  /* 对齐 tokens role.icon.tabDefault */
  color: rgba(28, 27, 26, 0.28);
  transition: color var(--animation-fast, 150ms) var(--easing-default, cubic-bezier(0.25, 0.1, 0.25, 1));
}

/* 选中态 · 对齐 tokens role.icon.tabSelected */
.tab-item--active {
  color: #1c1b1a;
}

/* ---- icon 文字 ---- */
.tab-item__icon {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 4rpx;
}

.tab-item__text {
  font-size: 20rpx;
  line-height: 1.2;
}

/* ---- 中间 [+] 凸起按钮 ---- */
.tab-item--center {
  position: relative;
  padding-bottom: 12rpx;
}

.tab-center-btn {
  /* 2026-08-11：微信绿莫兰迪化，与年度页莫兰迪色系统一
   * · #54A67F HSL 149°, 32%, 48% — 莫兰迪化降饱和绿
   * · 色相 149° 与原 #07C160（149°, 93%, 39%）完全一致，认知延续
   * · 饱和度 32%（v4=35% / v5=29% 折中），莫兰迪与原生之间过渡值
   * · 明度 48% 接近原 39% 又在莫兰迪区间（55-59%）内
   * 2026-08-11：按钮尺寸 96→112rpx，凸起高度同步抬升 6rpx */
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: #54A67F;
  display: flex;
  align-items: center;
  justify-content: center;
  /* 向上凸起于 tabBar 之上 · 半径 56rpx + 额外抬高 6rpx = -62rpx */
  margin-top: -62rpx;
  /* 克制的阴影 · 同步绿色调 */
  box-shadow: 0 4rpx 16rpx rgba(84, 166, 127, 0.35);
  transition: transform var(--animation-fast, 150ms) var(--easing-default, cubic-bezier(0.25, 0.1, 0.25, 1));
}

.tab-center-btn:active {
  transform: scale(0.92);
}

.tab-center-btn__plus {
  /* 对齐 tokens role.text.onGreen */
  color: #ffffff;
  font-size: 56rpx;
  font-weight: 300;
  line-height: 1;
  margin-top: -4rpx;
}

/* ---- 图标：明细（横线列表） ---- */
.icon-ledger {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  width: 36rpx;
}

.icon-ledger__line {
  height: 4rpx;
  background: currentColor;
  border-radius: 2rpx;
}

.icon-ledger__line:nth-child(1) { width: 100%; }
.icon-ledger__line:nth-child(2) { width: 70%; }
.icon-ledger__line:nth-child(3) { width: 85%; }

/* ---- 图标：统计（柱状图） ---- */
.icon-stat {
  display: flex;
  align-items: flex-end;
  gap: 5rpx;
  height: 32rpx;
}

.icon-stat__bar {
  width: 8rpx;
  border-radius: 2rpx;
  background: currentColor;
}

.icon-stat__bar--short  { height: 14rpx; }
.icon-stat__bar--tall   { height: 32rpx; }
.icon-stat__bar--medium { height: 22rpx; }

/* ---- 图标：协作（双人前后叠站 · 一大一小） ---- */
.icon-collab {
  position: relative;
  width: 36rpx;
  height: 32rpx;
}

.icon-collab__person {
  position: absolute;
}

.icon-collab__head {
  border-radius: 50%;
  background: currentColor;
}

.icon-collab__body {
  border-radius: 99rpx 99rpx 0 0;
  background: currentColor;
}

/* 后排（较大） */
.icon-collab__person--back {
  right: 0;
  bottom: 0;
}

.icon-collab__person--back .icon-collab__head {
  width: 14rpx;
  height: 14rpx;
  margin: 0 auto 2rpx;
}

.icon-collab__person--back .icon-collab__body {
  width: 24rpx;
  height: 14rpx;
}

/* 前排（较小 · 偏左下叠在前面） */
.icon-collab__person--front {
  left: 0;
  bottom: 0;
  z-index: 1;
}

.icon-collab__person--front .icon-collab__head {
  width: 10rpx;
  height: 10rpx;
  margin: 0 auto 2rpx;
}

.icon-collab__person--front .icon-collab__body {
  width: 18rpx;
  height: 10rpx;
}

/* ---- 图标：我的（单人） ---- */
.icon-mine {
  position: relative;
  width: 28rpx;
  height: 32rpx;
}

.icon-mine__head {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: currentColor;
  position: absolute;
  top: 0;
  left: 7rpx;
}

.icon-mine__body {
  width: 22rpx;
  height: 12rpx;
  border-radius: 12rpx 12rpx 0 0;
  background: currentColor;
  position: absolute;
  bottom: 0;
  left: 3rpx;
}

/* ---- 红点（画像未完善弱引导） ---- */
.tab-item__icon--badge-host {
  position: relative;
}

.badge-dot {
  position: absolute;
  top: -4rpx;
  right: -4rpx;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #FF3B30;
  border: 2rpx solid rgba(255, 255, 255, 0.85);
}

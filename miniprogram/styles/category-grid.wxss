/* styles/category-grid.wxss · 分类网格公共样式 */
/* COSTRA-227: 抽取自 expense-overlay · 供明细页分类编辑复用 */
/* 设计源: design/ui/design_spec.md §6.3 */

/* ─── 分类 Section 容器 ─── */

.category-section {
  padding: 8rpx 0;
}

/* 一级分类网格：严格一行 4 个 */
.category-section--tier1 {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  row-gap: 8rpx;
  column-gap: 0;
}

/* ─── 一级分类项 ─── */

.category-tier1 {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 16rpx 8rpx;
  transition: opacity 250ms cubic-bezier(0.25, 0.1, 0.25, 1);
}

.category-tier1.is-dimmed {
  opacity: 0.2;
}

.category-tier1.is-selected .category-tier1__icon {
  background: #1c1b1a;
  color: #ffffff;
}

.category-tier1.is-selected .category-tier1__name {
  color: #1c1b1a;
  font-weight: 600;
}

.category-tier1__icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: rgba(28, 27, 26, 0.06);
  color: rgba(28, 27, 26, 0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 500;
  transition: background 150ms cubic-bezier(0.25, 0.1, 0.25, 1),
              color 150ms cubic-bezier(0.25, 0.1, 0.25, 1);
}

.category-tier1__name {
  font-size: 22rpx;
  color: rgba(28, 27, 26, 0.6);
  text-align: center;
  line-height: 1.2;
  transition: color 150ms cubic-bezier(0.25, 0.1, 0.25, 1);
}

/* ─── 分隔线 ─── */

.category-divider {
  height: 1rpx;
  background: rgba(28, 27, 26, 0.05);
  margin: 16rpx 0;
}

/* ─── 二级分类项（去重全局列表 / 展开的子分类 共用） ─── */

.category-section--tier2 {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 12rpx 0;
  padding: 8rpx 0 32rpx;
}

.category-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  padding: 12rpx 8rpx;
}

.category-item.is-selected .category-item__icon {
  background: #07C160;
  color: #ffffff;
}

.category-item.is-selected .category-item__name {
  color: #07C160;
  font-weight: 600;
}

.category-item__icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: rgba(28, 27, 26, 0.04);
  color: rgba(28, 27, 26, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 500;
  transition: background 150ms cubic-bezier(0.25, 0.1, 0.25, 1),
              color 150ms cubic-bezier(0.25, 0.1, 0.25, 1);
}

.category-item__name {
  font-size: 20rpx;
  color: rgba(28, 27, 26, 0.5);
  text-align: center;
  line-height: 1.2;
  transition: color 150ms cubic-bezier(0.25, 0.1, 0.25, 1);
}

/* ─── 底部安全区占位 ─── */

.category-bottom-spacer {
  min-height: 20rpx;
}

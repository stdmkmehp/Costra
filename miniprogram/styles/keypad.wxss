/* styles/keypad.wxss · 计算器键盘公共样式 */
/* COSTRA-227: 抽取自 expense-overlay · 供明细页金额编辑复用 */
/* 包含：金额显示区 / 操作行（账本+备注+费用性质）/ 数字键盘网格 */
/* 修改此文件即可同时影响记账面板和编辑金额面板 */

/* ─── 金额显示区 ─── */

.keypad-sheet__amount {
  display: flex;
  align-items: baseline;
  padding: 24rpx 32rpx 16rpx;
  min-height: 80rpx;
}

.keypad-sheet__prefix {
  font-size: 32rpx;
  color: rgba(28, 27, 26, 0.48);
  margin-right: 8rpx;
  font-weight: 500;
}

.keypad-sheet__value {
  font-size: 56rpx;
  font-weight: 600;
  color: #1c1b1a;
  line-height: 1.2;
  letter-spacing: -1rpx;
  word-break: break-all;
}

.keypad-sheet__value.is-result {
  color: #07C160;
}

/* ─── 操作行容器 ─── */

.keypad-sheet__actions {
  display: flex;
  align-items: center;
  padding: 0 32rpx 16rpx;
  gap: 16rpx;
  min-height: 56rpx;
}

/* ─── 账本切换 ─── */

.keypad-ledger {
  flex-shrink: 0;
}

.keypad-ledger__text {
  font-size: 26rpx;
  color: rgba(28, 27, 26, 0.36);
}

/* ─── 备注输入（placeholder 与 input 叠放，class 控制显隐） ─── */

.keypad-note {
  position: relative;
  flex: 1;
  min-width: 0;
  /* 扩大可点击热区：上下 padding 让整个区域都能触发 onTapNote */
  padding: 12rpx 0;
  min-height: 40rpx;
  display: flex;
  align-items: center;
}

.keypad-note__placeholder {
  font-size: 26rpx;
  color: rgba(28, 27, 26, 0.28);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  transition: opacity 150ms cubic-bezier(0.25, 0.1, 0.25, 1);
}

.keypad-note__placeholder.is-hidden {
  opacity: 0;
  pointer-events: none;
}

.keypad-note__input {
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 100%;
  font-size: 26rpx;
  color: #1c1b1a;
  min-height: 40rpx;
  opacity: 0;
  pointer-events: none;
  transition: opacity 150ms cubic-bezier(0.25, 0.1, 0.25, 1);
}

.keypad-note__input.is-visible {
  opacity: 1;
  pointer-events: auto;
}

/* ─── 费用性质开关（仅家庭账本+支出时可见 · is-visible 控制） ─── */
/*   右对齐：margin-left:auto 推到操作行最右端                    */

.keypad-shared {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-shrink: 0;
  margin-left: auto;
  opacity: 0;
  height: 0;
  overflow: hidden;
  transition: opacity 250ms cubic-bezier(0.25, 0.1, 0.25, 1),
              height 250ms cubic-bezier(0.25, 0.1, 0.25, 1);
}

.keypad-shared.is-visible {
  opacity: 1;
  height: 40rpx;
}

.keypad-shared__text {
  font-size: 26rpx;
  color: rgba(28, 27, 26, 0.36);
  transition: color 150ms cubic-bezier(0.25, 0.1, 0.25, 1);
}

.keypad-shared__text.is-active {
  color: #1c1b1a;
  font-weight: 600;
}

.keypad-shared__sep {
  font-size: 26rpx;
  color: rgba(28, 27, 26, 0.12);
}

/* ─── 数字键盘网格 ─── */

.keypad {
  padding: 0 8rpx 8rpx;
}

/* 备注输入时数字键盘随面板上移落入系统键盘覆盖区，禁用点击避免误触 */
.keypad.is-covered {
  pointer-events: none;
}

.keypad__row {
  display: flex;
  width: 100%;
}

.keypad__picker {
  flex: 1;
  margin: 4rpx;
}

.keypad__picker .keypad__key {
  margin: 0;
}

/*
 * 字号规范（2026-07-16 统一）：
 *   - 主档 36rpx：数字 0-9 / . / 四则运算符 × ÷ + −（纯符号视觉等重）
 *   - 副档 30rpx：文字标签 AC / Paste / 今天/日期 / 完成 / =（多字符或语义标签，比数字略小以保持视觉密度平衡）
 *   - SVG 图标 ⌫：40×28rpx，视觉尺寸对齐副档字符
 * 修改字号时应把新增键归入两档之一，不要再引入第三档。
 */
.keypad__key {
  flex: 1;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 4rpx;
  border-radius: 12rpx;
  background: rgba(28, 27, 26, 0.04);
  font-size: 36rpx;
  color: #1c1b1a;
  font-weight: 500;
  transition: background 150ms cubic-bezier(0.25, 0.1, 0.25, 1);
}

.keypad__key:active {
  background: rgba(28, 27, 26, 0.09);
}

/* 2026-07-16 视觉收敛：功能键背景从 0.08 → 0.05，与数字键 0.04 拉齐差距，
 * 只保留可辨识的分界层次，不再形成割裂感。
 * 字号：功能键中的四则运算符（× ÷ + −）与数字同为主档 36rpx（由基类继承，无需覆盖）。
 * 文字标签类子变体（--paste / --date / --action / --clear）在下方单独设为副档 30rpx。
 * 运算符子变体（--op）在下方单独调轻字重。 */
.keypad__key--fn {
  background: rgba(28, 27, 26, 0.05);
}

/* 运算符 + − × ÷：符号本身笔画对称，500 字重会显得比同字号数字更粗，
 * 单独降到 400 让整体视觉重量与数字齐平（2026-07-16 视觉微调）。 */
.keypad__key--op {
  font-weight: 400;
}

/* 副档 30rpx + 400 字重：日期文字（今天 / M/D） */
.keypad__key--date {
  font-size: 30rpx;
  font-weight: 400;
}

/* 副档 30rpx + 400 字重：AC（All Clear）文字标签 */
.keypad__key--clear {
  font-size: 30rpx;
  font-weight: 400;
}

/* 副档 30rpx + 加粗：完成 / = 主 CTA */
.keypad__key--action {
  font-size: 30rpx;
  font-weight: 600;
}

/* 副档 30rpx + 400 字重：Paste 键（letter-spacing 让 5 字母排布松弛） */
.keypad__key--paste {
  font-size: 30rpx;
  font-weight: 400;
  letter-spacing: 0.5rpx;
}

/* ─── 退格键：SVG 描边图标（封闭五边形 + 内嵌 ×，参考 iOS 系统 delete） ─── */
.keypad__key--backspace {
  /* 父键已 flex-center；.ic-backspace 由 SVG 背景直接绘制，无需额外定位 */
}

/*
 * 采用 base64 编码的内联 SVG 作为 background-image。
 * 原始 SVG:
 *   <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 18" fill="none"
 *        stroke="rgb(28,27,26)" stroke-opacity="0.85"
 *        stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
 *     <path d="M8 1 L22 1 A1.5 1.5 0 0 1 23 2.5 L23 15.5 A1.5 1.5 0 0 1 22 17 L8 17 L1 9 Z"/>
 *     <path d="M12 6 L18 12 M18 6 L12 12"/>
 *   </svg>
 *
 * 走 base64 而非 utf8 data URI：与项目 SVG 约定一致（MEMORY.md 折线图规约），
 * 兼容性最稳；且描边颜色写死在 SVG 里，按键 :active 变色不影响图标本身。
 */
.ic-backspace {
  width: 40rpx;
  height: 28rpx;
  background-image: url("data:image/svg+xml;base64,");
  background-repeat: no-repeat;
  background-size: contain;
  background-position: center;
}

/* 深色模式：SVG stroke 颜色无法响应 CSS 变量，改切换 background-image 到白色描边版本
 * （2026-07-16 review Product P1-4 修复）。设计系统 §7 要求组件不判断主题；此处使用
 * media query 作为图像资源级降级，未引入 JS 判断，与设计系统约束兼容。 */
@media (prefers-color-scheme: dark) {
  .ic-backspace {
    background-image: url("data:image/svg+xml;base64,");
  }
}

.keypad__key--done {
  background: #07C160;
  color: #ffffff;
}

.keypad__key--done:active {
  background: #06ad56;
}

.keypad__key--equals {
  background: rgba(28, 27, 26, 0.12);
  color: #1c1b1a;
  font-size: 40rpx;
  font-weight: 700;
}

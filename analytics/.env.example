# ─── Costra Analyze · 环境变量示例 ──────────────────────────────────────────
# 使用方法：
#   cp .env.example .env
#   vim .env          # 填入真实值
#   chmod 600 .env    # 保护密钥
#
# .env 已在 .gitignore 中排除，禁止提交到仓库
# ─────────────────────────────────────────────────────────────────────────────

# ─── 路径 ─────────────────────────────────────────────────────────────────────
# 项目根目录由脚本自身位置推导；整体移动后无需修改路径配置。

# DUMP_INBOX: prod scp 落点（独立目录，不与 prod 共享）
DUMP_INBOX=/data/slave/backups

# REPORTS_DIR: 报告输出目录（daily/weekly/range 子目录自动创建）
REPORTS_DIR=/data/analyze/report

# LOG_DIR: 独立日志目录
LOG_DIR=/data/logs/analyze

# ─── 容器 ─────────────────────────────────────────────────────────────────────
# PG 容器（与 prod 的 costra-postgres 完全不同）
PG_CONTAINER=costra-analyze-pg
PG_DB=analyze
PG_USER=analyze
# 生成随机密码示例: openssl rand -base64 24
PG_PASSWORD=CHANGE_ME_random_32chars

# Node 容器（用于渲染和邮件）
NODE_CONTAINER=costra-analyze-node

# ─── SMTP (QQ 邮箱) ───────────────────────────────────────────────────────────
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=YOURQQ@qq.com
SMTP_PASS=CHANGE_ME_16char_authcode
MAIL_FROM=YOURQQ@qq.com

# MAIL_TO: 收件人（PLACEHOLDER = stdout 模式不发邮件）
MAIL_TO=PLACEHOLDER@example.com

# MAIL_CC: 抄送（可空）
MAIL_CC=

# ─── 阈值覆盖（可选，留空则使用 config.mjs 默认值）─────────────────────────
# 默认值：users=5, ledgers=5, entries=20, invites=5, active=8
THRESHOLD_USERS=
THRESHOLD_LEDGERS=
THRESHOLD_ENTRIES=
THRESHOLD_ACTIVE=
THRESHOLD_INVITES=

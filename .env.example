# =============================================================================
# Costra · 环境变量示例
# 用法：
#   cp .env.example .env
#   根据本地/部署环境填写真实值。任何包含密钥/凭据的字段，严禁提交 .env 到 Git。
# =============================================================================

# ---- 应用 ----
NODE_ENV=development
APP_PORT=3000
APP_BASE_URL=http://localhost:3000

# ---- Postgres (server/docker-compose.yml 默认值) ----
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=costra
POSTGRES_USER=costra
POSTGRES_PASSWORD=costra_dev_pw

# ---- Redis ----
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# ---- 对象存储（MinIO / 腾讯云 COS；二选一） ----
OSS_ENDPOINT=http://127.0.0.1:9000
OSS_REGION=us-east-1
OSS_BUCKET=costra-dev
OSS_ACCESS_KEY=
OSS_SECRET_KEY=

# ---- 微信小程序 ----
WX_APPID=wxf8b0d3e3a83f9941
WX_APP_SECRET=
# 订阅消息模板（见 ADR-0004 §5）
WX_SUBSCRIBE_TMPL_BUDGET_WARN=
WX_SUBSCRIBE_TMPL_FAMILY_INVITE=
WX_SUBSCRIBE_TMPL_WEEKLY_DIGEST=

# ---- 会话与签名 ----
SESSION_SECRET=change-me-32bytes-random
JWT_ISSUER=costra
JWT_EXPIRES_IN=7d

# ---- CI/CD · miniprogram-ci（DevOps 占位，真实值见密钥管理） ----
# 以下键名与 .github/workflows/mp-*.yml + scripts/mp-ci/*.mjs 保持一致
# 真正的 robot key 不入库；本地放 ~/.costra/mp-ci/ 外部目录，CI 通过 GitHub Secrets 注入
MP_APPID=wxf8b0d3e3a83f9941
MP_APPID_STAGING=
MP_CI_KEY_PATH=~/.costra/mp-ci/private.wxf8b0d3e3a83f9941.key
# 以下两项仅用于 GitHub Secrets（本地 .env 不需要填）：
# MP_CI_KEY_PROD=
# MP_CI_KEY_STAGING=
MP_PROJECT_PATH=.
MP_ENV=staging

# （兼容旧文档）原键名保留，后续清理
MP_CI_ROBOT_ID=1
MP_CI_PRIVATE_KEY_PATH=./.secrets/mp-private.key

# ---- 可观测 ----
LOG_LEVEL=info
TRACE_SAMPLE_RATE=0.1

# ---- Feature Flags（运行时覆盖见 feature_flags 表） ----
FLAG_FAMILY_SHARING=true
FLAG_SUBSCRIBE_MSG=true

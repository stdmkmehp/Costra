{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "node",
    "lib": ["ES2020"],
    "strict": true,
    "noImplicitAny": true,
    "noUnusedLocals": false,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "outDir": "./dist",
    "baseUrl": ".",
    "paths": {
      "@services/*": ["miniprogram/services/*"],
      "@utils/*": ["miniprogram/utils/*"],
      "@tokens/*": ["miniprogram/tokens/*"]
    },
    "types": ["miniprogram-api-typings", "vitest/globals"]
  },
  "include": ["miniprogram/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
